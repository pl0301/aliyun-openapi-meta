{
  "camel_example": "",
  "cmd_full_name": "eiam-developerapi generate-jwt-authentication-token",
  "cmd_name": "generate-jwt-authentication-token",
  "deprecated": false,
  "description_en": "Generates a JSON Web Token (JWT) authentication token",
  "description_zh": "生成一个JWT认证令牌",
  "kebab_example": "aliyun eiam-developerapi generate-jwt-authentication-token --authorization Bearer_xxxxxx --instance-id idaas_ue2jvisn35ea5lmthk267xxxxx --credential-provider-identifier test_example_identifier --issuer https://test.issuer.com --subject test_jwt_subject --audiences test_jwt_audience --custom-claims key=example-string --expiration 900 --include-derived-short-token true --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "GenerateJwtAuthenticationToken",
  "operation": {
    "action": "GenerateJwtAuthenticationToken",
    "api_style": "ROA",
    "api_version": "2022-02-25",
    "body_mapping": {
      "audiences": "audiences",
      "credential_provider_identifier": "credentialProviderIdentifier",
      "custom_claims": "customClaims",
      "expiration": "expiration",
      "include_derived_short_token": "includeDerivedShortToken",
      "issuer": "issuer",
      "subject": "subject"
    },
    "content_type": "application/json",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "req_body_type": "json",
    "system_operation_type": "none",
    "url": "/v2/{instanceId}/authenticationTokens/_/actions/generateJwt"
  },
  "parameters": [
    {
      "example": "Bearer xxxxxx",
      "help_en": "Authentication information. Format: Bearer ${access_token}.\n\nEnter the Access Token issued by IDaaS",
      "help_zh": "认证信息。 格式为：Bearer ${access_token}。\n\n请输入 IDaaS 签发的 Access Token",
      "location": "header",
      "name": "authorization",
      "options": [
        "--authorization"
      ],
      "raw_name": "Authorization",
      "required": true,
      "type": "string"
    },
    {
      "example": "idaas_ue2jvisn35ea5lmthk267xxxxx",
      "help_en": "Instance ID",
      "help_zh": "实例ID",
      "location": "path",
      "max_length": "64",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "instanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "test_example_identifier",
      "help_en": "Credential provider identity",
      "help_zh": "凭据提供商标识",
      "location": "body",
      "name": "credential_provider_identifier",
      "options": [
        "--credential-provider-identifier"
      ],
      "param_style": "json",
      "raw_name": "credentialProviderIdentifier",
      "required": true,
      "type": "string"
    },
    {
      "example": "https://test.issuer.com",
      "help_en": "The \\`iss\\` field of the JWT",
      "help_zh": "对应JWT的iss字段",
      "location": "body",
      "name": "issuer",
      "options": [
        "--issuer"
      ],
      "param_style": "json",
      "raw_name": "issuer",
      "required": false,
      "type": "string"
    },
    {
      "example": "test_jwt_subject",
      "help_en": "The \\`sub\\` field of the JWT",
      "help_zh": "对应JWT的sub字段",
      "location": "body",
      "name": "subject",
      "options": [
        "--subject"
      ],
      "param_style": "json",
      "raw_name": "subject",
      "required": true,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The \\`aud\\` field of the JWT",
      "help_zh": "对应JWT的aud字段",
      "location": "body",
      "name": "audiences",
      "options": [
        "--audiences"
      ],
      "param_style": "json",
      "raw_name": "audiences",
      "required": true,
      "type": "array"
    },
    {
      "help_en": "Custom claims.\n\n<notice>\n\nKey-value pairs. Keys must be strings.\n\n</notice>",
      "help_zh": "自定义Claims。\n\n<notice>键值对形式，其中键必须为字符串类型。></notice>",
      "location": "body",
      "name": "custom_claims",
      "options": [
        "--custom-claims"
      ],
      "param_style": "json",
      "raw_name": "customClaims",
      "required": false,
      "type": "map",
      "value": {
        "type": "any"
      }
    },
    {
      "example": "900",
      "help_en": "The validity period of the JWT, in seconds",
      "help_zh": "JWT的有效时长，单位秒",
      "location": "body",
      "minimum": "0",
      "name": "expiration",
      "options": [
        "--expiration"
      ],
      "param_style": "json",
      "raw_name": "expiration",
      "required": false,
      "type": "int"
    },
    {
      "example": "true",
      "help_en": "Whether the generated JWT needs to include a \"derived short token\"",
      "help_zh": "生成JWT是否需要包含“派生短令牌”",
      "location": "body",
      "name": "include_derived_short_token",
      "options": [
        "--include-derived-short-token"
      ],
      "param_style": "json",
      "raw_name": "includeDerivedShortToken",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "/v2/[instanceId]/authenticationTokens/_/actions/generateJwt",
  "product_code": "Eiam-developerapi",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "JWT authentication token details",
        "description_zh": "JWT认证令牌详情",
        "properties": {
          "authenticationTokenId": {
            "description_en": "Authentication token ID",
            "description_zh": "认证令牌 ID",
            "example": "atntkn_01kqflm0sxxx8nmdc1cb5dskxxxxx",
            "title_en": "",
            "title_zh": "认证令牌ID。",
            "type": "string"
          },
          "authenticationTokenType": {
            "description_en": "Authentication token type.\n\nThe value is fixed as `jwt`, indicating a JWT authentication token",
            "description_zh": "认证令牌类型。\n\n取值固定为`jwt`，表示JWT类型的认证令牌",
            "example": "jwt",
            "title_en": "",
            "title_zh": "认证令牌的类型。",
            "type": "string"
          },
          "consumerId": {
            "description_en": "Authentication token consumer ID",
            "description_zh": "认证令牌使用者ID",
            "example": "test_jwt_subject",
            "title_en": "",
            "title_zh": "认证令牌的使用者ID。",
            "type": "string"
          },
          "consumerType": {
            "description_en": "Authentication token consumer type. Valid values:\n\napplication: Application\n\ncustom: Custom type",
            "description_zh": "认证令牌使用者类型。取值可选范围：\n\napplication：应用\ncustom：自定义类型",
            "example": "custom",
            "title_en": "",
            "title_zh": "认证令牌的使用者类型。",
            "type": "string"
          },
          "createTime": {
            "description_en": "The creation time of the authentication token, UNIX timestamp, in milliseconds",
            "description_zh": "认证令牌的创建时间，Unix时间戳，单位毫秒",
            "example": "1649830225000",
            "format": "int64",
            "title_en": "",
            "title_zh": "认证令牌的创建时间，Unix时间戳。",
            "type": "integer"
          },
          "creatorId": {
            "description_en": "Authentication token creator ID",
            "description_zh": "认证令牌创建者 ID",
            "example": "app_ngtkgrrxxxxktg5eao6z4xxxxx",
            "title_en": "",
            "title_zh": "认证令牌的创建者ID。",
            "type": "string"
          },
          "creatorType": {
            "description_en": "Authentication token creator type. Valid values:\n\napplication: Application",
            "description_zh": "认证令牌创建者类型。取值可选范围：\n\napplication：应用",
            "example": "application",
            "title_en": "",
            "title_zh": "认证令牌的创建者类型。",
            "type": "string"
          },
          "credentialProviderId": {
            "description_en": "Credential provider ID",
            "description_zh": "凭据提供商 ID",
            "example": "atp_01kr2cmj5gxxx4fvmls2e93dxxxxx",
            "title_en": "",
            "title_zh": "凭据提供商的ID。",
            "type": "string"
          },
          "expirationTime": {
            "description_en": "Authentication token expiration time, UNIX timestamp, in milliseconds",
            "description_zh": "认证令牌过期时间，Unix时间戳，单位毫秒",
            "example": "1772693568000",
            "format": "int64",
            "title_en": "",
            "title_zh": "认证令牌的过期时间，Unix时间戳，单位秒。",
            "type": "integer"
          },
          "instanceId": {
            "description_en": "Instance ID",
            "description_zh": "实例 ID",
            "example": "idaas_ue2jvisn35ea5lmthk267xxxxx",
            "title_en": "",
            "title_zh": "EIAM实例ID。",
            "type": "string"
          },
          "jwtContent": {
            "description_en": "JWT authentication token content",
            "description_zh": "JWT类型认证令牌内容",
            "properties": {
              "derivedShortToken": {
                "description_en": "The derived short token of the JWT",
                "description_zh": "JWT的派生短令牌",
                "example": "sk-Nx2vzxxxxxxxxxxxxxxxxx",
                "title_en": "",
                "title_zh": "JWT的派生短令牌。",
                "type": "string"
              },
              "jwtValue": {
                "description_en": "JWT content",
                "description_zh": "JWT内容",
                "example": "eyJhbGciOixxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
                "title_en": "",
                "title_zh": "JWT内容。",
                "type": "string"
              }
            },
            "title_en": "",
            "title_zh": "JWT类型的认证令牌的内容。",
            "type": "object"
          },
          "revoked": {
            "description_en": "Whether the authentication token is revoked",
            "description_zh": "认证令牌是否被吊销",
            "example": "false",
            "title_en": "",
            "title_zh": "认证令牌是否被吊销。",
            "type": "boolean"
          },
          "updateTime": {
            "description_en": "The update time of the authentication token, UNIX timestamp, in milliseconds",
            "description_zh": "认证令牌的更新时间，Unix时间戳，单位毫秒",
            "example": "1649830225000",
            "format": "int64",
            "title_en": "",
            "title_zh": "认证令牌的更新时间，Unix时间戳。",
            "type": "integer"
          }
        },
        "title_en": "",
        "title_zh": "",
        "type": "object"
      }
    }
  },
  "v1_body_parameters": [
    {
      "help_en": "Request body",
      "help_zh": "请求 Body",
      "name": "body",
      "param_style": "json",
      "position": "body",
      "required": false,
      "type": "string"
    }
  ]
}
