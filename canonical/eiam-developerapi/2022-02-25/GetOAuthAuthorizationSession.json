            "example": "pending",
            "title_en": "",
            "title_zh": "会话状态。",
            "type": "string"
          },
          "sessionUri": {
            "description_en": "The authorization session URI",
            "description_zh": "授权会话URI",
            "example": "urn:ietf:params:oauth:request_uri:atpoas_01l6ljnvrpc5niakl3gj3amxxxxxx",
            "title_en": "",
            "title_zh": "授权会话URI，格式：urn:ietf:params:oauth:request_uri:{sessionId}。",
