            "title_zh": "使用者类型。",
            "type": "string"
          },
          "creatorId": {
            "description_en": "The authentication token creator ID",
            "description_zh": "认证令牌创建者 ID",
            "example": "app_ngtkgrrxxxxktg5eao6z4xxxxx",
