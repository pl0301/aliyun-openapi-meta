      "name": "authorization",
      "options": [
        "--authorization"
      ],
      "raw_name": "Authorization",
      "required": true,
      "type": "string"
    },
    {
      "example": "idaas_ue2jvisn35ea5lmthk267xxxxx",
      "help_en": "The instance ID",
      "help_zh": "实例 ID",
      "location": "path",
      "max_length": "64",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "instanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "urn:ietf:params:oauth:request_uri:atpoas_01l6ljnvrpc5niakl3gj3amxxxxxx",
      "help_en": "The authorization session URI.\n\nReturned by the FetchOAuthAuthenticationToken call",
      "help_zh": "授权会话URI。\n\n由FetchOAuthAuthenticationToken调用返回",
      "location": "body",
      "name": "session_uri",
      "options": [
        "--session-uri"
      ],
      "param_style": "json",
      "raw_name": "sessionUri",
      "required": true,
      "type": "string"
    }
