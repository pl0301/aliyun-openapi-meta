            "example": "1704153600000",
            "format": "int64",
            "title_en": "",
            "title_zh": "会话过期时间，Unix时间戳（毫秒）。",
            "type": "integer"
          },
          "instanceId": {
            "description_en": "The instance ID",
            "description_zh": "实例 ID",
            "example": "idaas_ue2jvisn35ea5lmthk267xxxxx",
            "title_en": "",
            "title_zh": "IDaaS实例ID。",
            "type": "string"
          },
          "sessionId": {
            "description_en": "The authorization session ID",
            "description_zh": "授权会话ID",
            "example": "atpoas_01l6losojlojbbv01adsq56xxxxx",
            "title_en": "",
            "title_zh": "授权会话ID。",
            "type": "string"
          },
          "sessionStatus": {
            "description_en": "The authorization session status",
            "description_zh": "授权会话状态",
            "enumValueTitles": {
              "callback_received": "callback_received",
              "completed": "completed",
              "expired": "expired",
              "failed": "failed",
              "pending": "pending"
