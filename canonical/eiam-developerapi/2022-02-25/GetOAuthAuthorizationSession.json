  "cmd_full_name": "eiam-developerapi get-oauth-authorization-session",
  "cmd_name": "get-oauth-authorization-session",
  "deprecated": false,
  "description_en": "Queries the current status and authorization result of an OAuth authorization session",
  "description_zh": "查询OAuth授权会话的当前状态及授权结果",
  "kebab_example": "",
  "method": "POST",
  "multi_version": false,
  "name": "GetOAuthAuthorizationSession",
  "operation": {
    "action": "GetOAuthAuthorizationSession",
    "api_style": "ROA",
    "api_version": "2022-02-25",
