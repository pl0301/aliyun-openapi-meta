  "multi_version": true,
  "name": "ListDataSource",
  "operation": {
    "action": "ListDataSource",
    "api_style": "ROA",
    "api_version": "2020-11-26",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/v2/openapi/instances/{instanceId}/dataSources"
  },
  "parameters": [
