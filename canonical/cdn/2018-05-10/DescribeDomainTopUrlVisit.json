{
  "camel_example": "aliyun cdn DescribeDomainTopUrlVisit --region cn-hangzhou --EndTime '2019-10-04T16:00:00Z' --DomainName 'example.com' --SortBy pv --StartTime '2019-10-04T00:00:00Z'",
