  "camel_example": "aliyun cdn DescribeDomainSrcTopUrlVisit --region cn-hangzhou --EndTime '2018-10-03T20:00:00Z' --DomainName 'example.com' --SortBy pv --StartTime '2018-10-03T16:00:00Z'",
