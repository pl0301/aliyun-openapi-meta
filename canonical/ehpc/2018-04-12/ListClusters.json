{
  "camel_example": "aliyun ehpc ListClusters --region cn-hangzhou --PageSize 10 --PageNumber 1",
  "cmd_full_name": "ehpc list-clusters",
  "cmd_name": "list-clusters",
  "deprecated": false,
  "description_en": "Queries all Elastic High Performance Computing (E-HPC) clusters of the current account in each region",
  "description_zh": "查询用户账号中在每个地域拥有的所有集群的列表",
  "kebab_example": "aliyun ehpc list-clusters --page-number 1 --page-size 10 --api-version 2018-04-12 --region cn-hangzhou",
  "method": "GET",
  "multi_version": true,
  "name": "ListClusters",
  "operation": {
    "action": "ListClusters",
    "api_style": "RPC",
    "api_version": "2018-04-12",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "example": "1",
      "help_en": "The number of the page to return. Pages start from page 1",
      "help_zh": "显示的页码，起始值为1",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The number of entries to return on each page. Valid values: 1 to 50.\n\nDefault value: 10",
      "help_zh": "每页显示的条数。取值范围：1~50\n\n默认值：10",
      "location": "query",
      "maximum": "50",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "EHPC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Clusters": {
            "itemNode": true,
            "properties": {
              "ClusterInfoSimple": {
                "description_en": "The list of clusters",
                "description_zh": "集群详细信息",
                "items": {
                  "properties": {
                    "AccountType": {
                      "description_en": "The server type of the account. Valid values:\n\nnis\nldap",
                      "description_zh": "账户服务器类型。可能值：\nnis\nldap",
                      "example": "nis",
                      "type": "string"
                    },
                    "BaseOsTag": {
                      "description_en": "The operating system tag of the base image. The tag was used only by the management node",
                      "description_zh": "基础镜像操作系统标签，仅管控节点使用",
                      "example": "CentOS_7.2_64",
                      "type": "string"
                    },
                    "ClientVersion": {
                      "description_en": "The version of the client",
                      "description_zh": "集群客户端版本",
                      "example": "1.0.64",
                      "type": "string"
                    },
                    "ComputeSpotPriceLimit": {
                      "description_en": "The maximum hourly price for the ECS instance under the compute node. The return value can be accurate to three decimal places",
                      "description_zh": "计算节点下ECS实例的每小时最高价格。返回值最多保留小数点后3位",
                      "example": "0.034",
                      "format": "float",
                      "type": "number"
                    },
                    "ComputeSpotStrategy": {
                      "description_en": "The bidding method of the compute nodes. Valid values:\n\nNoSpot: The instances of the compute node are pay-as-you-go instances.\nSpotWithPriceLimit: The instances of the compute node are preemptible instances. These types of instances have a specified maximum hourly price.\nSpotAsPriceGo: The instances of the compute node are preemptible instances. The price of these instances is based on the current market price",
                      "description_zh": "计算节点竞价策略。可能值：\nNoSpot：正常按量付费实例。\nSpotWithPriceLimit：设置上限价格的抢占式实例。\nSpotAsPriceGo：系统自动出价，跟随当前市场实际价格",
                      "example": "NoSpot",
                      "type": "string"
                    },
                    "Computes": {
                      "description_en": "The information about compute nodes",
                      "description_zh": "计算节点信息",
                      "properties": {
                        "ExceptionCount": {
                          "description_en": "The number of abnormal nodes",
                          "description_zh": "异常节点数",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "NormalCount": {
                          "description_en": "The number of normal nodes",
                          "description_zh": "正常节点数",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "OperatingCount": {
                          "description_en": "The number of nodes that are being used in the queue. This includes those that are being initialized, installed, or released",
                          "description_zh": "操作进行中的节点数量，包括初始化、安装中、释放中等状态的节点",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "StoppedCount": {
                          "description_en": "The number of stopped nodes",
                          "description_zh": "停止节点数",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Total": {
                          "description_en": "The total number of nodes",
                          "description_zh": "总节点数",
                          "example": "2",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "Count": {
                      "description_en": "The number of compute nodes in the cluster",
                      "description_zh": "集群计算节点数目",
                      "example": "3",
                      "format": "int32",
                      "type": "integer"
                    },
                    "CreateTime": {
                      "description_en": "The time when the instance was created",
                      "description_zh": "集群创建时间",
                      "example": "2020-10-30T07:39:20.000Z",
                      "type": "string"
                    },
                    "DeployMode": {
                      "description_en": "The mode in which the cluster was deployed. Valid values:\n\nStandard: An account node, a scheduling node, a logon node, and multiple compute nodes are separately deployed.\nAdvanced: Two high availability (HA) account nodes, two HA scheduler nodes, one logon node, and multiple compute nodes are separately deployed.\nSimple: A management node, a logon node, and multiple compute nodes are deployed. The management node consists of an account node and a scheduling node. The logon node and compute nodes are separately deployed.\nTiny: A management node and multiple compute nodes are deployed. The management node consists of an account node, a scheduling node, and a logon node. The compute nodes are separately deployed",
                      "description_zh": "集群部署模式。可能值：\nStandard：账号节点、调度节点、登录节点、计算节点分离部署。\nAdvanced：HA模式部署。\nSimple：账号节点和调度节点混合部署在一个节点上，登录节点和计算节点分离部署。\nTiny：账号节点、调度节点、登录节点混合部署在一个节点上，计算节点分离部署",
                      "example": "Standard",
                      "type": "string"
                    },
                    "Description": {
                      "description_en": "The description of the cluster",
                      "description_zh": "集群描述",
                      "example": "clusterdescription",
                      "type": "string"
                    },
                    "EhpcVersion": {
                      "description_en": "The version of E-HPC",
                      "description_zh": "EHPC版本",
                      "example": "1.0.0",
                      "type": "string"
                    },
                    "HasPlugin": {
                      "description_en": "Indicates whether plug-ins were used in the cluster. Valid values:\n\ntrue: Plug-ins are used.\nfalse: Plug-ins are not used.\n\nDefault value: false",
                      "description_zh": "集群是否使用了插件。取值范围：\n\ntrue：是\n\nfalse：否\n\n默认值：false",
                      "example": "false",
                      "type": "boolean"
                    },
                    "Id": {
                      "description_en": "The ID of the cluster",
                      "description_zh": "集群ID",
                      "example": "ehpc-hz-jeJki6****",
                      "type": "string"
                    },
                    "ImageId": {
                      "description_en": "The ID of the image",
                      "description_zh": "镜像ID",
                      "example": "wi_1607_x64_dtc_zh_40G_alibase****",
                      "type": "string"
                    },
                    "ImageOwnerAlias": {
                      "description_en": "The type of the image. Valid values:\n\nsystem: public image\nself: custom image\nothers: shared image\nmarketplace: Alibaba Cloud Marketplace image",
                      "description_zh": "镜像类型。可能值：\nsystem：公共镜像\nself：自定义镜像\nothers：共享镜像\nmarketplace：镜像市场镜像",
                      "example": "system",
                      "type": "string"
                    },
                    "InstanceChargeType": {
                      "description_en": "The billing method of the nodes in the cluster. Valid values:\n\nPostPaid: pay-as-you-go\nPrePaid: subscription",
                      "description_zh": "集群实例付费类型。可能值：\n\nPostPaid：按量付费\nPrePaid：包年包月",
                      "example": "PostPaid",
                      "type": "string"
                    },
                    "InstanceType": {
                      "description_en": "The instance type of the compute nodes",
                      "description_zh": "计算节点实例规格",
                      "example": "ecs.n1.tiny",
                      "type": "string"
                    },
                    "IsComputeEss": {
                      "description_en": "Indicates whether a scaling group was enabled. Valid values:\n\ntrue: A scaling group is enabled.\nfalse: No scaling group is enabled",
                      "description_zh": "是否启用弹性伸缩组。可能值：\ntrue：启用\nfalse：未启用",
                      "example": "false",
                      "type": "boolean"
                    },
                    "Location": {
                      "description_en": "The location where the cluster was deployed. Valid values:\n\nOnPremise: The cluster is deployed on a hybrid cloud.\nPublicCloud: The cluster is deployed on a public cloud",
                      "description_zh": "集群所在位置。可能值：\nOnPremise：混合云集群。\nPublicCloud：公有云集群",
                      "example": "PublicCloud",
                      "type": "string"
                    },
                    "LoginNodes": {
                      "description_en": "The list of logon nodes",
                      "description_zh": "登录节点列表",
                      "example": "{\"Id\": \"i-bp13x4is8pvdhws7e****\"}",
                      "type": "string"
                    },
                    "Managers": {
                      "description_en": "The list of management nodes",
                      "description_zh": "管理节点信息",
                      "properties": {
                        "ExceptionCount": {
                          "description_en": "The number of abnormal nodes",
                          "description_zh": "异常节点数",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "NormalCount": {
                          "description_en": "The number of normal nodes",
                          "description_zh": "正常节点数",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "OperatingCount": {
                          "description_en": "The number of nodes that are being used in the queue. This includes those that are being initialized, installed, or released",
                          "description_zh": "操作进行中的节点数量，包括初始化、安装中、释放中等状态的节点",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "StoppedCount": {
                          "description_en": "The number of stopped nodes",
                          "description_zh": "停止节点数",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Total": {
                          "description_en": "The total number of management nodes",
                          "description_zh": "总管理节点数目",
                          "example": "2",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "Name": {
                      "description_en": "The name of the cluster",
                      "description_zh": "集群名称",
                      "example": "test",
                      "type": "string"
                    },
                    "NodePrefix": {
                      "description_en": "The prefix of the node",
                      "description_zh": "主机前缀名",
                      "example": "test",
                      "type": "string"
                    },
                    "NodeSuffix": {
                      "description_en": "The suffix of the node",
                      "description_zh": "主机后缀名",
                      "example": "name",
                      "type": "string"
                    },
                    "OsTag": {
                      "description_en": "The operating system tag of the image",
                      "description_zh": "操作系统镜像标签",
                      "example": "CentOS_7.2_64",
                      "type": "string"
                    },
                    "RegionId": {
                      "description_en": "The ID of the region",
                      "description_zh": "地域ID",
                      "example": "cn-hangzhou",
                      "type": "string"
                    },
                    "ResourceGroupId": {
                      "description_en": "The resource group ID.You can call the ListResourceGroups operation to query the IDs of resource groups",
                      "description_zh": "资源组ID。您可以调用ListResourceGroups查询资源组ID",
                      "example": "rg-acfmxazb4ph****",
                      "type": "string"
                    },
                    "SchedulerType": {
                      "description_en": "The type of the scheduler. Valid values:\n\npbs\nslurm\nopengridscheduler\ndeadline",
                      "description_zh": "调度服务器类型。可能值：\npbs\nslurm\nopengridscheduler\ndeadline",
                      "example": "pbs",
                      "type": "string"
                    },
                    "Status": {
                      "description_en": "The status of the cluster. Valid values:\n\nuninit: The cluster is not initialized.\ncreating: The cluster is being created.\ninit: The cluster is being initialized.\nrunning: The cluster is running.\nexception: The cluster encounters an exception.\nreleasing: The cluster is being released",
                      "description_zh": "集群状态。可能值：\nuninit：未初始化\ncreating：创建中\ninit：初始化中\nrunning：运行中\nexception：异常\nreleasing：释放中",
                      "example": "running",
                      "type": "string"
                    },
                    "TotalResources": {
                      "description_en": "The statistics of all resources in the cluster",
                      "description_zh": "集群资源总量",
                      "properties": {
                        "Cpu": {
                          "description_en": "The number of CPU cores. Unit: cores",
                          "description_zh": "CPU资源。单位：核",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Gpu": {
                          "description_en": "The number of GPU cards. Unit: cards",
                          "description_zh": "GPU资源。单位：卡",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Memory": {
                          "description_en": "The memory size. Unit: MiB",
                          "description_zh": "内存大小。单位为MiB",
                          "example": "1024",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "UsedResources": {
                      "description_en": "The number of consumed resources in the cluster",
                      "description_zh": "集群资源使用量",
                      "properties": {
                        "Cpu": {
                          "description_en": "The number of CPU cores. Unit: cores",
                          "description_zh": "CPU资源。单位：核",
                          "example": "1",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Gpu": {
                          "description_en": "The number of GPU cards. Unit: cards",
                          "description_zh": "GPU资源。单位：卡",
                          "example": "0",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Memory": {
                          "description_en": "The memory size. Unit: MiB",
                          "description_zh": "内存大小。单位为MiB",
                          "example": "1024",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "VSwitchId": {
                      "description_en": "The ID of the vSwitch",
                      "description_zh": "交换机ID",
                      "example": "vsw-bp1lfcjbfb099rrjn****",
                      "type": "string"
                    },
                    "VpcId": {
                      "description_en": "The ID of the virtual private cloud (VPC)",
                      "description_zh": "VPC ID",
                      "example": "vpc-b3f3edefefeep0760yju****",
                      "type": "string"
                    },
                    "ZoneId": {
                      "description_en": "The ID of the zone",
                      "description_zh": "可用区ID",
                      "example": "cn-hangzhou-c",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "PageNumber": {
            "description_en": "The number of the returned page",
            "description_zh": "当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
            "description_en": "The number of entries returned per page",
            "description_zh": "本页条数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "04F0F334-1335-436C-A1D7-6C044FE73368",
            "type": "string"
          },
          "TotalCount": {
            "description_en": "The total number of returned entries",
            "description_zh": "列表条目总数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
