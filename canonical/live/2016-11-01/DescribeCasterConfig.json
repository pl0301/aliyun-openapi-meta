            "example": "{\"eofThres\":3}",
            "type": "string"
          },
          "AutoSwitchUrgentOn": {
            "description_en": "Indicates whether automatic switchover to the standby video upon stream interruption is enabled.\ntrue: Enabled.\nfalse: Shutdown",
            "description_zh": "开启断流自动切换备播。\ntrue：开启。\nfalse：关闭",
            "example": "true",
            "type": "string"
          },
          "CallbackUrl": {
            "description_en": "The user callback URL",
