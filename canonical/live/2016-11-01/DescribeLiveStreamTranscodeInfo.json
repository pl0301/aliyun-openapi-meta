  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The transcoding configurations",
        "description_zh": "转码配置信息",
        "properties": {
          "DomainTranscodeList": {
            "description_en": "",
            "description_zh": "",
            "itemNode": true,
            "properties": {
              "DomainTranscodeInfo": {
                "description_en": "The transcoding configurations",
                "description_zh": "转码配置信息",
                "items": {
                  "description_en": "The transcoding configurations",
                  "description_zh": "转码配置信息",
                  "properties": {
                    "CustomTranscodeParameters": {
                      "description_en": "The custom transcoding configurations",
                      "description_zh": "自定义转码配置",
                      "properties": {
                        "AudioBitrate": {
                          "description_en": "The audio bitrate. Unit: kbps. Valid values: 1 to 1000",
                          "description_zh": "转码音频比特率。单位：kbps，取值范围：1~1000",
                          "example": "64",
                          "format": "int32",
                          "type": "integer"
                        },
                        "AudioChannelNum": {
                          "description_en": "The number of audio channels. Valid values:\n\n1: mono.\n\n2: stereo",
                          "description_zh": "音频声道数。取值：\n\n1：单声道。\n2：双声道",
                          "example": "2",
                          "format": "int32",
                          "type": "integer"
                        },
                        "AudioCodec": {
                          "description_en": "The audio codec",
                          "description_zh": "音频编码格式",
                          "example": "ACC",
                          "type": "string"
                        },
                        "AudioProfile": {
                          "description_en": "The audio codec profile. Valid values:\n\naac_low\n\naac_he\n\naac_he_v2\n\naac_ld",
                          "description_zh": "音频编码等级。取值：\naac_low\naac_he\naac_he_v2\naac_ld",
                          "example": "aac_low",
                          "type": "string"
                        },
                        "AudioRate": {
                          "description_en": "The audio sample rate. Valid values: 22050 to 96000.\n\nIf AudioProfile is set to aac_ld, the sample rate cannot exceed 44100",
                          "description_zh": "音频采样率。取值：22050~96000。\n\n如果AudioProfile取值为aac_ld，则采样率不能超过44100",
                          "example": "44100",
                          "format": "int32",
                          "type": "integer"
                        },
                        "Bframes": {
                          "description_en": "Controls whether to remove B-frames from the transcoded output video. The value is fixed to 0",
                          "description_zh": "去B帧。固定取值：0",
                          "example": "0",
                          "type": "string"
                        },
                        "BitrateWithSource": {
                          "description_en": "The configuration for adaptive bitrate",
                          "description_zh": "码率随源配置",
                          "example": "{\\\"UpLimit\\\":2500,\\\"LowerLimit\\\":800,\\\"Factor\\\":1}",
                          "type": "object"
                        },
                        "DeInterlaced": {
                          "description_en": "Indicates whether to automatically detect and remove interlacing during transcoding. This converts interlaced content to progressive content.\n\ntrue: Deinterlacing is enabled.\n\nfalse: The source format is retained. No processing is performed. This is the default value",
                          "description_zh": "转码过程中是否自动检测并去除隔行处理（将隔行扫描内容转换为逐行扫描）：\n\ntrue：开启去隔行处理。\n\nfalse：保持源格式，不做处理（默认）",
                          "type": "boolean"
                        },
                        "ExtWithSource": {
                          "description_en": "Other adaptive settings that align the transcoded stream with the source stream",
                          "description_zh": "其他随源配置",
                          "example": "{\\\"KeyFrameOpen\\\":\\\"yes\\\",\\\"Copyts\\\":\\\"yes\\\",\\\"SeiMode\\\":1}",
                          "type": "object"
                        },
                        "FPS": {
                          "description_en": "The output video frame rate. Unit: frames per second (FPS)",
                          "description_zh": "转码视频帧率。单位：FPS",
                          "example": "15",
                          "format": "int32",
                          "type": "integer"
                        },
                        "FpsWithSource": {
                          "description_en": "Adapts the output frame rate based on the source's frame rate, while keeping it within a specified range",
                          "description_zh": "帧率随源配置",
                          "example": "{\\\"UpLimit\\\":60,\\\"LowerLimit\\\":1}",
                          "type": "object"
                        },
                        "Gop": {
                          "description_en": "The Group of Pictures (GOP) size. Unit: frames. Valid values: 1 to 3000",
                          "description_zh": "视频GOP（Group of Picture）。单位：帧，取值范围：1~3000",
                          "example": "10",
                          "type": "string"
                        },
                        "Height": {
                          "description_en": "The output video height",
                          "description_zh": "转码视频高度",
                          "example": "1200",
                          "format": "int32",
                          "type": "integer"
                        },
                        "ResWithSource": {
                          "description_en": "The adaptive resolution settings",
                          "description_zh": "分辨率随源配置",
                          "example": "{\\\"Type\\\":\\\"short\\\",\\\"Value\\\":\\\"1080\\\"}",
                          "type": "object"
                        },
                        "RtsFlag": {
                          "description_en": "The tag for Real-Time Streaming (RTS). The value is fixed to true.\n\nThis parameter is returned only when RTS is used",
                          "description_zh": "低延时的标签。固定取值true。\n\n当转码为低延时转码时，才返回此参数",
                          "example": "true",
                          "type": "string"
                        },
                        "TemplateType": {
                          "description_en": "The type of the custom transcoding template. Valid values:\n\nh264: H.264 standard transcoding.\n\nh264-nbhd: H.264 Narrowband HD™ transcoding.\n\nh265: H.265 standard transcoding.\n\nh265-nbhd: H.265 Narrowband HD™ transcoding.\n\naudio: audio-only transcoding",
                          "description_zh": "自定义转码模版类型。取值：\n\nh264：自定义H264标准模版。\nh264-nbhd：自定义H264窄带高清™模版。\nh265：自定义H265标准模版。\nh265-nbhd：自定义H265窄带高清模版。\naudio：纯音频模板",
                          "example": "h264",
                          "type": "string"
                        },
                        "VideoBitrate": {
                          "description_en": "The video bitrate. Unit: kbps",
                          "description_zh": "转码视频比特率。单位：kbps",
                          "example": "3000",
                          "format": "int32",
                          "type": "integer"
                        },
                        "VideoProfile": {
                          "description_en": "The video codec profile. Valid values:\n\nbaseline: suitable for mobile devices.\n\nmain: suitable for SD devices.\n\nhigh: suitable for HD devices",
                          "description_zh": "视频的编码等级。取值：\n\nbaseline：适合移动设备。\nmain：适合标准分辨率设备。\nhigh：适合高分辨率设备",
                          "example": "high",
                          "type": "string"
                        },
                        "Width": {
                          "description_en": "The output video width",
                          "description_zh": "转码视频宽度",
                          "example": "1000",
                          "format": "int32",
                          "type": "integer"
                        }
                      },
                      "type": "object"
                    },
                    "EncryptParameters": {
                      "description_en": "The encryption configurations",
                      "description_zh": "加密配置",
                      "properties": {
                        "EncryptType": {
                          "description_en": "The encryption type. The value is fixed to aliyun",
                          "description_zh": "加密类型。固定取值aliyun",
                          "example": "aliyun",
                          "type": "string"
                        },
                        "KmsKeyExpireInterval": {
                          "description_en": "The key rotation period. Unit: seconds. Valid values: 60 to 3600",
                          "description_zh": "换Key周期。取值范围：60~3600，单位：秒",
                          "example": "3600",
                          "type": "string"
                        },
                        "KmsKeyID": {
                          "description_en": "The ID of the customer master key (CMK) in Key Management Service (KMS)",
                          "description_zh": "用户KMS主密钥ID",
                          "example": "afce5722-81d2-43c3-9930-7601da11****",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "IsLazy": {
                      "description_en": "Indicates whether on-demand transcoding is enabled. Valid values:\n\ntrue: Transcoding only starts when the first viewer requests this transcoded stream.\n\nfalse: Transcoding starts immediately after the stream is published",
                      "description_zh": "是否开启强制转码。取值：\ntrue：延迟转码。\nfalse：强制转码",
                      "example": "true",
                      "type": "boolean"
                    },
                    "TranscodeApp": {
                      "description_en": "The AppName",
                      "description_zh": "应用名称",
                      "example": "liveApp****",
                      "type": "string"
                    },
                    "TranscodeName": {
                      "description_en": "The main streaming domain",
                      "description_zh": "主播流域名",
                      "example": "example.com",
                      "type": "string"
                    },
                    "TranscodeTemplate": {
                      "description_en": "The transcoding template. Valid values:\n\nStandard transcoding templates:\n\nlld: low definition.\n\nlsd: standard definition.\n\nlhd: high definition.\n\nlud: ultra-high definition.\n\nNarrowband HD™ transcoding templates:\n\nld: low definition.\n\nsd: standard definition.\n\nhd: high definition.\n\nud: ultra-high definition",
                      "description_zh": "转码模版。取值：\n\n标准质量模板：\n\n    - lld：流畅。\n    \n    - lsd：标清。\n    \n    - lhd：高清。\n    \n    - lud ：超清。\n\n窄带高清™转码模板： \n\n    - ld：流畅。\n    \n    - sd：标清。\n    \n    - hd：高清。\n    \n    - ud：超清",
                      "example": "lld",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "62136AE6-7793-45ED-B14A-60D19A9486D3",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
