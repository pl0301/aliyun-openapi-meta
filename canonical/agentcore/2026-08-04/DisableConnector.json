{
  "backend_timeout_ms": 10000,
  "camel_example": "aliyun agentcore POST /workspaces/ws-xxxx/connectors/qodercli/actions/disable --region cn-hangzhou --header \"Content-Type=application/json\" --version 2026-08-04 --force",
  "cmd_full_name": "agentcore disable-connector",
  "cmd_name": "disable-connector",
  "deprecated": false,
  "description_en": "Disables a QoderCLI Connector in a specified workspace. The Connector can be disabled only when no Agent is using it. After the Connector is disabled, the Connector and its Service Account Key configuration are removed",
  "description_zh": "停用指定工作空间中的 QoderCLI Connector。仅当没有 Agent 使用该 Connector 时可以停用；停用后移除 Connector 及其 Service Account Key 配置",
  "kebab_example": "aliyun agentcore disable-connector --workspace-id ws-xxxx --connector-name qodercli --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
  "name": "DisableConnector",
  "operation": {
    "action": "DisableConnector",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": "/workspaces/{workspaceId}/connectors/{connectorName}/actions/disable"
  },
  "parameters": [
    {
      "example": "ws-xxxx",
      "help_en": "The workspace ID",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "enum": [
        "qodercli"
      ],
      "example": "qodercli",
      "help_en": "The Connector name. Currently, only qodercli is supported",
      "help_zh": "Connector 名称，当前仅支持 qodercli",
      "location": "path",
      "name": "connector_name",
      "options": [
        "--connector-name"
      ],
      "raw_name": "connectorName",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/connectors/[connectorName]/actions/disable",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response for disabling a Connector",
        "description_zh": "停用 Connector 响应",
        "properties": {
          "code": {
            "description_en": "The business status code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "title_en": "",
            "title_zh": "业务状态码",
            "type": "string"
          },
          "data": {
            "description_en": "The Connector details",
            "description_zh": "Connector 详情",
            "properties": {
              "boundAgentCount": {
                "description_en": "The number of Agents bound to the Connector",
                "description_zh": "已绑定 Agent 数量",
                "example": "3",
                "format": "int64",
                "title_en": "",
                "title_zh": "已绑定 Agent 数量",
                "type": "integer"
              },
              "enabledAt": {
                "description_en": "The time when the Connector was enabled",
                "description_zh": "启用时间",
                "example": "2026-09-01T08:00:00Z",
                "title_en": "",
                "title_zh": "启用时间",
                "type": "string"
              },
              "metadata": {
                "description_en": "The Connector configuration JSON string before the Connector was disabled. This is sensitive data",
                "description_zh": "停用前的 Connector 配置 JSON 字符串，属于敏感信息",
                "example": "{\"site\":\"global\",\"organizationId\":\"org-xxxx\"}",
                "title_en": "",
                "title_zh": "Connector 配置",
                "type": "string"
              },
              "name": {
                "description_en": "The Connector name. Currently, the value is qodercli",
                "description_zh": "Connector 名称，当前为 qodercli",
