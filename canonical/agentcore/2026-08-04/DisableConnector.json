                "example": "qodercli",
                "title_en": "",
                "title_zh": "Connector 名称",
                "type": "string"
              },
              "status": {
                "description_en": "The Connector status",
                "description_zh": "Connector 状态",
                "enum": [
                  "DISABLED",
                  "ENABLING",
                  "ENABLED",
                  "DISABLING"
                ],
                "enumValueTitles": {
                  "DISABLED": "已停用",
                  "DISABLING": "停用中",
                  "ENABLED": "已启用",
                  "ENABLING": "启用中"
                },
                "example": "ENABLED",
                "title_en": "",
                "title_zh": "Connector 状态",
                "type": "string"
              }
            },
            "title_en": "",
            "title_zh": "Connector 详情",
            "type": "object"
          },
          "httpStatusCode": {
            "description_en": "The HTTP status code",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "title_en": "",
            "title_zh": "HTTP 状态码",
            "type": "integer"
          },
          "message": {
            "description_en": "The response message",
            "description_zh": "响应消息",
            "example": "success",
            "title_en": "",
            "title_zh": "响应消息",
            "type": "string"
          },
          "requestId": {
            "description_en": "The request ID",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "title_en": "",
            "title_zh": "请求 ID",
            "type": "string"
          },
          "success": {
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "example": "true",
            "title_en": "",
            "title_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "title_en": "",
        "title_zh": "停用 Connector 响应",
        "type": "object"
      }
    }
  }
}
