{
  "cmd_full_name": "qualitycheck get-sync-result",
  "cmd_name": "get-sync-result",
  "deprecated": true,
  "description_en": "You can obtain the real-time quality inspection result of the hotline",
  "description_zh": "获取热线实时质检结果",
  "kebab_example": "aliyun qualitycheck get-sync-result --json-str '{\"pageNumber\":1,\"pageSize\":10,\"requiredFields\":\"asrResult,agent,status,errorMessage,reviewStatus,reviewResult,score,taskId,reviewer,resolver,recording.name,recording.duration,recording.url,hitResult,business\",\"startTime\":\"2020-12-25 00:00:00\",\"endTime\":\"2020-12-31 23:59:59\"}' --base-me-agent-id 123456 --api-version 2019-01-15 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetSyncResult",
  "operation": {
    "action": "GetSyncResult",
    "api_style": "RPC",
    "api_version": "2019-01-15",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
