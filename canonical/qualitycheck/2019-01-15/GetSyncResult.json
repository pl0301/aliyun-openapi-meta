      "help_en": "Complete JSON string. For details, see the following information.  ",
      "help_zh": "完整JSON字符串信息，具体内容参见以下详细信息",
      "location": "query",
      "name": "json_str",
      "options": [
        "--json-str"
      ],
      "raw_name": "JsonStr",
      "required": true,
      "type": "string"
    },
    {
      "example": "123456",
      "help_en": "baseMeAgentId",
      "help_zh": "业务空间Id",
      "location": "query",
      "name": "base_me_agent_id",
      "options": [
        "--base-me-agent-id"
      ],
      "raw_name": "BaseMeAgentId",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "Qualitycheck",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "Result code. A value of 200 indicates success. Any other value indicates failure. The caller can use this field to determine the cause of failure.  ",
            "description_zh": "结果代码，200表示成功，若为别的值则表示失败，调用方可根据此字段判断失败原因",
            "example": "200",
            "type": "string"
          },
          "Count": {
            "description_en": "Total number of entries.  ",
            "description_zh": "总条数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "Data": {
            "description_en": "Query result",
            "description_zh": "查询结果",
            "items": {
              "description_en": "Query result",
              "description_zh": "查询结果",
              "properties": {
                "Agent": {
                  "description_en": "Agent information",
                  "description_zh": "客服信息",
                  "properties": {
                    "Id": {
                      "description_en": "Agent ID",
                      "description_zh": "客服ID",
                      "example": "12221",
                      "type": "string"
                    },
                    "Name": {
                      "description_en": "Agent name",
                      "description_zh": "客服姓名",
                      "example": "李四",
                      "type": "string"
                    },
                    "SkillGroup": {
                      "description_en": "Skill group name",
                      "description_zh": "技能组名称",
                      "example": "客服组",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "AsrResult": {
                  "description_en": "Transcription result (dialogue text)  ",
                  "description_zh": "转写结果（对话文本）",
                  "items": {
                    "description_en": "File transcription result.  ",
                    "description_zh": "文件转写结果",
                    "properties": {
                      "Begin": {
                        "description_en": "The start time of this sentence, which is the offset from the starting point in milliseconds.  ",
                        "description_zh": "本句话的开始时间，是相对起始点的开始时间偏移，单位ms",
                        "example": "340",
                        "format": "int64",
                        "type": "integer"
                      },
                      "EmotionValue": {
                        "description_en": "Emotion intensity value ranging from 1 to 10. A higher value indicates stronger emotion.  ",
                        "description_zh": "情绪能量值1-10，值越高情绪越强烈",
                        "example": "6",
                        "format": "int32",
                        "type": "integer"
                      },
                      "End": {
                        "description_en": "The end time of this sentence, which is the offset from the starting point in milliseconds.  ",
                        "description_zh": "本句话的结束时间，是相对起始点的结束时间偏移，单位ms",
                        "example": "3000",
                        "format": "int64",
                        "type": "integer"
                      },
                      "Role": {
                        "description_en": "Role in the dialogue content. Possible values: agent, Customer.  ",
                        "description_zh": "对话内容角色，可能值：客服、客户",
                        "example": "客服",
                        "type": "string"
                      },
                      "SilenceDuration": {
                        "description_en": "Internal field. Ignore it.  ",
                        "description_zh": "内部字段，请忽略",
                        "example": "11",
                        "format": "int32",
                        "type": "integer"
                      },
                      "SpeechRate": {
                        "description_en": "The average speech rate of this sentence, in characters per minute.  ",
                        "description_zh": "本句平均语速，单位：字/分钟",
                        "example": "221",
                        "format": "int32",
                        "type": "integer"
                      },
                      "Words": {
                        "description_en": "Dialogue content.  ",
                        "description_zh": "对话内容",
                        "example": "您好，很高兴为您服务",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "Comments": {
                  "description_en": "Review comments.  ",
                  "description_zh": "复核意见",
                  "example": "xxx",
                  "type": "string"
                },
                "CreateTime": {
                  "description_en": "Job Creation Time.  ",
                  "description_zh": "任务创建时间",
                  "example": "2019-07-24T19:31Z\t",
                  "type": "string"
                },
                "ErrorMessage": {
                  "description_en": "When status is neither 0 nor 1, this field indicates the Error Details.  ",
                  "description_zh": "当status是非0、1时表示错误详情",
                  "example": "xxxx",
                  "type": "string"
                },
                "HitResult": {
                  "description_en": "Rule hit result.  ",
                  "description_zh": "规则命中结果",
                  "items": {
                    "description_en": "Rule hit result.  ",
                    "description_zh": "规则命中结果",
                    "properties": {
                      "Hits": {
                        "description_en": "Specific hit location information. At the sentence dimension, returns which condition in the rule was hit and which specific characters triggered the hit within the sentence.  ",
                        "description_zh": "具体命中位置信息，以句子维度，返回命中句子中具体命中了规则中哪个条件，是哪几个字命中的",
                        "items": {
                          "description_en": "Rule hit result.  ",
                          "description_zh": "规则命中结果",
                          "properties": {
                            "Cid": {
                              "description_en": "List of hit condition IDs.  ",
                              "description_zh": "命中的条件ID列表",
                              "items": {
                                "description_en": "List of hit condition IDs.  ",
                                "description_zh": "命中的条件ID列表",
                                "example": "[\"1\",\"3\"]",
                                "type": "string"
                              },
                              "type": "array"
                            },
                            "KeyWords": {
                              "description_en": "Returns the specific characters in the current sentence that hit the rule, which are the keywords to be highlighted",
                              "description_zh": "返回当前句中是哪几个字命中了规则，也就是需要高亮展示的关键字",
                              "items": {
                                "description_en": "A list of positions where hits occurred",
                                "description_zh": "命中的位置列表",
                                "properties": {
                                  "Cid": {
                                    "description_en": "The ID of the condition that was hit",
                                    "description_zh": "命中的条件ID",
                                    "example": "66666",
                                    "type": "string"
                                  },
                                  "From": {
                                    "description_en": "The starting character position (inclusive) of the keyword to be highlighted. The value starts from 0 and can be at most the total number of characters in the sentence minus 1",
                                    "description_zh": "需要高亮展示的关键字从第几个字符开始，取值范围从0开始，最大值为当句话字符总数减1。高亮的字包含from",
                                    "example": "2",
                                    "format": "int32",
                                    "type": "integer"
                                  },
                                  "To": {
                                    "description_en": "The ending character position (exclusive) of the keyword to be highlighted. The maximum value is the total number of characters in the sentence minus 1. For example, in the sentence “不可能给你退货的”, if from=0 and to=3, the highlighted keyword is “不可能”, which consists of three characters",
                                    "description_zh": "需要高亮展示的关键字到第几个字符结束，最大值为当句话字符总数减1。高亮的字不包含to，例如一句话为“不可能给你退货的”，from=0，to=3，那么需要高亮的关键字就是“不可能”三个字",
                                    "example": "5",
                                    "format": "int32",
                                    "type": "integer"
                                  },
                                  "Val": {
                                    "description_en": "The exact keyword content",
                                    "description_zh": "具体的关键字内容",
                                    "example": "投诉",
                                    "type": "string"
                                  }
                                },
                                "type": "object"
                              },
                              "type": "array"
                            },
                            "Phrase": {
                              "description_en": "Details of the sentence that hit the current rule.  ",
                              "description_zh": "当前命中规则的句子详情",
                              "properties": {
                                "Begin": {
                                  "description_en": "The Start Time of this sentence, represented as an offset in milliseconds from the starting point",
                                  "description_zh": "本句话的开始时间，是相对起始点的开始时间偏移，单位ms",
                                  "example": "440",
                                  "format": "int64",
                                  "type": "integer"
                                },
                                "EmotionValue": {
                                  "description_en": "Emotion intensity value ranging from 1 to 10. A higher value indicates stronger emotion",
                                  "description_zh": "情绪能量值1-10，值越高情绪越强烈",
                                  "example": "6",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "End": {
                                  "description_en": "The End Time of this sentence, represented as an offset in milliseconds from the starting point",
                                  "description_zh": "本句话的结束时间，是相对起始点的结束时间偏移，单位ms",
                                  "example": "4000",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "Role": {
                                  "description_en": "The role in the conversation content. Possible values: agent, Customer, System",
                                  "description_zh": "对话内容角色，可能值：客服、客户、系统",
                                  "example": "客服",
                                  "type": "string"
                                },
                                "SilenceDuration": {
                                  "description_en": "Internal field. Ignore",
                                  "description_zh": "内部字段，请忽略",
                                  "example": "1",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "SpeechRate": {
                                  "description_en": "The speech rate of this sentence",
                                  "description_zh": "当句话的语速",
                                  "example": "234",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "Words": {
                                  "description_en": "A sentence spoken by this role",
                                  "description_zh": "这个角色说的一句话",
                                  "example": "我要投诉",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            }
                          },
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "Name": {
                        "description_en": "Hit rule name.  ",
                        "description_zh": "命中的规则名称",
                        "example": "测试规则",
                        "type": "string"
                      },
                      "ReviewResult": {
                        "description_en": "Review accuracy; possible values: 0 (fault); 1 (correct).  ",
                        "description_zh": "复核准确性；可能值：0（错误）；1（正确）",
                        "example": "1",
                        "format": "int32",
                        "type": "integer"
                      },
                      "Rid": {
                        "description_en": "Hit rule ID.  ",
                        "description_zh": "命中的规则ID",
                        "example": "1211",
                        "type": "string"
                      },
                      "Type": {
                        "description_en": "Rule type associated with the hit rule.  ",
                        "description_zh": "命中规则所关联的规则类型",
                        "example": "2",
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  "type": "array"
                },
                "Recording": {
                  "description_en": "Recording file information  ",
                  "description_zh": "录音文件信息",
                  "properties": {
                    "Business": {
                      "description_en": "Line-of-business name.  ",
                      "description_zh": "业务线名称",
                      "example": "客服部",
                      "type": "string"
                    },
                    "CallId": {
                      "description_en": "Call ID.  ",
                      "description_zh": "通话ID",
                      "example": "xxx",
                      "type": "string"
                    },
                    "CallTime": {
                      "description_en": "Recording generation UNIX timestamp, accurate to milliseconds.  ",
                      "description_zh": "录音生成时间戳，精确到毫秒",
                      "example": "1563967699000",
                      "type": "string"
                    },
                    "CallType": {
                      "description_en": "Call type:  \n1: Outgoing call  \n3: Incoming call  ",
                      "description_zh": "呼叫类型： \n1：呼出\n3：呼入",
                      "example": "1",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Callee": {
                      "description_en": "Callee number.  ",
                      "description_zh": "被叫号码",
                      "example": "1888888***",
                      "type": "string"
                    },
                    "Caller": {
                      "description_en": "Caller number.  ",
                      "description_zh": "主叫号码",
                      "example": "0108888****\t",
                      "type": "string"
                    },
                    "DataSetName": {
                      "description_en": "Internal field. Ignore this.  ",
                      "description_zh": "内部字段，请忽略",
                      "example": "xxx",
                      "type": "string"
                    },
                    "Duration": {
                      "description_en": "Total number of words in the conversation.  ",
                      "description_zh": "对话总字数",
                      "example": "232",
                      "format": "int64",
                      "type": "integer"
                    },
                    "DurationAudio": {
                      "description_en": "Call duration.  ",
                      "description_zh": "通话时长",
                      "example": "120",
                      "format": "int64",
                      "type": "integer"
                    },
                    "Id": {
                      "description_en": "File ID, which is the callId in the request parameters. If not specified, a random ID will be generated.  ",
                      "description_zh": "文件ID，即请求参数中的callId，若未指定则会随机生成一个",
                      "example": "xxxx",
                      "type": "string"
                    },
                    "Name": {
                      "description_en": "Recording file name.  ",
                      "description_zh": "录音文件名称",
                      "example": "123123.wav",
                      "type": "string"
                    },
                    "PrimaryId": {
                      "description_en": "Internal field. Ignore it.  ",
                      "description_zh": "内部字段，请忽略",
                      "example": "xxxx",
                      "type": "string"
                    },
                    "Remark1": {
                      "description_en": "Custom data 1.  ",
                      "description_zh": "自定义数据1",
                      "example": "xxx",
                      "type": "string"
                    },
                    "Remark2": {
                      "description_en": "Custom data 2.  ",
                      "description_zh": "自定义数据2",
                      "example": "xxx",
                      "type": "string"
                    },
                    "Remark3": {
                      "description_en": "Custom data 3.  ",
                      "description_zh": "自定义数据3",
                      "example": "xxx",
                      "type": "string"
                    },
                    "Url": {
                      "description_en": "Recording file URL, used for playback.  ",
                      "description_zh": "录音文件地址，用于录音播放",
                      "example": "http://aliyun.com/xxx.wav\t",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "Resolver": {
                  "description_en": "The quality inspector who actually reviewed the task",
                  "description_zh": "实际复核的质检员",
                  "example": "张三",
                  "type": "string"
                },
                "ReviewResult": {
                  "description_en": "Review accuracy. Possible values: 0 (fault); 1 (correct); 2 (partially correct); 3 (pending review).  ",
                  "description_zh": "复核准确性，可能值：0（错误）；1（正确）；2（部分正确）；3（待复核）",
                  "example": "3",
                  "format": "int32",
                  "type": "integer"
                },
                "ReviewStatus": {
                  "description_en": "Review status; possible values: 0 (not reviewed); 1 (reviewed).  ",
                  "description_zh": "复核状态；可能值：0（未复核）；1（已复核）",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "Reviewer": {
                  "description_en": "Username of the assigned quality inspector.  ",
                  "description_zh": "分配的质检员的用户名",
                  "example": "张三",
                  "type": "string"
                },
                "Score": {
                  "description_en": "Quality inspection score, with a maximum of 100.  ",
                  "description_zh": "质检得分，满分100",
                  "example": "100",
                  "format": "int32",
                  "type": "integer"
                },
                "Status": {
                  "description_en": "Current job status. Possible values: 0 (not completed); 1 (completed). The caller can use this field to determine whether the job is complete. Values other than 0 or 1 indicate an error; see the errorMessage field for Error Details",
                  "description_zh": "任务当前状态，可能值：0（未完成）；1（已完成），调用方可根据此字段判断任务是否完成；非0、1表示出错，错误详情可查看errorMessage字段",
                  "example": "1",
                  "format": "int32",
                  "type": "integer"
                },
                "TaskId": {
                  "description_en": "Job ID",
                  "description_zh": "任务ID",
                  "example": "20201231de3d34ec-40fa-4a55-8d27-76ea*****",
                  "type": "string"
                },
                "TaskName": {
                  "description_en": "Internal field. Ignore it.  ",
                  "description_zh": "内部字段，请忽略",
                  "example": "xxx",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "Message": {
            "description_en": "Error details when an error occurs; \"successful\" when the operation succeeded",
            "description_zh": "出错时表示出错详情，成功时为successful",
            "example": "successful",
            "type": "string"
          },
          "PageNumber": {
            "description_en": "Page number",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
            "description_en": "Number of entries per page",
            "description_zh": "每页条数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "Request ID",
            "description_zh": "请求id",
            "example": "76DB5D8C-5BD9-42A7-B527-5AF3A5F****",
            "type": "string"
          },
          "ResultCountId": {
            "description_en": "Internal field. Ignore it.  ",
            "description_zh": "内部字段，请忽略",
            "example": "xxx",
            "type": "string"
          },
          "Success": {
            "description_en": "Indicates whether the request succeeded. The caller can use this field to determine the request status: true indicates success; false or null indicates failure.  ",
            "description_zh": "请求是否成功，调用方可根据此字段来判断请求是否成功：true表示成功；false/null表示失败",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
