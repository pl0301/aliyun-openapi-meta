{
  "cmd_full_name": "qualitycheck sync-quality-check",
  "cmd_name": "sync-quality-check",
  "deprecated": false,
  "description_en": "Perform real-time quality inspection for hotlines",
  "description_zh": "进行热线实时质检",
  "kebab_example": "aliyun qualitycheck sync-quality-check --json-str '{\"tid\":\"20200823-234234\",\"dialogue\":\"{}\"}' --base-me-agent-id 1244721 --api-version 2019-01-15 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "SyncQualityCheck",
  "operation": {
    "action": "SyncQualityCheck",
    "api_style": "RPC",
    "api_version": "2019-01-15",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "create",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "{\"tid\":\"20200823-234234\",\"dialogue\":\"{}\"}",
      "help_en": "Complete JSON string information. See the details below",
      "help_zh": "完整JSON字符串信息，具体内容参见以下详细信息",
      "location": "query",
      "name": "json_str",
      "options": [
        "--json-str"
      ],
      "raw_name": "JsonStr",
      "required": true,
      "type": "string"
    },
    {
      "example": "1244721",
      "help_en": "Workspace ID",
      "help_zh": "业务空间Id",
      "location": "query",
      "name": "base_me_agent_id",
      "options": [
        "--base-me-agent-id"
      ],
      "raw_name": "BaseMeAgentId",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "",
  "product_code": "Qualitycheck",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "Result status code. 200 indicates success. Other values indicate failure. The caller can determine the reason for failure using this field",
            "description_zh": "结果状态码，200表示成功，若为别的值则表示失败，调用方可根据此字段判断失败原因",
            "example": "200",
            "type": "string"
          },
          "Data": {
            "description_en": "Returned result, including hit information",
            "description_zh": "返回结果，包含命中信息",
            "properties": {
              "BeginTime": {
                "description_en": "Time of recording and dialogue occurrence, in milliseconds since January 1, 1970, 00:00:00 UTC (UNIX timestamp in milliseconds, such as 1584535485856)",
                "description_zh": "录音&对话发生的时间，格林威治时间1970年01月01日00时00分00秒到现在的毫秒数（即毫秒时间戳，例如：1584535485856）",
                "example": "1584535485856",
                "format": "int64",
                "type": "integer"
              },
              "Rules": {
                "description_en": "List of hit rules. Each item is a rule. Only hit rule information and hit rule location information are returned",
                "description_zh": "命中的规则列表，每一条为一个规则，只返回命中的规则信息和命中规则位置信息",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "properties": {
                    "Hit": {
                      "description_en": "List of hit sentences. For this API, if a hit occurs, it is a single data entry",
                      "description_zh": "命中的句子列表，针对此接口，如果命中，为一条数据",
                      "items": {
                        "description_en": "",
                        "description_zh": "",
                        "properties": {
                          "HitKeyWords": {
                            "description_en": "Keywords that met the condition",
                            "description_zh": "条件命中的关键词",
                            "items": {
                              "description_en": "",
                              "description_zh": "",
                              "properties": {
                                "Cid": {
                                  "description_en": "Condition ID of the rule",
                                  "description_zh": "规则的条件ID",
                                  "example": "2312",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "From": {
                                  "description_en": "Start position of the keyword",
                                  "description_zh": "关键字的起始位置",
                                  "example": "1",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "Pid": {
                                  "description_en": "Index value of the hit sentence in the entire conversation",
                                  "description_zh": "命中句子在全部对话中的下标值",
                                  "example": "4",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "To": {
                                  "description_en": "End position of the keyword",
                                  "description_zh": "关键字的结束位置",
                                  "example": "4",
                                  "format": "int32",
                                  "type": "integer"
                                },
                                "Val": {
                                  "description_en": "Keyword",
                                  "description_zh": "关键字",
                                  "example": "你好",
                                  "type": "string"
                                }
                              },
                              "type": "object"
                            },
                            "type": "array"
                          },
                          "Phrase": {
                            "description_en": "Dialogue content that met the condition",
                            "description_zh": "条件命中的对话内容",
                            "properties": {
                              "Begin": {
                                "description_en": "Start time of this sentence relative to the entire conversation, in milliseconds",
                                "description_zh": "本句相对于整个对话的开始时间，单位：毫秒",
                                "example": "1230",
                                "format": "int64",
                                "type": "integer"
                              },
                              "EmotionValue": {
                                "description_en": "Emotional value of this sentence, 0-10. Higher values indicate stronger emotions",
                                "description_zh": "本句的情绪值，0-10，值越大情绪越高",
                                "example": "6",
                                "format": "int32",
                                "type": "integer"
                              },
                              "End": {
                                "description_en": "End time of this sentence relative to the entire conversation, in milliseconds",
                                "description_zh": "本句相对于整个对话的结束时间，单位：毫秒",
                                "example": "3440",
                                "format": "int64",
                                "type": "integer"
                              },
                              "Identity": {
                                "description_en": "Deprecated field. Ignore it",
                                "description_zh": "废弃字段，请忽略",
                                "example": "xxx",
                                "type": "string"
                              },
                              "Role": {
                                "description_en": "Role of this sentence. Valid values: customer service representative, customer",
                                "description_zh": "本句的角色，取值：客服、客户",
                                "example": "客服",
                                "type": "string"
                              },
                              "SilenceDuration": {
                                "description_en": "Deprecated field. Ignore it",
                                "description_zh": "废弃字段，请忽略",
                                "example": "123",
                                "format": "int32",
                                "type": "integer"
                              },
                              "SpeechRate": {
                                "description_en": "Speech rate of this sentence, in characters per minute",
                                "description_zh": "本句语速，单位：字/分钟",
                                "example": "233",
                                "format": "int32",
                                "type": "integer"
                              },
                              "Words": {
                                "description_en": "Dialogue content",
                                "description_zh": "对话内容",
                                "example": "你好请问有什么可以帮您的",
                                "type": "string"
                              }
                            },
                            "type": "object"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "Rid": {
                      "description_en": "ID of the hit rule",
                      "description_zh": "命中的规则ID",
                      "example": "232232",
                      "type": "string"
                    },
                    "RuleInfoBase": {
                      "description_en": "Rule basic information",
                      "description_zh": "规则基本信息",
                      "properties": {
                        "Comments": {
                          "description_en": "Rule remarks",
                          "description_zh": "规则备注",
                          "example": "邀约客户，客户不同意参加试听",
                          "title_en": "",
                          "title_zh": "规则备注",
                          "type": "string"
                        },
                        "Level": {
                          "description_en": "Rule importance level",
                          "description_zh": "规则重要程度",
                          "example": "2",
                          "format": "int32",
                          "title_en": "",
                          "title_zh": "规则重要程度",
                          "type": "integer"
                        },
                        "RuleCategoryName": {
                          "description_en": "Rule category name\n<notice>The requiredFields parameter must include \"ruleInfoBase.ruleCategoryName\".></notice>",
                          "description_zh": "规则类型名\n<notice>需要requiredFields字段传入\"ruleInfoBase.ruleCategoryName\"</notice>",
                          "example": "服务规范",
                          "title_en": "",
                          "title_zh": "规则类型名",
                          "type": "string"
                        },
                        "ScoreNum": {
                          "description_en": "Score value",
                          "description_zh": "计分值",
                          "example": "1",
                          "format": "int32",
                          "title_en": "",
                          "title_zh": "计分值",
                          "type": "integer"
                        },
                        "ScoreNumType": {
                          "description_en": "Scoring type. 0: bonus/penalty points, 1: one-time score",
                          "description_zh": "计分类型\n0：加减分，1：一次性得分",
                          "example": "1",
                          "format": "int32",
                          "title_en": "",
                          "title_zh": "计分类型\n0：加减分，1：一次性得分",
                          "type": "integer"
                        },
                        "ScoreType": {
                          "description_en": "1 for bonus points, 3 for penalty points. Default is 1",
                          "description_zh": "1加分 3减分 默认1",
                          "example": "1",
                          "format": "int32",
                          "title_en": "",
                          "title_zh": "1加分 3减分 默认1",
                          "type": "integer"
                        },
                        "Type": {
                          "description_en": "Rule type ID\n<notice>The requiredFields parameter must include \"ruleInfoBase\".></notice>",
                          "description_zh": "规则类型Id\n<notice>需要requiredFields字段传入\"ruleInfoBase\"</notice>",
                          "example": "1",
                          "format": "int32",
                          "title_en": "",
                          "title_zh": "规则类型Id",
                          "type": "integer"
                        }
                      },
                      "title_en": "",
                      "title_zh": "规则基本信息",
                      "type": "object"
                    },
                    "RuleName": {
                      "description_en": "Name of the hit rule",
                      "description_zh": "命中的规则的名称",
                      "example": "禁用语",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "Score": {
                "description_en": "Final score, with a maximum of 100",
                "description_zh": "最终得分，满分100",
                "example": "100",
                "format": "int32",
                "type": "integer"
              },
              "TaskId": {
                "description_en": "Task ID",
                "description_zh": "任务ID",
                "example": "66E1ACB866E1ACB8",
                "type": "string"
              },
              "Tid": {
                "description_en": "Unique identifier for the current conversation",
                "description_zh": "当前对话唯一标识",
                "example": "20200876-66E1ACB8",
                "type": "string"
              }
            },
            "type": "object"
          },
          "Message": {
            "description_en": "Error details if an error occurs. \"successful\" if successful",
            "description_zh": "出错时表示出错详情，成功时为successful",
            "example": "successful",
            "type": "string"
          },
          "RequestId": {
            "description_en": "Unique request identifier",
            "description_zh": "请求唯一标识",
            "example": "66E1ACB8-17B2-4BE8-8581-954A8*****",
            "type": "string"
          },
          "Success": {
            "description_en": "Indicates whether the request was successful. The caller can use this field to determine if the request succeeded: true for success; false/null for failure",
            "description_zh": "请求是否成功，调用方可根据此字段来判断请求是否成功：true表示成功；false/null表示失败",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
