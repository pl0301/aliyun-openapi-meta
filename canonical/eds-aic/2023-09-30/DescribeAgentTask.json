                },
                "InstanceId": {
                  "description_en": "The Mobile node ID",
                  "description_zh": "Mobile节点 ID",
                  "example": "acp-anzzuho371azi44xr",
                  "type": "string"
                },
                "Reason": {
                  "type": "string"
                },
                "RunningAt": {
                  "description_en": "The time when the task was created, in ISO 8601 format",
                  "description_zh": "任务创建时间，ISO 8601 格式",
                  "example": "2026-04-13T17:42:19Z",
                  "type": "string"
                },
                "Steps": {
                  "description_en": "The number of steps executed",
                  "description_zh": "执行的步骤数",
                  "example": "30",
                  "type": "string"
                },
                "TaskDigest": {
                  "title_en": "",
                  "title_zh": "任务摘要文本，最大25个字符",
                  "type": "string"
                },
                "TaskDuration": {
                  "description_en": "The task duration. This field is returned only when CurrentStatus is FAILED or COMPLETED",
                  "description_zh": "任务耗时，CurrentStatus=FAILED/COMPLETED时有该字段",
                  "example": "50",
                  "type": "string"
                },
                "TaskId": {
                  "description_en": "The task ID, which is globally unique",
                  "description_zh": "任务 ID，全局唯一",
                  "example": "t-imr0fufqd7cle****",
                  "type": "string"
