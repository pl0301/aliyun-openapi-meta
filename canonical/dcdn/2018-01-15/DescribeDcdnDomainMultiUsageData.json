      "raw_name": "StartTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "2017-12-10T21:00:00Z",
      "help_en": "The end of the time range to query. The end time must be later than the start time.\n\nSpecify the time in the ISO 8601 standard in the yyyy-MM-ddTHH:mm:ssZ format. The time must be in UTC.\n\nThis parameter must be used with the StartTime parameter.\n\nMust be used with StartTime",
      "help_zh": "结束时间需大于起始时间。\n日期格式按照ISO8601表示法，并使用UTC时间。\n格式为：YYYY-MM-DDThh:mm:ssZ。\n需要和StartTime配合使用",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    }
