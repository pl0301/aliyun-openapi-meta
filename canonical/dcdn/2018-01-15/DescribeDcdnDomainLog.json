      "help_zh": "获取日志结束时间点。\n\n日期格式按照ISO8601表示法，并使用UTC+0时间，格式为yyyy-MM-ddTHH:mm:ssZ。\n\n结束时间需大于起始时间",
      "location": "query",
      "name": "end_time",
      "options": [
        "--end-time"
      ],
      "raw_name": "EndTime",
      "required": false,
      "type": "string"
    }
  ],
