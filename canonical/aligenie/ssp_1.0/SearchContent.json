  "description_en": "Search according to specific search criteria.  ",
  "description_zh": "按照特定的搜索条件搜索",
  "kebab_example": "",
  "method": "POST",
  "multi_version": true,
  "name": "SearchContent",
  "operation": {
    "action": "SearchContent",
    "api_style": "ROA",
    "api_version": "ssp_1.0",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "protocol": "HTTPS",
    "req_body_type": "formData",
