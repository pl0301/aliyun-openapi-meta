          "name": "play_from",
          "options": [
            "--play-from"
          ],
          "raw_name": "PlayFrom",
          "required": false,
          "type": "string"
        },
        {
          "example": "content",
          "help_en": "Content type for playback.\n\nValues: \"content\" for content, \"album\" for album, and \"collect\" for playlist",
          "help_zh": "播放内容类型\n\n内容：content；专辑：album；歌单：collect",
          "name": "content_type",
          "options": [
            "--content-type"
          ],
          "raw_name": "ContentType",
          "required": true,
          "type": "string"
        },
        {
          "element": {
            "fields": [
              {
                "example": "12345",
                "help_en": "Third-party ID.\n\nIf the content type is \"content\", this is the content ID. If it is \"album\", this is the album ID",
                "help_zh": "三方id\n\n如果是内容则是内容id；如果是专辑则是专辑id",
                "name": "raw_id",
                "options": [
                  "--raw-id"
                ],
                "raw_name": "RawId",
                "required": true,
                "type": "string"
              },
              {
                "example": "xiami",
                "help_en": "Source",
