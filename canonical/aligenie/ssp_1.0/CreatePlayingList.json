                "raw_name": "Source",
                "required": true,
                "type": "string"
              }
            ],
            "type": "object"
          },
          "help_en": "Playback content list.\n\nIf the content type is \"content\", multiple entries are supported. If it is \"album\", only the first entry takes effect",
          "help_zh": "播放内容列表\n\n若是内容，支持多个；若是专辑，只有第一个有效",
          "name": "content_list",
          "options": [
            "--content-list"
          ],
          "raw_name": "ContentList",
          "required": true,
          "type": "array"
