        {
          "example": "0",
          "help_en": "Playback index.\n\nCan be empty. Default is 0, indicating playback starts from the beginning",
          "help_zh": "播放的index\n\n可空。默认为0，表示从头播放",
          "name": "index",
          "options": [
            "--index"
          ],
          "raw_name": "Index",
          "required": false,
          "type": "int"
