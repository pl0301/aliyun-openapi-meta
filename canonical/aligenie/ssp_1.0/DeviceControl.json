{
  "cmd_full_name": "aligenie device-control",
  "cmd_name": "device-control",
  "deprecated": false,
  "description_en": "Control property values such as device volume",
  "description_zh": "设备音量等属性值控制",
  "kebab_example": "",
  "method": "POST",
  "multi_version": true,
  "name": "DeviceControl",
  "operation": {
    "action": "DeviceControl",
    "api_style": "ROA",
    "api_version": "ssp_1.0",
    "content_type": "application/x-www-form-urlencoded",
    "method": "POST",
    "protocol": "HTTPS",
    "req_body_type": "formData",
    "url": "/v1.0/ssp/control"
  },
  "parameters": [
    {
      "fields": [
        {
          "example": "10",
          "help_en": "Target volume value  ",
          "help_zh": "音量目标值",
          "name": "volume",
          "options": [
            "--volume"
          ],
          "raw_name": "Volume",
          "required": false,
          "type": "int"
        },
        {
          "example": "false",
          "help_en": "Indicates whether mute is enabled. If this field is set to true, you must also specify the volume value as 0.  ",
          "help_zh": "是否静音，在设置该字段为true时，需要同时指定音量值为0",
          "name": "muted",
          "options": [
            "--muted"
          ],
          "raw_name": "Muted",
          "required": false,
          "type": "bool"
        }
      ],
      "help_en": "Input parameters for volume control  ",
      "help_zh": "控制音量入参",
      "location": "formData",
      "name": "control_request",
      "options": [
        "--control-request"
      ],
      "param_style": "json",
      "raw_name": "ControlRequest",
      "required": false,
      "type": "object"
    },
    {
      "fields": [
        {
          "enum": [
            "PROJECT_ID"
          ],
          "example": "PROJECT_ID",
          "help_en": "Encoding Type. Enter PROJECT_ID here",
          "help_zh": "编码类型，此处填写PROJECT_ID",
          "name": "encode_type",
          "options": [
            "--encode-type"
          ],
          "raw_name": "EncodeType",
          "required": true,
          "type": "string"
        },
        {
          "example": "123",
          "help_en": "Value corresponding to the encoding type. Enter the Project ID of the project where the product resides. You can View this in the Tmall Genie AI platform console",
          "help_zh": "编码类型对应的值，此处填写该产品所在项目的Project ID。请在天猫精灵AI平台的控制台中查看",
          "name": "encode_key",
          "options": [
            "--encode-key"
          ],
          "raw_name": "EncodeKey",
          "required": true,
          "type": "string"
        },
        {
          "enum": [
            "OPEN_ID",
            "UNION_ID"
          ],
          "example": "OPEN_ID",
          "help_en": "The type of Device ID:  \nOPEN_ID: The default Device ID identity.  \nUNION_ID: The organization-dimension Device ID identity. You must request an organization in advance on the Open Platform.  ",
          "help_zh": "设备Id的类型 ：\nOPEN_ID：默认的设备ID标识。\nUNION_ID: 组织维度的设备ID标识，需要提前在开放平台申请组织",
          "name": "id_type",
          "options": [
            "--id-type"
          ],
          "raw_name": "IdType",
          "required": true,
          "type": "string"
        },
        {
          "example": "123",
          "help_en": "Device ID. Enter the value of deviceOpenId or deviceUnionId",
          "help_zh": "设备标识，填写deviceOpenId或deviceUnionId的值",
          "name": "id",
          "options": [
            "--id"
          ],
          "raw_name": "Id",
          "required": true,
          "type": "string"
        },
        {
          "example": "1*****2",
          "help_en": "Organization ID of the device. Required if IdType is UNION_ID",
          "help_zh": "设备的组织ID，如果IdType为UNION_ID时必填",
          "name": "organization_id",
          "options": [
            "--organization-id"
          ],
          "raw_name": "OrganizationId",
          "required": false,
          "type": "string"
        }
      ],
      "help_en": "List of device ID information",
      "help_zh": "设备标识信息列表",
      "location": "query",
      "name": "device_info",
      "options": [
        "--device-info"
      ],
      "param_style": "json",
      "raw_name": "DeviceInfo",
      "required": true,
      "type": "object"
    }
  ],
