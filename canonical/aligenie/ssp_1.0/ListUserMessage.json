{
  "cmd_full_name": "aligenie list-user-message",
  "cmd_name": "list-user-message",
  "deprecated": false,
  "description_en": "Query the list of user message records based on the query conditions, including the start time and the number of entries to return",
  "description_zh": "查询用户的留言消息列表，基于查询条件开始时间，查询条数返回结果",
  "kebab_example": "",
  "method": "GET",
  "multi_version": true,
  "name": "ListUserMessage",
  "operation": {
    "action": "ListUserMessage",
    "api_style": "ROA",
    "api_version": "ssp_1.0",
    "method": "GET",
    "protocol": "HTTPS",
    "url": "/v1.0/ssp/listUserMessage"
  },
  "parameters": [
    {
      "example": "2022-07-27 14:06:55.984",
      "help_en": "After a specific point in time  ",
      "help_zh": "某个时间点之后",
      "location": "query",
      "name": "before_time",
      "options": [
        "--before-time"
      ],
      "raw_name": "BeforeTime",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "Number of records to query  ",
      "help_zh": "查询条数",
      "location": "query",
      "name": "limit",
      "options": [
        "--limit"
      ],
      "raw_name": "limit",
      "required": false,
      "type": "int"
    },
    {
      "fields": [
        {
          "enum": [
            "PROJECT_ID"
          ],
          "example": "PROJECT_ID",
          "help_en": "Encoding type. There are multiple ways to obtain the user identifier for Maojing, and each method corresponds to a different encoding type: - PACKAGENAME: APK package name, used for Android application client links - SKILLID: Skill ID, used for cloud-based links  ",
          "help_zh": "编码类型，获取猫精的用户标识的途径有多种，不同途径对应不同的编码类型 - PACKAGENAME：apk包名，Android应用客户链路的编码类型 - SKILLID：技能ID，云端链路的编码类型",
          "name": "encode_type",
          "options": [
            "--encode-type"
          ],
          "raw_name": "EncodeType",
          "required": true,
          "type": "string"
        },
        {
          "example": "123",
          "help_en": "Value corresponding to the encoding type. When the encoding type is SKILLID, this value is the application's Skill ID. When the encoding type is PACKAGENAME, this value is the packageName of the corresponding client app.  ",
          "help_zh": "编码类型对应的值，编码类型是SKILLID时，其值为应用的Skill ID； 编码类型是PACKAGENAME时，其值为对应客户端App的packageName",
          "name": "encode_key",
          "options": [
            "--encode-key"
          ],
          "raw_name": "EncodeKey",
          "required": true,
          "type": "string"
        },
        {
          "enum": [
            "OPEN_ID",
            "UNION_ID"
          ],
          "example": "OPEN_ID",
          "help_en": "Type of user ID: - OPENID: Default user ID identifier - UNIONID: Organization-level user ID identifier, available only after an organization has been registered on the Maojing skill application Open Platform  ",
          "help_zh": "用户Id的类型 - OPENID：默认的用户ID标识 - UNIONID: 组织维度的用户ID标识，在猫精技能应用开放平台申请过组织后才会有",
          "name": "id_type",
          "options": [
            "--id-type"
          ],
          "raw_name": "IdType",
          "required": true,
          "type": "string"
        },
        {
          "example": "HOFF****my7Iw=",
          "help_en": "User identifier (userOpenId or userUnionId)  ",
          "help_zh": "用户标识（userOpenId或userUnionId）",
          "name": "id",
          "options": [
            "--id"
          ],
          "raw_name": "Id",
          "required": true,
          "type": "string"
        },
        {
          "example": "1**2",
          "help_en": "Organization ID. Required when IdType is UNION_ID  ",
          "help_zh": "组织ID，如果IdType为UNION_ID时必填",
          "name": "organization_id",
          "options": [
            "--organization-id"
          ],
          "raw_name": "OrganizationId",
          "required": false,
          "type": "string"
        }
      ],
      "help_en": "User identifier information  ",
      "help_zh": "用户标识信息",
      "location": "query",
      "name": "user_info",
      "options": [
        "--user-info"
      ],
      "param_style": "json",
      "raw_name": "UserInfo",
      "required": true,
      "type": "object"
    }
  ],
  "pathPattern": "/v1.0/ssp/listUserMessage",
  "product_code": "AliGenie",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "Service Return Result",
        "description_zh": "服务返回结果",
        "properties": {
          "Code": {
            "description_en": "Status code returned by the service. SUCCESS indicates success; otherwise, it indicates failure",
            "description_zh": "服务返回的状态码 SUCCESS为成功 否则均为失败",
            "example": "SUCCESS",
            "type": "string"
          },
          "Message": {
            "description_en": "error message",
            "description_zh": "错误信息",
            "example": "外部userId映射关系不存在",
            "title_en": "Id of the request",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Result": {
            "description_en": "List of user message query results",
            "description_zh": "用户留言查询结果列表",
            "items": {
              "description_en": "Message details",
              "description_zh": "留言详情",
              "properties": {
                "Content": {
                  "description_en": "Message text",
                  "description_zh": "留言文本",
                  "example": "哈哈哈",
                  "type": "string"
                },
                "DeviceName": {
                  "description_en": "Device name  ",
                  "description_zh": "设备名称",
                  "example": "卧室的小芳",
                  "type": "string"
                },
                "GmtCreate": {
                  "description_en": "Time when the message was sent",
                  "description_zh": "留言发出时间",
                  "example": "2022-07-27 14:06:27.000",
                  "type": "string"
                },
                "Id": {
                  "description_en": "Message ID",
                  "description_zh": "留言id",
                  "example": "123456",
                  "type": "string"
                },
                "Pic": {
                  "description_en": "Device Image",
                  "description_zh": "设备图片",
                  "example": "http://xx",
                  "type": "string"
                },
                "Source": {
                  "description_en": "Message source: app or box",
                  "description_zh": "消息来源于app/box",
                  "example": "app",
                  "type": "string"
                },
                "SourceUuid": {
                  "description_en": "Source Device ID",
                  "description_zh": "来源设备ID",
                  "example": "AF188**065EE4B**DD68CE**951D84D4",
                  "type": "string"
                },
                "Status": {
                  "description_en": "Message status: 0 indicates unread, and 1 indicates read",
                  "description_zh": "留言状态，0为未读，1为已读",
                  "example": "0",
                  "format": "int32",
                  "type": "integer"
                },
                "Type": {
                  "description_en": "Currently only audio is supported",
                  "description_zh": "目前只有audio",
                  "example": "audio",
                  "type": "string"
                },
                "Url": {
                  "description_en": "Audio message link  ",
                  "description_zh": "留言音频链接",
                  "example": "http://xx",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
    }
  }
}
