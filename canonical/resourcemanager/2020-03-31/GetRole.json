  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "04F0F334-1335-436C-A1D7-6C044FE73368",
            "type": "string"
          },
          "Role": {
            "description_en": "The information about the role",
            "description_zh": "角色信息",
            "properties": {
              "Arn": {
                "description_en": "The Alibaba Cloud Resource Name (ARN) of the role",
                "description_zh": "角色的资源描述符",
                "example": "acs:ram::123456789012****:role/ECSAdmin",
                "type": "string"
              },
              "AssumeRolePolicyDocument": {
                "description_en": "The document of the policy in which the identity that can assume the role is specified",
                "description_zh": "扮演角色的权限策略内容",
                "example": "{ \\\"Statement\\\": [ { \\\"Action\\\": \\\"sts:AssumeRole\\\", \\\"Effect\\\": \\\"Allow\\\", \\\"Principal\\\": { \\\"RAM\\\": \\\"acs:ram::12345678901234****:root\\\" } } ], \\\"Version\\\": \\\"1\\\" }",
                "type": "string"
              },
              "CreateDate": {
                "description_en": "The time when the role was created",
                "description_zh": "角色创建时间",
                "example": "2015-01-23T12:33:18Z",
                "type": "string"
              },
              "Description": {
                "description_en": "The description of the role",
                "description_zh": "角色描述",
                "example": "ECS管理角色",
                "type": "string"
              },
              "IsServiceLinkedRole": {
                "description_en": "Indicates whether the role is a service-linked role",
                "description_zh": "是否为服务关联角色",
                "example": "true",
                "type": "boolean"
              },
              "LatestDeletionTask": {
                "description_en": "The information of the most recent deletion task",
                "description_zh": "最近一次删除任务信息",
                "properties": {
                  "CreateDate": {
                    "description_en": "The time when the deletion task was created",
                    "description_zh": "删除任务创建时间",
                    "example": "2018-10-23T12:33:18Z",
                    "type": "string"
                  },
                  "DeletionTaskId": {
                    "description_en": "The ID of the deletion task",
                    "description_zh": "删除任务ID",
                    "example": "ECSAdmin/cc61514b-26eb-4453-ab53-b142eb702a3d",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "MaxSessionDuration": {
                "description_en": "The maximum session duration of the role",
                "description_zh": "角色最大会话时间",
                "example": "3600",
                "format": "int64",
                "type": "integer"
              },
              "RoleId": {
                "description_en": "The ID of the role",
                "description_zh": "角色ID",
                "example": "90123456789****",
                "type": "string"
              },
              "RoleName": {
                "description_en": "The name of the role",
                "description_zh": "角色名称",
                "example": "ECSAdmin",
                "type": "string"
              },
              "RolePrincipalName": {
                "description_en": "The name of the role after authorization",
                "description_zh": "被授权角色名称",
                "example": "ECSAdmin@role.123456.onaliyunservice.com",
                "type": "string"
              },
              "UpdateDate": {
                "description_en": "The time when the role was updated",
                "description_zh": "角色更新时间",
                "example": "2016-01-23T12:33:18Z",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  }
