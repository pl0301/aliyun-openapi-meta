                  "description_en": "The creation time in UTC. The time follows the ISO 8601 standard in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format. The time is displayed in UTC",
                  "description_zh": "UTC创建时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
                  "example": "2019-03-01T08:00:00Z",
                  "type": "string"
                },
                "Description": {
                  "description_en": "The application description",
                  "description_zh": "应用描述",
                  "example": "my first app.",
                  "type": "string"
                },
                "ModificationTime": {
                  "description_en": "The modification time in UTC. The time follows the ISO 8601 standard in the <i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z format. The time is displayed in UTC",
                  "description_zh": "UTC更新时间。格式为：<i>yyyy-MM-dd</i>T<i>HH:mm:ss</i>Z（UTC时间）",
                  "example": "2019-03-01T09:00:00Z",
