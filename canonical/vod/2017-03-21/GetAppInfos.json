  "parameters": [
    {
      "doc_required": true,
      "example": "app-****",
      "help_en": "The list of application IDs. The list consists of one or more application IDs. An application ID is the value of the AppId parameter returned by the https://help.aliyun.com/document_detail/113266.html or https://help.aliyun.com/document_detail/114000.html operation.\nA maximum of 10 IDs are supported.\nSeparate multiple IDs with commas (,)",
      "help_zh": "应用ID列表。由一个或多个应用ID组成，应用ID为调用https://help.aliyun.com/document_detail/113266.html接口或https://help.aliyun.com/document_detail/114000.html接口返回参数AppId的值。\n最多支持10个ID。\n多个ID之间使用半角逗号（,）分隔",
      "location": "query",
      "name": "app_ids",
      "options": [
        "--app-ids"
      ],
      "raw_name": "AppIds",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "vod",
  "protocol": "HTTP|HTTPS",
