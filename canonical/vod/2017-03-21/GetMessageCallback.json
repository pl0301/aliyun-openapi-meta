{
  "backend_timeout_ms": 3000,
  "camel_example": "aliyun vod GetMessageCallback --region cn-hangzhou --AppId 'app-1000000'",
  "cmd_full_name": "vod get-message-callback",
  "cmd_name": "get-message-callback",
  "deprecated": false,
  "description_en": "Queries the callback method, callback URL, and event types of event notifications",
  "description_zh": "调用本接口查询事件通知的回调方式、回调地址、事件类型",
  "kebab_example": "aliyun vod get-message-callback --app-id app-1000000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetMessageCallback",
  "operation": {
    "action": "GetMessageCallback",
    "api_style": "RPC",
    "api_version": "2017-03-21",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "app-1000000",
      "help_en": "The application ID. If this parameter is not specified, the ID of the system default application is used. The fixed value is app-1000000",
      "help_zh": "应用ID。不传时为系统默认应用的ID，取固定值：app-1000000",
      "location": "query",
      "name": "app_id",
      "options": [
        "--app-id"
      ],
      "raw_name": "AppId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "vod",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "MessageCallback": {
            "description_en": "The event notification configuration",
            "description_zh": "事件通知配置",
            "properties": {
              "AppId": {
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "app-1000000",
                "type": "string"
              },
              "AuthKey": {
                "description_en": "The authentication key when the callback method is set to HTTP",
                "description_zh": "回调方式选择HTTP时，鉴权Key",
                "example": "12345678abc",
                "type": "string"
              },
              "AuthSwitch": {
                "description_en": "The callback authentication switch when the callback method is set to HTTP. Valid values:\non: enabled.\noff: disabled",
                "description_zh": "回调方式选择HTTP时，回调鉴权开关，取值：\non（启用）\noff（不启用）",
                "example": "on",
                "type": "string"
              },
              "CallbackType": {
                "description_en": "The callback method. Valid values:\nHTTP\nMNS",
                "description_zh": "回调方式，取值：\nHTTP\nMNS",
                "example": "HTTP",
                "type": "string"
              },
              "CallbackURL": {
                "description_en": "The callback URL when the callback method is set to HTTP",
                "description_zh": "回调方式选择HTTP时，回调地址",
                "example": "http://test.com/test",
                "type": "string"
              },
              "EventTypeList": {
                "description_en": "The callback event types",
                "description_zh": "回调事件类型",
                "example": "FileUploadComplete,StreamTranscodeComplete,TranscodeComplete,SnapshotComplete,AIComplete,AddLiveRecordVideoComplete,CreateAuditComplete,UploadByURLComplete,ProduceMediaComplete,LiveRecordVideoComposeStart,ImageUploadComplete,VideoAnalysisComplete",
                "type": "string"
              },
              "MnsEndpoint": {
                "description_en": "The public endpoint of the MSMQ when the callback method is set to MNS",
                "description_zh": "回调方式选择MNS时，消息队列公网Endpoint",
                "example": "http://1234567.mns.cn-shanghai-internal.aliyuncs.com/",
                "type": "string"
              },
              "MnsQueueName": {
                "description_en": "The name of the MSMQ when the callback method is set to MNS",
                "description_zh": "回调方式选择MNS时，消息队列名称",
                "example": "vodcallback",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "272A222A-F7F7-4A3E-****-F531574F1234",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
