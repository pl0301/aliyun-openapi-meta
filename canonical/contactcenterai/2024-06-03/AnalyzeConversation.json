{
  "camel_example": "",
  "cmd_full_name": "contactcenterai analyze-conversation",
  "cmd_name": "analyze-conversation",
  "deprecated": false,
  "description_en": "Retrieves conversation analysis results including conversation summary, title generation, keywords, field information extraction, questions and solutions, service quality inspection, to-do items, satisfaction, emotion detection, QA extraction, user profiles, and tag categorization. The application invokes HTTP calls to complete customer responses",
  "description_zh": "获取对话摘要、标题生成、关键词、字段信息抽取、问题及解决方案、服务质检、代办事项、满意度、情绪检测、QA抽取、用户画像、标签分类等对话分析结果，应用调用支持 HTTP 调用来完成客户的响应",
  "kebab_example": "aliyun contactcenterai analyze-conversation --workspace-id llm-3680000003ifum --app-id a070a49c681f4a95a0f000000000035c --category-tags tagName=客服过度承诺 tagDesc=客服在服务客户过程中，基于已有的服务标准是否存在过度承诺的行为 --dialogue '{\"sentences\":[{\"role\":\"user\",\"text\":\"请问怎么申请新卡\"}],\"sessionId\":\"session-01\"}' --examples '[{\"output\":\"问题描述：询问2.2更新时间，处理方案：已告知\",\"sentences\":[{\"role\":\"user\",\"chatId\":\"chat-01\",\"text\":\"什么时候更新\"}]}]' --fields '[{\"code\":\"phoneNumber\",\"name\":\"来电原因类型\",\"desc\":\"用户来电咨询的原因分类，主要有投诉、咨询、政策建议等。\",\"enumValues\":[{\"enumValue\":\"新业务拓展\",\"desc\":\"客户有新的需求/新的场景，客服跟进沟通需求细节\"}]}]' --model-code tyxmTurbo --result-types summary --scene-name '阿里云工单质检场景' --service-inspection '{\"inspectionIntroduction\":\"请检测客服是否存在服务不当的行为，包括：过度承诺、故意套取客户隐私信息等\",\"sceneIntroduction\":\"保险销售场景\",\"inspectionContents\":[{\"title\":\"客服是否过度承诺\",\"content\":\"客服在服务客户过程中，基于已有的服务标准是否存在过度承诺的行为，如：最快到货时间是12小时，无法给客户承诺更快的到货时间。\"}]}' --stream false --user-profiles name=sex value=表示客户的性别，从列表_“男”,_“女”_中选择一个值 --time-constraint-list 2026年1月 --source-caller-uid example-string --custom-prompt '对通话内容进行总结_dialogue' --response-format-type jsonObject --region cn-hangzhou",
