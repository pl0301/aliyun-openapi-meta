  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response parameters",
        "description_zh": "返回结果",
        "properties": {
          "OIDCProvider": {
            "description_en": "The information about the OIDC IdP",
            "description_zh": "OIDC身份提供商信息",
            "properties": {
              "Arn": {
                "description_en": "The Alibaba Cloud Resource Name (ARN) of the OIDC IdP",
                "description_zh": "OIDC身份提供商的ARN",
                "example": "acs:ram::177242285274****:oidc-provider/TestOIDCProvider",
                "type": "string"
              },
              "ClientIds": {
                "description_en": "The ID of the client. If multiple client IDs are returned, the client IDs are separated by commas (,)",
                "description_zh": "客户端ID。多个之间用半角逗号（,）分隔",
                "example": "0oa4u6l8x5WoaVbd****",
                "type": "string"
              },
              "CreateDate": {
                "description_en": "The time when the OIDC IdP was created. The time is displayed in UTC",
                "description_zh": "创建时间（UTC时间）",
                "example": "2021-11-11T06:56:03Z",
                "type": "string"
              },
              "Description": {
                "description_en": "The description of the OIDC IdP",
                "description_zh": "OIDC身份提供商的描述",
                "example": "This is a new OIDC Provider.",
                "type": "string"
              },
              "Fingerprints": {
                "description_en": "The fingerprint of the HTTPS certificate. If multiple fingerprints are returned, the fingerprints are separated by commas (,)",
                "description_zh": "HTTPS CA证书的验证指纹。多个之间用半角逗号（,）分隔",
                "example": "5938fd4d98bab03faadb97b34396831e3780****",
                "type": "string"
              },
              "GmtCreate": {
                "description_en": "The timestamp when the OIDC IdP was created",
                "description_zh": "创建时间（时间戳）",
                "example": "1636613763000",
                "type": "string"
              },
              "GmtModified": {
                "description_en": "The timestamp when the OIDC IdP was modified",
                "description_zh": "修改时间（时间戳）",
                "example": "1636706309000",
                "type": "string"
              },
              "IssuanceLimitTime": {
                "description_en": "The earliest time when an external IdP can issue an ID token. If the value of the iat field in the ID token is later than the current time, the request is rejected. Unit: hours. Valid values: 1 to 168",
                "description_zh": "允许外部IdP颁发ID Token的最早签发时间。ID Token中的iat字段如果距离当前时间大于这个值则请求会被拒绝。\n单位：小时。取值范围：1~168",
                "example": "12",
                "format": "int64",
                "type": "integer"
              },
              "IssuerUrl": {
                "description_en": "The URL of the issuer",
                "description_zh": "OIDC身份提供商的颁发者URL",
                "example": "https://xxxxxx.example.com",
                "type": "string"
              },
              "OIDCProviderName": {
                "description_en": "The name of the OIDC IdP",
                "description_zh": "OIDC身份提供商的名称",
                "example": "TestOIDCProvider",
                "type": "string"
              },
              "UpdateDate": {
                "description_en": "The time when the OIDC IdP was modified. The time is displayed in UTC",
                "description_zh": "修改时间（UTC时间）",
                "example": "2021-11-12T08:38:29Z",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "C90CE971-4C7F-5D93-BD3E-2D0E79D03C01",
