                      "format": "int64",
                      "type": "integer"
                    },
                    "FailedNum": {
                      "description_en": "The number of failed streams",
                      "description_zh": "失败流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "OfflineNum": {
                      "description_en": "The number of offline streams",
                      "description_zh": "离线流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "OnlineNum": {
                      "description_en": "The number of online streams",
                      "description_zh": "在线流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    },
                    "StreamNum": {
                      "description_en": "The number of streams",
                      "description_zh": "流数量",
                      "example": "0",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "Status": {
                  "description_en": "The device status. Valid values:\n\non (online)\n\noff (offline)\n\nfailed\n\nnew (unregistered)",
