                  "description_en": "The latitude of the device",
                  "description_zh": "设备维度",
                  "example": "119.20",
                  "type": "string"
                },
                "Longitude": {
                  "description_en": "The longitude of the device",
                  "description_zh": "设备经度",
                  "example": "45.00",
                  "type": "string"
                },
                "Name": {
                  "description_en": "The device name",
                  "description_zh": "设备名称",
                  "example": "xxx路口摄像头",
                  "type": "string"
                },
                "Params": {
                  "description_en": "Other parameters of the device",
                  "description_zh": "设备其他参数",
                  "example": "{}",
                  "type": "string"
