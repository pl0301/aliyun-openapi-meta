            "description_zh": "设备列表",
            "items": {
              "description_en": "",
              "description_zh": "",
              "properties": {
                "AlarmMethod": {
                  "description_en": "The GB/T 28181 alarm subscription method. Valid values:\n\n0 (all)\n\n5 (video alarm)\n\n7 (other alarm)\n\nAn empty value indicates that no alarm is subscribed.\n\nSpecify multiple values. Separate them with commas (,)",
                  "description_zh": "订阅的国标报警方式。取值范围：\n0（全部）\n5（视频报警）\n7（其他报警）\n空值表示不订阅。\n支持多个，用英文逗号（,）分隔",
                  "example": "0",
                  "type": "string"
                },
                "AutoDirectory": {
                  "description_en": "Indicates whether directory reporting is enabled for the platform device",
                  "description_zh": "是否启用平台设备的目录上报",
                  "example": "true",
                  "type": "boolean"
                },
                "AutoPos": {
                  "description_en": "Indicates whether to enable position subscription for the device",
                  "description_zh": "是否启用设备位置订阅",
                  "example": "false",
                  "type": "boolean"
                },
                "AutoStart": {
                  "description_en": "Indicates whether to automatically start the stream",
                  "description_zh": "是否自动启动流",
                  "example": "false",
                  "type": "boolean"
                },
                "ChannelSyncTime": {
                  "description_en": "The time when the channels were synchronized",
                  "description_zh": "通道同步时间",
                  "example": "2019-02-28T17:01:17Z",
                  "type": "string"
                },
