                    "CreatedTime": {
                      "description_en": "The time when the directory was created",
                      "description_zh": "目录创建时间",
                      "example": "2019-02-28T17:00:17Z",
                      "type": "string"
                    },
                    "Description": {
                      "description_en": "The description of the directory",
                      "description_zh": "目录描述",
                      "example": "目录1",
                      "type": "string"
                    },
                    "GroupId": {
                      "description_en": "The ID of the group to which the directory belongs",
                      "description_zh": "目录所属空间ID",
