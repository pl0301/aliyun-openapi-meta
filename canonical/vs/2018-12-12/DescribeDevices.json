                  "description_en": "The time when the device was created",
                  "description_zh": "设备创建时间",
                  "example": "2019-02-28T17:00:17Z",
                  "type": "string"
                },
                "Description": {
                  "description_en": "The description of the device",
                  "description_zh": "设备描述",
                  "example": "xxx路口摄像头",
                  "type": "string"
                },
                "Directory": {
                  "description_en": "The directory information",
                  "description_zh": "目录信息",
