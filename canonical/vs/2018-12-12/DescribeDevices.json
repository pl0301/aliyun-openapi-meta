                  "type": "string"
                },
                "Type": {
                  "description_en": "The device type. Valid values:\n\nipc (camera)\n\nplatform\n\nied (intelligent edge device)",
                  "description_zh": "设备类型。取值范围：\nipc（摄像头）\nplatform（平台）\nied（智能设备）",
                  "example": "ipc",
                  "type": "string"
                },
                "Url": {
                  "description_en": "The stream URL on the device",
                  "description_zh": "设备上的流URL",
                  "example": "rtmp://xxx/xxx",
                  "type": "string"
                },
                "Username": {
                  "description_en": "The username for the device",
                  "description_zh": "设备用户名",
                  "example": "admin",
                  "type": "string"
                },
                "Vendor": {
                  "description_en": "The manufacturer of the device",
                  "description_zh": "设备厂商",
                  "example": "公司A",
                  "type": "string"
