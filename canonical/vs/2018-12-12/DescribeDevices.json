                      "type": "string"
                    },
                    "Id": {
                      "description_en": "The directory ID",
                      "description_zh": "目录ID",
                      "example": "399*****488-cn-qingdao",
                      "type": "string"
                    },
                    "Name": {
                      "description_en": "The name of the directory",
                      "description_zh": "目录名称",
                      "example": "目录1",
                      "type": "string"
                    },
                    "ParentId": {
                      "description_en": "The ID of the parent directory",
