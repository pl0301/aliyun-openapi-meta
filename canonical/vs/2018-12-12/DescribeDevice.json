          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "BEA5625F-8FCF-48F4-851B-CA63946DA664",
            "type": "string"
          },
          "Stats": {
            "description_en": "The stream statistics information of the device",
            "description_zh": "设备流统计信息",
            "properties": {
              "ChannelNum": {
                "description_en": "The number of channels",
                "description_zh": "通道数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "FailedNum": {
                "description_en": "The number of failed streams",
                "description_zh": "失败流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
              },
              "OfflineNum": {
                "description_en": "The number of offline streams",
                "description_zh": "离线流数量",
                "example": "1",
                "format": "int64",
                "type": "integer"
