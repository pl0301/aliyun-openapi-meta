                },
                "SyncScope": {
                  "description_en": "The synchronization scope. Valid values:\n\n`INSTANCE`: Synchronizes based on namespace regex and repository regex rules.\n\n`NAMESPACE`: Synchronizes based on namespace.\n\n`REPO`: Synchronizes based on image repository",
