              "PRIVATE",
              "PUBLIC"
            ],
            "enumValueTitles": {
              "PRIVATE": "私有仓库",
              "PUBLIC": "公开仓库"
            },
            "example": "PRIVATE",
            "required": true,
            "type": "string"
          },
          "TagImmutability": {
            "description_en": "Specifies whether image version immutability is enabled. If enabled, you cannot overwrite image versions except for the latest image version",
