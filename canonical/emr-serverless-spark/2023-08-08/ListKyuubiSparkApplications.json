                  "description_zh": "任务开始的时间",
                  "example": "2025-02-12 19:59:16",
                  "type": "string"
                },
                "state": {
                  "description_en": "The status of the Spark application.\n\nSTARTING: The application is starting.\n\nRUNNING: The application is running.\n\nTERMINATED: The application is terminated",
                  "description_zh": "Spark应用状态。\nSTARTING：启动中。\nRUNNING：运行中。\nTERMINATED：已终止",
