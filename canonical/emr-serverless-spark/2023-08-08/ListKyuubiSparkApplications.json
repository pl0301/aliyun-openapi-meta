                  "type": "string"
                },
                "cuHours": {
                  "description_en": "The number of CUs consumed during the task lifecycle. This is an estimated value. The final amount is subject to your bill",
                  "description_zh": "任务运行周期内所消耗的 CU 数量（该值为预估值，最终以账单为准）",
                  "example": "0.238302",
                  "format": "double",
                  "type": "number"
                },
                "endTime": {
                  "description_en": "The time when the task ended",
                  "description_zh": "任务结束的时间",
                  "example": "2025-02-12 20:02:02",
                  "type": "string"
                },
                "exitReason": {
                  "description_en": "The exit code",
                  "description_zh": "",
                  "example": "Exit Code: 137, Exit Reason: OOMKilled",
                  "type": "string"
                },
                "kyuubiServiceId": {
                  "example": "kb-2b93ec*******c9440c",
                  "type": "string"
                },
                "latestSqlStatementStatus": {
                  "description_en": "The status of the last task execution in the session",
                  "description_zh": "",
                  "example": "SUCCESS",
                  "type": "string"
                },
                "mbSeconds": {
                  "description_en": "The total memory allocated to the task in MB, multiplied by the number of seconds the task ran",
                  "description_zh": "任务已分配的内存总量乘以任务已运行的秒数",
                  "example": "3513900",
                  "format": "int64",
                  "type": "integer"
                },
                "priority": {
                  "example": "5",
                  "type": "string"
                },
                "resourceQueueId": {
                  "description_en": "The name of the resource queue where the Spark task runs",
