{
  "backend_timeout_ms": 3000,
  "camel_example": "aliyun dlfnext GET /dlf/v1/clg-paimon-xxx/databases/{database}/tables/{table}/snapshot --region cn-hangzhou --header \"Content-Type=application/json\" --version 2025-03-10 --force",
  "cmd_full_name": "dlfnext get-table-snapshot",
  "cmd_name": "get-table-snapshot",
  "components": {
    "schemas": {
      "Snapshot": {
        "description_en": "The snapshot details",
        "description_zh": "快照详情",
        "properties": {
          "baseManifestList": {
            "description_en": "The name of the base manifest list file",
            "description_zh": "基础 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-2",
            "type": "string"
          },
          "changelogManifestList": {
            "description_en": "The name of the manifest list file that records all changelogs generated for the snapshot",
            "description_zh": "记录该快照生成的全部变更日志的 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-4",
            "title": "本次提交产生的变更日志",
            "type": "string"
          },
          "changelogRecordCount": {
            "description_en": "The number of changelog records generated for the snapshot",
            "description_zh": "该快照生成的变更日志记录数",
            "example": "100",
            "format": "int64",
            "type": "integer"
          },
          "commitIdentifier": {
            "description_en": "The transaction ID for streaming writes",
            "description_zh": "流式写入的事务 ID",
            "example": "9223372036854775807",
            "format": "int64",
            "type": "integer"
          },
          "commitKind": {
            "description_en": "The streaming write type. Valid values: APPEND, COMPACT, OVERWRITE, and ANALYZE",
            "description_zh": "流式写入类型。取值：APPEND、COMPACT、OVERWRITE、ANALYZE",
            "enum": [
              "APPEND",
              "COMPACT",
              "OVERWRITE",
              "ANALYZE"
            ],
            "example": "COMPACT",
            "title": "提交类型：APPEND,COMPACT,OVERWRITE,ANALYZE",
            "type": "string"
          },
          "commitUser": {
            "description_en": "The user who made the commit, typically a UUID used to resume streaming writes",
            "description_zh": "提交用户，通常为 UUID，用于恢复流式写入",
            "example": "446aac61-bd5c-4fa0-8b14-846fa8810651",
            "type": "string"
          },
          "deltaManifestList": {
            "description_en": "The name of the manifest list file that records all new changes in the snapshot",
            "description_zh": "记录该快照全部新增变更的 Manifest 列表文件名",
            "example": "manifest-list-0c6fcaa1-b6bc-413d-9634-6471cce4f37e-3",
            "title": "记录本次提交新增的文件",
            "type": "string"
          },
          "deltaRecordCount": {
            "description_en": "The number of new records added in the snapshot",
            "description_zh": "该快照新增变更的记录数",
            "example": "10",
            "format": "int64",
            "title": "本次提交新增记录行数",
            "type": "integer"
          },
          "id": {
            "description_en": "The snapshot ID",
            "description_zh": "快照 ID",
            "example": "6",
            "format": "int64",
            "title": "快照ID",
            "type": "integer"
          },
          "idString": {
            "description_en": "",
            "description_zh": "",
            "type": "string"
          },
          "indexManifest": {
            "description_en": "The name of the manifest file that records all index files of the table",
            "description_zh": "记录该表全部索引文件的 Manifest 文件名",
            "example": "index-manifest-7cbdaa47-9578-43ac-ae6e-a7ec0486bba8-0",
            "type": "string"
          },
          "logOffsets": {
            "additionalProperties": {
              "description_en": "",
              "description_zh": "",
              "format": "int64",
              "type": "integer"
            },
            "description_en": "The log offsets at the time of the commit",
            "description_zh": "本次提交时的日志偏移量",
            "type": "object"
          },
          "parentIdString": {
            "description_en": "",
            "description_zh": "",
            "type": "string"
          },
          "schemaId": {
            "description_en": "The schema ID of the table when the snapshot was generated",
            "description_zh": "生成该快照时的表 Schema ID",
            "example": "0",
            "format": "int64",
            "title": "schema id",
            "type": "integer"
          },
          "sequenceNumber": {
            "description_en": "",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "statistics": {
            "description_en": "The name of the table statistics information file",
            "description_zh": "表统计信息文件名",
            "type": "string"
          },
          "summary": {
            "additionalProperties": {
              "description_en": "",
              "description_zh": "",
              "type": "string"
            },
            "description_en": "",
            "description_zh": "",
            "type": "object"
          },
          "timeMillis": {
            "description_en": "The commit time as a UNIX timestamp in milliseconds",
            "description_zh": "提交时间，Unix 时间戳，单位为毫秒",
            "example": "1741701564261",
            "format": "int64",
            "title": "提交时间",
            "type": "integer"
          },
          "totalRecordCount": {
            "description_en": "The total number of records across all changes in the snapshot",
            "description_zh": "该快照全部变更的总记录数",
            "example": "1024",
            "format": "int64",
            "title": "表总行数",
            "type": "integer"
          },
          "version": {
            "description_en": "The format version of the snapshot file. The current version is 3",
            "description_zh": "快照文件格式版本。当前版本为 3",
            "example": "3",
            "format": "int32",
            "type": "integer"
          },
          "watermark": {
            "description_en": "The watermark value",
            "description_zh": "水位线值",
            "example": "-9223372036854775808",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      },
      "TableSnapshot": {
        "description_en": "Contains metadata for a table snapshot",
        "description_zh": "",
        "properties": {
          "fileCount": {
            "description_en": "The total number of files in the snapshot",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "fileSizeInBytes": {
            "description_en": "The total size of all files in the snapshot, in bytes",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "lastFileCreationTime": {
            "description_en": "The creation time of the most recent file in the snapshot, as a Unix timestamp in milliseconds",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "partitionCount": {
            "description_en": "The total number of partitions in the table",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "recordCount": {
            "description_en": "The total number of records in the snapshot",
            "description_zh": "",
            "format": "int64",
            "type": "integer"
          },
          "snapshot": {
            "$ref": "#/components/schemas/Snapshot",
            "description_en": "Contains detailed information about the snapshot",
            "description_zh": ""
          },
          "totalBuckets": {
            "description_en": "The total number of buckets in the table",
            "description_zh": "",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  "deprecated": false,
