  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response object",
        "description_zh": "Schema of Response",
        "properties": {
          "CommonName": {
            "description_en": "The common name of the certificate",
            "description_zh": "证书通用名称",
            "example": "www.example.com ",
            "type": "string"
          },
          "FingerprintSha256": {
            "description_en": "The SHA-256 fingerprint of the certificate",
            "description_zh": "证书Sha256指纹",
            "example": "1dc5fc9af4eead2570c70d94b416130baeb6d4429b51fd3557379588456aca66",
            "type": "string"
          },
          "Id": {
            "description_en": "The certificate ID",
            "description_zh": "证书ID",
            "example": "babaabcd****",
            "type": "string"
          },
          "Issuer": {
            "description_en": "The issuer of the certificate",
            "description_zh": "证书颁发机构",
            "example": "GlobalSign nv-sa",
            "type": "string"
          },
          "NotAfter": {
            "description_en": "The validity end time of the certificate",
            "description_zh": "证书有效期截止时间",
            "example": "2024-12-01T02:13:07Z",
            "type": "string"
          },
          "NotBefore": {
            "description_en": "The validity start time of the certificate",
            "description_zh": "证书有效期开始时间",
            "example": "2023-12-01T02:13:07Z",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "EEEBE525-F576-1196-8DAF-2D70CA3F4D2F\n",
            "type": "string"
          },
          "SerialNumber": {
            "description_en": "The serial number of the certificate",
            "description_zh": "证书序列号",
            "example": "babaded901474b9693acf530e0fb1daa",
            "type": "string"
          },
          "SignatureAlgorithm": {
            "description_en": "The signature algorithm of the certificate",
            "description_zh": "证书签名算法",
            "example": "SHA256-RSA",
            "type": "string"
          },
          "Status": {
            "description_en": "The certificate status",
            "description_zh": "证书状态",
            "example": "OK",
            "type": "string"
          },
          "ValidityDays": {
            "description_en": "The validity period of the certificate in days",
            "description_zh": "证书有效天数",
            "example": "365",
            "type": "string"
          }
        },
        "title_en": "Schema of Response",
        "title_zh": "Schema of Response",
        "type": "object"
      }
