{
  "camel_example": "",
  "cmd_full_name": "hcs-mgw list-agent",
  "cmd_name": "list-agent",
  "components": {
    "schemas": {
      "GetAgentResp": {
        "description_en": "The queried agent",
        "description_zh": "获取代理详情",
        "properties": {
          "ActivationKey": {
            "description_en": "The security code of the agent",
            "description_zh": "代理安全码",
            "example": "6af62558-970d-4f44-8663-4e297170fd6a",
            "title": "代理安全码。",
            "type": "string"
          },
          "AgentEndpoint": {
            "description_en": "The method that is used to access the agent",
            "description_zh": "代理访问方式",
            "example": "vpc",
            "title": "代理访问方式。",
            "type": "string"
          },
          "CreateTime": {
            "description_en": "The time when the agent was created",
            "description_zh": "创建时间",
            "example": "2024-05-01T12:00:00.000Z",
            "title": "创建时间",
            "type": "string"
          },
          "DeployMethod": {
            "description_en": "The deployment mode of the agent",
            "description_zh": "代理部署方式",
            "example": "default",
            "title": "代理部署方式。",
            "type": "string"
          },
          "ModifyTime": {
            "description_en": "The time when the agent was last modified",
            "description_zh": "修改时间",
            "example": "2024-05-01T12:00:00.000Z",
            "title": "修改时间",
            "type": "string"
          },
          "Name": {
            "description_en": "The agent name",
            "description_zh": "代理名称",
            "example": "test_name",
            "title": "代理名称。",
            "type": "string"
          },
          "Owner": {
            "description_en": "The agent owner",
            "description_zh": "代理拥有者",
            "example": "test_owner",
            "title": "代理拥有者。",
            "type": "string"
          },
          "Tags": {
            "description_en": "The tags",
            "description_zh": "标记",
            "example": "K1:V1,K2:V2",
            "title": "标记。",
            "type": "string"
          },
          "TunnelId": {
            "description_en": "The tunnel ID",
            "description_zh": "通道ID",
            "example": "test_tunnel_id",
            "title": "通道ID。",
            "type": "string"
          },
          "Version": {
            "description_en": "The agent ID",
            "description_zh": "代理ID",
            "example": "test_agent_id",
            "title": "代理ID。",
            "type": "string"
          }
        },
        "title": "获取代理详情。",
        "type": "object"
      },
      "ListAgentResp": {
        "description_en": "The queried agents",
        "description_zh": "代理列表详情",
        "properties": {
          "ImportAgent": {
            "description_en": "The agents",
            "description_zh": "代理列表",
            "items": {
              "$ref": "#/components/schemas/GetAgentResp",
              "description_en": "The agent",
              "description_zh": "代理详情"
            },
            "title": "代理列表。",
            "type": "array"
          },
          "NextMarker": {
            "description_en": "The position from which the next list operation starts",
            "description_zh": "下次列举代理的起点",
            "example": "test_next_marker",
            "title": "下次列举代理的起点。",
            "type": "string"
          },
          "Truncated": {
            "description_en": "Indicates whether the queried results are truncated",
            "description_zh": "是否截断",
            "example": "true",
            "title": "是否截断。",
            "type": "boolean"
          }
        },
        "title": "代理列表详情。",
        "type": "object"
      }
    }
  },
  "deprecated": false,
  "description_en": "Lists the agents created by a user in the specific region",
  "description_zh": "列举用户在该区域下的代理",
  "kebab_example": "aliyun hcs-mgw list-agent --marker test_agent --count 100 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListAgent",
  "operation": {
    "action": "ListAgent",
    "api_style": "ROA",
    "api_version": "2024-06-26",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/agentlist"
  },
  "parameters": [
    {
      "example": "test_agent",
      "help_en": "The marker after which the agents are listed.\\\nBy default, this parameter is left empty",
      "help_zh": "设定从该marker之后列举代理。  \n默认值：无",
      "location": "query",
      "name": "marker",
      "options": [
        "--marker"
      ],
      "raw_name": "marker",
      "required": false,
      "type": "string"
    },
    {
      "example": "100",
      "help_en": "Specifies the number of agents to be returned.\\\nValid values: 0 - 1000.\\\nDefault value: 1000",
      "help_zh": "指定返回代理的数量。  \n取值：大于0小于等于1000  \n默认值：1000",
      "location": "query",
      "name": "count",
      "options": [
        "--count"
      ],
      "raw_name": "count",
      "required": false,
      "type": "int"
    }
  ],
  "pathPattern": "/agentlist",
  "product_code": "hcs-mgw",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response body",
        "description_zh": "列举代理的响应体",
        "properties": {
          "ImportAgentList": {
            "$ref": "#/components/schemas/ListAgentResp",
            "description_en": "The details of the agents",
            "description_zh": "代理列表详情"
          }
        },
        "type": "object"
      }
    }
  }
}
