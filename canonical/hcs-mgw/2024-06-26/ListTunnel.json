        "description_zh": "通道限流",
        "properties": {
          "MaxBandwidth": {
            "description_en": "The maximum bandwidth of the tunnel. Unit: byte/s.\\\nValid values: values greater than or equal to 10485760. Default value: 0. The default value indicates that the bandwidth of the tunnel is not limited",
            "description_zh": "通道的带宽限流，单位 Byte/s。   \n取值：不低于10485760 （10MBps) ，默认值是0，表示不受限制",
            "example": "1073741824",
            "format": "int64",
            "title": "通道的带宽限流，单位 Byte/s。 取值：不低于10485760 （10MBps) 。默认值是0，表示不受限制。",
            "type": "integer"
          },
          "MaxQps": {
            "description_en": "The maximum queries per second (QPS) of the tunnel.\\\nValid values: values greater than or equal to 0. Default value: 0. The default value indicates that the QPS of the tunnel is not limited",
