  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Items": {
            "description_en": "",
            "description_zh": "",
            "itemNode": true,
            "properties": {
              "TaskProgressInfo": {
                "description_en": "The task progress information",
                "description_zh": "任务执行信息列表",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "properties": {
                    "BeginTime": {
                      "description_en": "The start time of the task. The time is in the <i>yyyy-MM-dd</i>T<i>HH:mm</i>Z format (UTC)",
                      "description_zh": "任务开始时间。格式为<i>yyyy-MM-dd</i>T<i>HH:mm</i>Z（UTC时间）",
                      "example": "2020-11-20T01:00Z",
                      "type": "string"
                    },
                    "CurrentStepName": {
                      "description_en": "The name of the current substep",
                      "description_zh": "当前的子步骤名称",
                      "example": "create_instance",
                      "type": "string"
                    },
                    "DBName": {
                      "description_en": "The database name. This parameter is returned when the task involves a database",
                      "description_zh": "当任务涉及库时，显示库名",
                      "example": "DBtest",
                      "type": "string"
                    },
                    "ExpectedFinishTime": {
                      "description_en": "The expected end time.\nThis parameter is empty unless there are special circumstances",
                      "description_zh": "预计结束时间。\n若无特殊情况，该参数为空",
                      "example": "null",
                      "type": "string"
                    },
                    "FinishTime": {
                      "description_en": "The end time of the task. The time is in the <i>yyyy-MM-dd</i>T<i>HH:mm</i>Z format (UTC)",
                      "description_zh": "任务结束时间。格式为<i>yyyy-MM-dd</i>T<i>HH:mm</i>Z（UTC时间）",
                      "example": "2020-11-20T02:00Z",
                      "type": "string"
                    },
                    "Progress": {
                      "description_en": "The progress of the task in percentage",
                      "description_zh": "任务进度百分比",
                      "example": "100",
                      "type": "string"
                    },
                    "ProgressInfo": {
                      "description_en": "The description of the task progress.\nThis parameter is empty if the task has no progress description",
                      "description_zh": "任务进度的描述信息。\n若目标任务无进度描述信息，该参数为空",
                      "example": "null",
                      "type": "string"
                    },
                    "Remain": {
                      "description_en": "The estimated remaining time of the task. Unit: seconds.\nIf the task is not running, this parameter is not returned or the returned value is 0",
                      "description_zh": "任务预计剩余时间。单位：秒。\n如果任务不处于执行中则不返回本参数或返回的值为0",
                      "example": "60",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Status": {
                      "description_en": "The task status",
                      "description_zh": "任务状态",
                      "example": "2",
                      "type": "string"
                    },
                    "StepProgressInfo": {
                      "description_en": "The substep progress of the task. For example, `1/4` indicates that the task contains four substeps and the first substep is being executed",
                      "description_zh": "任务的子步骤进度。例如`1/4`表示该任务共包含4个子步骤，当前正在执行第一步",
                      "example": "1/4",
                      "type": "string"
                    },
                    "StepsInfo": {
                      "description_en": "The details of the substeps",
                      "description_zh": "任务子步骤详情",
                      "example": "null",
                      "type": "string"
                    },
                    "TaskAction": {
                      "description_en": "The API operation used by the task, such as CreateDBInstance",
                      "description_zh": "任务使用的API接口，例如CreateDBInstance",
                      "example": "CreateDBInstance",
                      "type": "string"
                    },
                    "TaskErrorCode": {
                      "description_en": "The error code returned when the task fails.\nThis parameter is returned only when the task fails",
                      "description_zh": "任务出错时的错误码。\n仅在任务出错时返回",
                      "example": "null",
                      "type": "string"
                    },
                    "TaskErrorMessage": {
                      "description_en": "The error message returned when the task fails.\nThis parameter is returned only when the task fails",
                      "description_zh": "任务出错时的错误信息。\n仅在任务出错时返回",
                      "example": "null",
                      "type": "string"
                    },
                    "TaskId": {
                      "description_en": "The task ID",
                      "description_zh": "任务ID",
                      "example": "3472xxxxx",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "PageNumber": {
            "description_en": "The page number",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageRecordCount": {
            "description_en": "The number of entries on the current page",
            "description_zh": "本页记录个数",
            "example": "30",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "A103039D-B1B2-4C57-B989-7D7C0DA95426",
            "type": "string"
          },
          "TotalRecordCount": {
            "description_en": "The total number of entries",
            "description_zh": "总记录数",
            "example": "40",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
