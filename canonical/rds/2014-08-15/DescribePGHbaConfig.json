                    },
                    "Database": {
                      "description_zh": "数据库名",
                      "example": "all",
                      "type": "string"
                    },
                    "Mask": {
                      "description_zh": "掩码",
                      "example": "null",
                      "type": "string"
                    },
                    "Method": {
                      "description_zh": "认证方式",
                      "example": "md5",
                      "type": "string"
