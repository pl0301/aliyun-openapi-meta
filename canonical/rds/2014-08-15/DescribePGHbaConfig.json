                    "Type": {
                      "description_zh": "连接类型，返回值如下：\n\nhost：该条记录验证TCP/IP连接，包括SSL连接和非SSL连接。\nhostssl：该条记录只验证通过SSL建立的TCP/IP连接。\nhostnossl：该条记录只验证通过非SSL建立的TCP/IP连接",
                      "example": "host",
                      "type": "string"
                    },
                    "User": {
                      "description_zh": "用户名",
                      "example": "all",
                      "type": "string"
                    }
