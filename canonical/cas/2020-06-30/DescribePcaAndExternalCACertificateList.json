      "options": [
        "--identifiers"
      ],
      "raw_name": "Identifiers",
      "required": false,
      "type": "string"
    },
    {
      "example": "test_name",
      "help_en": "The keyword for a fuzzy search on the name, domain name, and SAN fields",
      "help_zh": "查询关键字。支持通过名称、域名、SANS模糊查询",
      "location": "query",
      "name": "key_word",
