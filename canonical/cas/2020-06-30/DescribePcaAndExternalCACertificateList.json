  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "CertificateList": {
            "description_en": "The list of certificates",
            "description_zh": "证书显示列表",
            "items": {
              "description_en": "The details of the certificate",
              "description_zh": "证书显示列表",
              "properties": {
                "AfterDate": {
                  "description_en": "The expiration time of the certificate",
                  "description_zh": "证书到期时间",
                  "example": "2022-08-23T16:15Z",
                  "format": "int64",
                  "type": "integer"
                },
                "Algorithm": {
                  "description_en": "The algorithm of the certificate",
                  "description_zh": "证书id",
                  "example": "RSA",
                  "type": "string"
                },
                "BeforeDate": {
                  "description_en": "The time at which the certificate is issued",
                  "description_zh": "证书签发时间",
                  "example": "2021-01-01T00:00Z",
                  "format": "int64",
                  "type": "integer"
                },
                "CertificateType": {
                  "description_en": "The type of the certificate",
                  "description_zh": "证书类型",
                  "example": "SUB_ROOT",
                  "type": "string"
                },
                "CommonName": {
                  "description_en": "The primary domain name that is bound to the certificate",
                  "description_zh": "证书绑定的主域名",
                  "example": "aliyun.com",
                  "type": "string"
                },
                "CountryCode": {
                  "description_en": "The country code of the certificate",
                  "description_zh": "证书国家标准编码",
                  "example": "CN",
                  "type": "string"
                },
                "Identifier": {
                  "description_en": "The ID of the certificate",
                  "description_zh": "证书id",
                  "example": "05e148d8d3ecc9976d9ecd2b2f25****",
                  "type": "string"
                },
                "KeySize": {
                  "description_en": "The key size of the certificate. Unit: bits",
                  "description_zh": "证书key的大小，单位gb",
                  "example": "2048",
                  "format": "int32",
                  "type": "integer"
                },
                "Locality": {
                  "description_en": "The city in which the organization is located",
                  "description_zh": "证书绑定的主域名",
                  "example": "Hangzhou",
                  "type": "string"
                },
                "Md5": {
                  "description_en": "The MD5 value of the certificate",
                  "description_zh": "证书绑定的md5值",
                  "example": "05e148d8d3ecc9976d9ecd2b2f25****",
                  "type": "string"
                },
                "Organization": {
                  "description_en": "The organization to which the certificate belongs",
                  "description_zh": "证书组织",
                  "example": "阿里云计算有限公司",
                  "type": "string"
                },
                "OrganizationUnit": {
                  "description_en": "The certificate authority (CA) that issued the certificate",
                  "description_zh": "证书颁发机构",
                  "example": "Security",
                  "type": "string"
                },
                "ParentIdentifier": {
                  "description_en": "The ID of the parent certificate",
                  "description_zh": "父证书id",
                  "example": "1a83bcbb89e562885e40aa0108f5****",
                  "type": "string"
                },
                "Sans": {
                  "description_en": "All domain names that are bound to the certificate",
                  "description_zh": "证书绑定的所有域名",
                  "example": "[ {\"Type\": 7, \"Value\": \"192.0.XX.XX\"}, {\"Type\": 2, \"Value\": \"www.aliyundoc.com\"}, ]",
                  "type": "string"
                },
                "SerialNumber": {
                  "description_en": "The serial number of the certificate",
                  "description_zh": "证书序列号",
                  "example": "62b2b943a32d96883a6650e672ea0276****",
                  "type": "string"
                },
                "Sha2": {
                  "description_en": "The primary domain name that is bound to the certificate",
                  "description_zh": "证书绑定的主域名",
                  "example": "14dcc8afc7578e1fcec36d658f7e20de18f6957bbac42b373a66bc9de4e9****",
                  "type": "string"
                },
                "SignAlgorithm": {
                  "description_en": "The signature algorithm of the certificate. Valid values:",
                  "description_zh": "证书签名算法，取值：-prefix：前缀验证。-match：完全匹配。-any：全部匹配",
                  "example": "SHA256WITHRSA",
                  "type": "string"
                },
                "State": {
                  "description_en": "The status of the certificate. Valid values:",
                  "description_zh": "证书状态。-success：已生效-checking：检测域名是否在阿里云全站加速-cname_error：域名没有切到阿里云全球加速实例-domain_invalid：域名包含非法字符-unsupport_wildcard：不支持泛域名",
                  "example": "Zhejiang",
                  "type": "string"
                },
                "Status": {
                  "description_en": "The status of the certificate. Valid values:",
                  "description_zh": "证书状态。取值：-payed：已付款-checking：审核中-issued：已签发-revoked：已吊销-checked_fail：审核失败",
                  "example": "ISSUE",
                  "type": "string"
                },
                "SubjectDN": {
                  "description_en": "The subject of the certificate",
                  "description_zh": "证书主体（拥有者），采用dn标识",
                  "example": "C=CN,O=阿里云计算有限公司,OU=Security,L=Hangzhou,ST=Zhejiang,CN=Aliyun",
                  "type": "string"
                },
                "X509Certificate": {
                  "description_en": "The content of the X.509 certificate",
                  "description_zh": "x09证书",
                  "example": "-----BEGIN CERTIFICATE----- …… -----END CERTIFICATE-----",
                  "type": "string"
                },
                "Years": {
                  "description_en": "The validity period of the certificate, in years",
                  "description_zh": "证书购买年限",
                  "example": "3",
                  "format": "int32",
                  "type": "integer"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "CurrentPage": {
            "description_en": "The current page number",
            "description_zh": "当前页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageCount": {
            "description_en": "The number of entries on the current page",
            "description_zh": "列表条目数",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "结果的请求id",
            "example": "CBF1E9B7-D6A0-4E9E-AD3E-2B47E6C2837D",
            "type": "string"
          },
          "ShowSize": {
            "description_en": "The number of entries to return on each page. Default value: 50",
            "description_zh": "指定每页显示多少条记录。默认值为50",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "TotalCount": {
            "description_en": "The total number of entries",
            "description_zh": "总记录数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
