        "properties": {
          "Handshakes": {
            "itemNode": true,
            "properties": {
              "Handshake": {
                "description_en": "The information of the invitations",
                "description_zh": "邀请信息",
                "items": {
                  "description_en": "The information of an invitation",
                  "description_zh": "邀请信息",
                  "properties": {
                    "CreateTime": {
                      "description_en": "The time when the invitation was created. The time is displayed in UTC",
                      "description_zh": "邀请的创建时间（UTC时间）",
                      "example": "2018-08-10T09:55:41Z",
                      "type": "string"
                    },
                    "ExpireTime": {
                      "description_en": "The time when the invitation expires. The time is displayed in UTC",
                      "description_zh": "邀请的过期时间（UTC时间）",
                      "example": "2018-08-24T09:55:41Z",
                      "type": "string"
                    },
                    "HandshakeId": {
                      "description_en": "The ID of the invitation",
                      "description_zh": "邀请ID",
                      "example": "h-ycm4rp****",
                      "type": "string"
                    },
                    "MasterAccountId": {
                      "description_en": "The ID of the management account of the resource directory",
                      "description_zh": "资源目录管理账号ID",
                      "example": "172841235500****",
                      "type": "string"
                    },
                    "MasterAccountName": {
                      "description_en": "The name of the management account of the resource directory",
                      "description_zh": "资源目录管理账号名称",
                      "example": "Alice",
                      "type": "string"
                    },
                    "ModifyTime": {
                      "description_en": "The time when the invitation was modified. The time is displayed in UTC",
                      "description_zh": "邀请的修改时间（UTC时间）",
                      "example": "2018-08-10T09:55:41Z",
                      "type": "string"
                    },
                    "Note": {
                      "description_en": "The description of the invitation",
                      "description_zh": "备注",
                      "example": "欢迎您加入",
                      "type": "string"
                    },
                    "ResourceDirectoryId": {
                      "description_en": "The ID of the resource directory",
                      "description_zh": "资源目录ID",
                      "example": "rd-abcdef****",
                      "type": "string"
                    },
                    "Status": {
                      "description_en": "The status of the invitation. Valid values:\n\nPending: The invitation is waiting for confirmation.\nAccepted: The invitation is accepted.\nCancelled: The invitation is canceled.\nDeclined: The invitation is rejected.\nExpired: The invitation expires",
                      "description_zh": "邀请状态。\n\nPending：等待确认。\nAccepted：已接受。\nCancelled：已取消。\nDeclined：已拒绝。\nExpired：超时",
                      "example": "Pending",
                      "type": "string"
                    },
                    "TargetEntity": {
                      "description_en": "The ID or logon email address of the invited account",
                      "description_zh": "被邀请账号ID或登录邮箱",
                      "example": "someone@example.com",
                      "type": "string"
                    },
                    "TargetType": {
                      "description_en": "The type of the invited account. Valid values:\n\nAccount: indicates the ID of the account.\nEmail: indicates the logon email address of the account",
                      "description_zh": "被邀请账号类型。\n\nAccount：账号ID。\nEmail：账号登录邮箱",
                      "example": "Email",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "PageNumber": {
            "description_en": "The page number of the returned page",
            "description_zh": "页码",
            "example": "1",
            "format": "int32",
            "type": "integer"
          },
          "PageSize": {
            "description_en": "The number of entries returned per page",
            "description_zh": "分页时每页显示的数据行数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "9B34724D-54B0-4A51-B34D-4512372FE1BE",
            "type": "string"
          },
          "TotalCount": {
            "description_en": "The total number of entries returned",
            "description_zh": "数据总条数",
            "example": "2",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
