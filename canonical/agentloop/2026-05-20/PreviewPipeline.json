  "cmd_name": "preview-pipeline",
  "deprecated": false,
  "description_en": "Previews a pipeline. Without creating pipeline resources, performs a trial query based on the specified data source, node orchestration, and time range, and returns a small number of sample data records for authenticating parameter settings and previewing processing results",
  "description_zh": "预览流水线。在不创建流水线资源的前提下，基于给定的数据源、节点编排和时间范围试运行查询，返回少量样本数据，用于验证参数配置和预览处理效果",
  "kebab_example": "aliyun agentloop preview-pipeline --agent-space my-agent-space --source '{\"type\":\"SLS\",\"logstore\":{\"query\":\"0_SELECT_0\",\"project\":\"my-sls-project\",\"logstore\":\"my-sls-logstore\"}}' --pipeline '{\"nodes\":[{\"id\":\"node-1\",\"type\":\"transform\",\"parameters\":{\"key\":\"example-string\"}}]}' --from-time 1735660800 --to-time 1735747200 --region cn-hangzhou",
  "method": "POST",
  "multi_version": false,
