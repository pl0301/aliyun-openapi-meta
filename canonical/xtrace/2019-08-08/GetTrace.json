{
  "camel_example": "",
  "cmd_full_name": "xtrace get-trace",
  "cmd_name": "get-trace",
  "deprecated": false,
  "description_en": "You can invoke the GetTrace API to obtain trace details",
  "description_zh": "调用GetTrace接口获取调用链路详情",
  "kebab_example": "aliyun xtrace get-trace --trace-id 1c6881aab84191a4000000 --app-type XTRACE --biz-region-id cn-hangzhou --page-number 1 --page-size 5 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetTrace",
  "operation": {
    "action": "GetTrace",
    "api_style": "RPC",
    "api_version": "2019-08-08",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "1c6881aab84191a4******",
      "help_en": "The trace ID, which is the unique identifier of the trace.\n\nYou can obtain the trace ID on the Trace Explorer page in the Managed Service for OpenTelemetry console or by calling the [SearchTraces](~~2399674~~~) operation",
      "help_zh": "调用链ID，链路请求的唯一标识。\n\n可在控制台的调用链分析页面获取，也可通过SearchTraces API获取",
      "location": "query",
      "name": "trace_id",
      "options": [
        "--trace-id"
      ],
      "raw_name": "TraceID",
      "required": true,
      "type": "string"
    },
    {
      "example": "XTRACE",
      "help_en": "The type of the application. You can leave this parameter empty or set the value to `XTRACE`. We recommend that you leave it empty.\n\nEmpty value: queries traces reported from Managed Service for Prometheus and Application Real-Time Monitoring Service (ARMS).\n`XTRACE`: queries only traces reported from Managed Service for Prometheus",
      "help_zh": "应用类型，取值为空或`XTRACE`，推荐设置为空。\n\n空：查询XTRACE和ARMS调用链。\n\n`XTRACE`：只查询XTRACE调用链",
      "location": "query",
      "name": "app_type",
      "options": [
        "--app-type"
      ],
      "raw_name": "AppType",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "cn-beijing",
      "help_en": "The ID of the region",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": true,
      "type": "string"
    },
    {
      "example": "1",
      "help_en": "The page number",
      "help_zh": "查询分页的页码",
      "location": "query",
      "name": "page_number",
      "options": [
        "--page-number"
      ],
      "raw_name": "PageNumber",
      "required": false,
      "type": "int"
    },
    {
      "example": "5",
      "help_en": "The number of entries on each page. Maximum value: 100",
      "help_zh": "查询分页的每页项目数量，最大值为 100",
      "location": "query",
      "name": "page_size",
      "options": [
        "--page-size"
      ],
      "raw_name": "PageSize",
      "required": false,
      "type": "string"
    }
  ],
