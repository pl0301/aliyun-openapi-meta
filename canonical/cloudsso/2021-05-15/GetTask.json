  "pathPattern": "",
  "product_code": "cloudsso",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The response",
        "description_zh": "返回结果",
        "properties": {
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "923CA5E8-57BF-5E15-8BA6-E75A966B7E3F",
            "type": "string"
          },
          "Task": {
            "description_en": "The task information",
            "description_zh": "任务信息",
            "properties": {
              "AccessConfigurationId": {
                "description_en": "The access configuration ID",
                "description_zh": "访问配置ID",
                "example": "ac-00jhtfl8thteu6uj****",
                "type": "string"
              },
              "AccessConfigurationName": {
                "description_en": "The access configuration name",
                "description_zh": "访问配置名称",
                "example": "ECS-Admin",
                "type": "string"
              },
              "EndTime": {
                "description_en": "The time when the task ended",
                "description_zh": "任务结束时间。格式为 RFC 3339 的 UTC 时间（YYYY-MM-DDTHH:mm:ssZ）",
                "example": "2021-11-05T02:58:08Z",
                "type": "string"
              },
              "FailureReason": {
                "description_en": "The reason why the task failed.\n\nThis parameter is displayed only when Status is Failed",
                "description_zh": "任务失败原因。\n\n只有`Status`为`Failed`，才会显示该参数",
                "example": "No Permission.",
                "type": "string"
              },
              "OriginTargetId": {
                "description_en": "",
                "description_zh": "目标所属的云账号ID",
                "example": "17xxxxxxxxxxxx73",
                "title_en": "",
                "title_zh": "目标所属的云账号ID",
                "type": "string"
              },
              "PrincipalId": {
                "description_en": "The CloudSSO identity ID",
                "description_zh": "云SSO身份ID",
                "example": "u-00q8wbq42wiltcrk****",
                "type": "string"
              },
              "PrincipalName": {
                "description_en": "The CloudSSO identity name",
                "description_zh": "云SSO身份名称",
                "example": "Alice",
                "type": "string"
              },
              "PrincipalType": {
                "description_en": "The CloudSSO identity type. Valid values:\n\nUser: user.\nGroup: group",
                "description_zh": "云SSO身份类型。取值：\n\nUser：用户。\nGroup：用户组",
                "example": "User",
                "type": "string"
              },
              "StartTime": {
                "description_en": "The time when the task started",
                "description_zh": "任务开始时间。格式为 RFC 3339 的 UTC 时间（YYYY-MM-DDTHH:mm:ssZ）",
                "example": "2021-11-05T02:58:07Z",
                "type": "string"
              },
              "Status": {
                "description_en": "The task status. Valid values:\n\nInProgress: The task is in progress.\nSuccess: The task succeeded.\nFailed: The task failed",
                "description_zh": "任务状态。取值：\n\nInProgress：任务执行中。\nSuccess：任务执行成功。\nFailed：任务执行失败",
                "example": "Success",
                "type": "string"
              },
              "TargetId": {
                "description_en": "The task target ID",
                "description_zh": "任务目标ID",
                "example": "114240524784****",
                "type": "string"
              },
              "TargetName": {
                "description_en": "The task target name",
                "description_zh": "任务目标名称",
                "example": "dev-test",
                "type": "string"
              },
              "TargetPath": {
                "description_en": "The path ID of the task target in the resource directory",
                "description_zh": "任务目标在资源目录中的路径ID",
                "example": "rd-3G****/r-Wm****/114240524784****",
                "type": "string"
              },
              "TargetPathName": {
                "description_en": "The path name of the task target in the resource directory",
                "description_zh": "任务目标在资源目录中的路径名称",
                "example": "rd-3G****/root/dev-test",
                "type": "string"
              },
              "TargetType": {
                "description_en": "The task target type. Valid values: RD-Account, which indicates that the task target type is an account in a resource directory",
                "description_zh": "任务目标类型。取值：RD-Account，表示任务目标类型为RD账号",
                "example": "RD-Account",
                "type": "string"
              },
              "TaskId": {
                "description_en": "The task ID",
                "description_zh": "任务ID",
                "example": "t-shfqw1u1edszvxw5****",
                "type": "string"
              },
              "TaskType": {
                "description_en": "The task type. Valid values:\n\nProvisionAccessConfiguration: access configuration deployment.\nDeprovisionAccessConfiguration: removes an access configuration deployment.\nCreateAccessAssignment: grants authorization on an account in a resource directory.\nDeleteAccessAssignment: removes authorization from an account in a resource directory",
                "description_zh": "任务类型。取值：\n\nProvisionAccessConfiguration：部署访问配置。\nDeprovisionAccessConfiguration：解除访问配置部署。\nCreateAccessAssignment：在RD账号上授权。\nDeleteAccessAssignment：移除RD账号上的授权",
                "example": "DeleteAccessAssignment",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    }
  }
}
