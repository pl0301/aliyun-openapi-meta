  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "AppVersion": {
            "description_en": "The basic version information",
            "description_zh": "版本基本信息",
            "properties": {
              "Adapters": {
                "description_en": "The list of compatible device models for the application version",
                "description_zh": "应用版本的适配机型列表",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "properties": {
                    "DeviceModelId": {
                      "description_en": "The ID of the compatible device model",
                      "description_zh": "适配的设备型号ID",
                      "example": "123",
                      "type": "string"
                    },
                    "DeviceModelName": {
                      "description_en": "The device model name",
                      "description_zh": "机型名",
                      "example": "DM1",
                      "type": "string"
                    },
                    "Id": {
                      "description_en": "The ID of the upgrade package",
                      "description_zh": "升级包的ID",
                      "example": "1234",
                      "format": "int64",
                      "type": "integer"
                    },
                    "MaxOsVersion": {
                      "description_en": "The maximum allowed system version number",
                      "description_zh": "最高允许的系统版本号",
                      "example": "2.0.1-R-20180412.0923",
                      "type": "string"
                    },
                    "MinOsVersion": {
                      "description_en": "The minimum allowed system version number",
                      "description_zh": "最低允许的系统版本号",
                      "example": "3.0.1-R-20180412.0923",
                      "type": "string"
                    },
                    "VersionId": {
                      "description_en": "The current version ID",
                      "description_zh": "当前版本ID",
                      "example": "12345",
                      "format": "int64",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "ApkMd5": {
                "description_en": "The MD5 value of the APK",
                "description_zh": "APK的MD5值",
                "example": "34653456wertwe234653retwewer3456",
                "type": "string"
              },
              "AppId": {
                "description_en": "The application ID",
                "description_zh": "应用ID",
                "example": "12",
                "type": "string"
              },
              "AppName": {
                "description_en": "The application name",
                "description_zh": "应用名称",
                "example": "iovcc-ota",
                "type": "string"
              },
              "AppVersion": {
                "description_en": "The application version number",
                "description_zh": "应用版本号",
                "example": "2.0.1",
                "type": "string"
              },
              "BlackVersionList": {
                "description_en": "The version blacklist. Version codes are concatenated with commas",
                "description_zh": "版本黑名单，versioncode英文逗号拼接",
                "example": "10,20,30",
                "type": "string"
              },
              "DownloadUrl": {
                "description_en": "The download URL of the upgrade package",
                "description_zh": "升级包下载地址",
                "example": "http://www.cdn-server.com/file.zip",
                "type": "string"
              },
              "GmtCreate": {
                "description_en": "The creation time",
                "description_zh": "创建时间",
                "example": "2018-04-24 12:23:45",
                "type": "string"
              },
              "GmtModify": {
                "description_en": "The update time",
                "description_zh": "更新时间",
                "example": "2018-04-24 12:23:45",
                "type": "string"
              },
              "Id": {
                "description_en": "The version ID",
                "description_zh": "版本ID",
                "example": "12345",
                "format": "int64",
                "type": "integer"
              },
              "InstallType": {
                "description_en": "The installation method of the application upgrade package. Valid values: auto / customize",
                "description_zh": "应用升级包安装方式。取值：auto / customize",
                "example": "auto",
                "type": "string"
              },
              "IsAllowNewInstall": {
                "description_en": "Specifies whether the server is allowed to return this application version when the application does not exist on the client. Valid values: Y | N",
                "description_zh": "当客户端不存在该应用时，服务端是否允许返回该应用版本，取值：Y | N",
                "example": "Y",
                "type": "string"
              },
              "IsForceUpgrade": {
                "description_en": "Specifies whether a forced upgrade is required. Valid values: Y | N",
                "description_zh": "是否强制升级，取值：Y | N",
                "example": "N",
                "type": "string"
              },
              "IsNeedRestart": {
                "description_en": "Specifies whether a restart is required. Valid values: Y | N",
                "description_zh": "是否需要重启，取值：Y | N",
                "example": "N",
                "type": "string"
              },
              "IsSilentUpgrade": {
                "description_en": "Specifies whether silent upgrade is enabled. Valid values: Y | N",
                "description_zh": "是否静默升级，取值：Y | N",
                "example": "N",
                "type": "string"
              },
              "Md5": {
                "description_en": "The MD5 value of the upgrade package",
                "description_zh": "升级包MD5",
                "example": "345adsff2094asas2345et3",
                "type": "string"
              },
              "OriginalUrl": {
                "description_en": "The original URL of the upgrade package",
                "description_zh": "升级包原始地址",
                "example": "http://www.oss-server.com/file.zip",
                "type": "string"
              },
              "PackageName": {
                "description_en": "The application package name",
                "description_zh": "应用包名",
                "example": "com.aliyun.iovcc.ota",
                "type": "string"
              },
              "ReleaseNote": {
                "description_en": "The version release note",
                "description_zh": "版本发布说明",
                "example": "sample release note",
                "type": "string"
              },
              "Remark": {
                "description_en": "The version remarks. This information is not visible to terminal devices",
                "description_zh": "版本备注信息，终端设备不可见",
                "example": "sample remark",
                "type": "string"
              },
              "RestartAppParam": {
                "description_en": "The application restart parameter",
                "description_zh": "应用重启参数",
                "example": "k1:v1",
                "type": "string"
              },
              "RestartAppType": {
                "description_en": "If restartType is set to application restart, this field indicates the type of application restart. Valid values:\n\nservice: Service restart.\nactivity: Activity restart",
                "description_zh": "如果restartType为应用重启，则这个字段表示应用重启的类型。取值：\n\nservice：表示Service重启\nactivity：表示Activity重启",
                "example": "activity",
                "type": "string"
              },
              "RestartType": {
                "description_en": "The restart type after the application is installed. Valid values:\n\nsystem: System restart.\napp: Application restart",
                "description_zh": "应用安装完成后的重启类型，取值：\n\nsystem：表示系统重启\napp：表示应用重启",
                "example": "app",
                "type": "string"
              },
              "Size": {
                "description_en": "The size of the upgrade package, in bytes",
                "description_zh": "升级包大小，字节为单位",
                "example": "1204560",
                "type": "string"
              },
              "Status": {
                "description_en": "The application version status. The status definitions are the same as those for system versions",
                "description_zh": "应用版本状态，状态定义和系统版本一致",
                "example": "PUBLISHED",
                "type": "string"
              },
              "StatusName": {
                "description_en": "The display name of the version status",
                "description_zh": "版本状态的中文名",
                "example": "已发布",
                "type": "string"
              },
              "VersionCode": {
                "description_en": "The application version code, which is used for version comparison during upgrades",
                "description_zh": "应用版本versioncode，用于版本升级比较大小的逻辑",
                "example": "201",
                "format": "int64",
                "type": "integer"
              },
              "WhiteVersionList": {
                "description_en": "The version whitelist. Version codes are concatenated with commas",
                "description_zh": "版本白名单，versioncode英文逗号拼接",
                "example": "10,20,30",
                "type": "string"
              }
            },
            "type": "object"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "6F25F67C-F411-499F-BCE2-67CA563CB064",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
