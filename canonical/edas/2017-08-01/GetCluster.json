                "type": "integer"
              },
              "MemUsed": {
                "description_en": "The amount of used memory. Unit: MB",
                "description_zh": "已使用内存量，单位MB",
                "example": "1024",
                "format": "int32",
                "type": "integer"
              },
              "NetworkMode": {
                "description_en": "The network type. Valid values:\n1: Classic network.\n2: VPC",
