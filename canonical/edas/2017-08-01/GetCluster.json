                "description_zh": "Docker集群CPU超卖：\n1：1:1比例，不超卖。\n2：1:2比例超卖\n4：1:4比例超卖\n8：1:8比例超卖",
                "example": "2",
                "format": "int32",
                "type": "integer"
              },
              "RegionId": {
                "description_en": "The region ID",
                "description_zh": "地域ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "SubClusterType": {
                "description_en": "The subtype of the Kubernetes cluster. ManagedKubernetes indicates an ACK cluster, Ask indicates an ASK cluster, and ExternalKubernetes indicates an external cluster",
                "description_zh": "K8s类型集群的子类型：ManagedKubernetes为阿里云ACK集群类型，\nAsk为阿里云ASK集群类型，\nExternalKubernetes为外部集群类型",
                "enum": [
                  "ManagedKubernetes",
                  "Ask"
                ],
                "enumValueTitles": {
                  "Ask": "阿里云ASK集群",
                  "ManagedKubernetes": "阿里云ACK集群"
                },
                "example": "ManagedKubernetes",
                "title_en": "",
                "title_zh": "K8S类型集群的子类型：ManagedKubernetes为阿里云ACK集群类型，\nAsk为阿里云ASK集群类型，\nExternalKubernetes为外部集群类型",
                "type": "string"
              },
              "UpdateTime": {
                "description_en": "The timestamp when the cluster was last modified",
                "description_zh": "最后变更时间的时间戳",
                "example": "1570708232145",
                "format": "int64",
                "type": "integer"
              },
              "VpcId": {
                "description_en": "The VPC ID",
                "description_zh": "VPC网络ID",
                "example": "vpc-xxxxz1mlwpb****",
                "type": "string"
              }
            },
            "type": "object"
          },
          "Code": {
            "description_en": "The status code",
            "description_zh": "code码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "Message": {
            "description_en": "The detailed message",
            "description_zh": "详细信息",
            "example": "success",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "d76db491",
            "type": "string"
          }
        },
        "type": "object"
      }
