      "location": "query",
      "name": "cluster_id",
      "options": [
        "--cluster-id"
      ],
      "raw_name": "clusterId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/pop/v5/resource/convertable_ecu_list",
  "product_code": "Edas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The content that is returned",
        "description_zh": "接口响应",
        "properties": {
          "Code": {
            "description_en": "The HTTP status code that is returned",
            "description_zh": "接口状态或POP错误码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "InstanceList": {
            "description_en": "",
            "description_zh": "",
            "itemNode": true,
            "properties": {
              "Instance": {
                "description_en": "The ECS instances that can be imported to the cluster",
                "description_zh": "可导入该集群的ECS实例列表",
                "items": {
                  "description_en": "The information about ECS instances",
                  "description_zh": "ECS实例对象",
                  "properties": {
                    "Cpu": {
                      "description_en": "The number of CPU cores of the ECS instance",
                      "description_zh": "ECS实例CPU",
                      "example": "2",
                      "format": "int32",
                      "type": "integer"
                    },
                    "EcuId": {
                      "description_en": "The ID of the elastic compute units (ECU)",
                      "description_zh": "ECU ID",
                      "example": "b197-40ab-9155-7ca7",
                      "type": "string"
                    },
                    "Eip": {
                      "description_en": "The elastic IP address (EIP) associated with the ECS instance. The EIP can be changed",
                      "description_zh": "ECS弹性公网IP，可更换绑定目标",
                      "example": "13.xx.xxx.xx",
                      "type": "string"
                    },
                    "Expired": {
                      "description_en": "Indicates whether the ECS instance has expired",
                      "description_zh": "是否过期",
                      "example": "false",
                      "type": "boolean"
                    },
                    "InnerIp": {
                      "description_en": "The private IP address of the ECS instance. This parameter is valid only when the ECS instance is deployed in a VPC",
                      "description_zh": "ECS实例内网IP，当ECS网络类型为专有网络类型时",
                      "example": "192.168.13.xx",
                      "type": "string"
                    },
                    "InstanceId": {
                      "description_en": "The ID of the ECS instance",
                      "description_zh": "ECS实例ID",
                      "example": "i-2ze7s2v0b***********",
                      "type": "string"
                    },
                    "InstanceName": {
                      "description_en": "The name of the ECS instance",
                      "description_zh": "ECS实例名称",
                      "example": "worker-k8s",
                      "type": "string"
                    },
                    "Mem": {
                      "description_en": "The size of memory for the ECS instance",
                      "description_zh": "ECS实例MEM",
                      "example": "4096",
                      "format": "int32",
                      "type": "integer"
                    },
                    "PrivateIp": {
                      "description_en": "The private IP address of the ECS instance. This parameter is valid only when the ECS instance is deployed in a VPC",
                      "description_zh": "ECS实例私网IP，当ECS网络类型为VPC专有网络类型时。 ",
                      "example": "192.XX.XX.123",
                      "type": "string"
                    },
                    "PublicIp": {
                      "description_en": "The public IP address of the ECS instance. This IP address can be used only by the ECS instance",
                      "description_zh": "ECS实例公网IP，固定给该ECS实例使用。 ",
                      "example": "13.xx.xx.xxx",
                      "type": "string"
                    },
                    "RegionId": {
                      "description_en": "The ID of the region where the ECS instance is located",
                      "description_zh": "所在地域ID",
                      "example": "cn-beijing",
                      "type": "string"
                    },
                    "Status": {
                      "description_en": "The state of the instance. Valid values:\n\nPending: The instance is being created.\n\nRunning: The instance is running.\n\nStarting: The instance is being started.\n\nStopping: The instance is being stopped.\n\nStopped: The instance is stopped",
                      "description_zh": "实例状态：\nPending：创建中。\nRunning：运行中。\nStarting：启动中。\nStopping：停止中。\nStopped：已停止",
                      "example": " Running",
                      "type": "string"
                    },
                    "VpcId": {
                      "description_en": "The ID of the virtual private cloud (VPC)",
                      "description_zh": "VPC网络ID",
                      "example": "vpc-2zef6ob8m************",
                      "type": "string"
                    },
                    "VpcName": {
                      "description_en": "The name of the VPC",
                      "description_zh": "VPC网络名称",
                      "example": "jianwei-test",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "Message": {
            "description_en": "The additional information that is returned",
            "description_zh": "附加信息",
            "example": "success",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "b197-40ab-9155-7ca7",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
