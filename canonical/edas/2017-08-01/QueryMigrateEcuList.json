{
  "backend_timeout_ms": 2000,
  "camel_example": "aliyun edas GET /pop/v5/resource/migrate_ecu_list --region cn-hangzhou --LogicalRegionId 'cn-hangzhou_or_cn-hangzhou:test' --header \"Content-Type=application/json\"",
  "cmd_full_name": "edas query-migrate-ecu-list",
  "cmd_name": "query-migrate-ecu-list",
  "deprecated": false,
  "description_en": "Queries the elastic compute units (ECUs) that can be migrated",
  "description_zh": "调用QueryMigrateEcuList来查询可迁移的实例列表",
  "kebab_example": "aliyun edas query-migrate-ecu-list --logical-region-id cn-hangzhou_or_cn-hangzhou:test --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "QueryMigrateEcuList",
  "operation": {
    "action": "QueryMigrateEcuList",
    "api_style": "ROA",
    "api_version": "2017-08-01",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/pop/v5/resource/migrate_ecu_list"
  },
  "parameters": [
    {
      "example": "cn-hangzhou or cn-hangzhou:test",
      "help_en": "The ID of the namespace.\n\nThe ID of a custom namespace is in the `region ID:namespace identifier` format. Example: `cn-beijing:test`.\n\nThe ID of the default namespace is in the `region ID` format. Example: `cn-beijing`",
      "help_zh": "命名空间ID。\n自定义命名空间ID格式为：`地域ID:命名空间标示符`，例如：`cn-beijing:test`。\n默认命名空间ID格式为：`地域ID`，例如：`cn-beijing`",
      "location": "query",
      "name": "logical_region_id",
      "options": [
        "--logical-region-id"
      ],
      "raw_name": "LogicalRegionId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/pop/v5/resource/migrate_ecu_list",
  "product_code": "Edas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "The HTTP status code that is returned",
            "description_zh": "接口状态或POP错误码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "EcuEntityList": {
            "description_en": "",
            "description_zh": "",
            "itemNode": true,
            "properties": {
              "EcuEntity": {
                "description_en": "The information about ECUs that can be migrated",
                "description_zh": "可供迁移的实例列表",
                "items": {
                  "description_en": "",
                  "description_zh": "",
                  "properties": {
                    "AvailableCpu": {
                      "description_en": "The number of available CPUs. Unit: cores",
                      "description_zh": "可用CPU，单位为核数",
                      "example": "2",
                      "format": "int32",
                      "type": "integer"
                    },
                    "AvailableMem": {
                      "description_en": "The size of available memory. Unit: MB",
                      "description_zh": "可用内存，单位为MB",
                      "example": "2048",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Cpu": {
                      "description_en": "The CPU quota set by the system. Unit: cores. The value 0 indicates that no quota is set by the system",
                      "description_zh": "CPU限制配额，单位为核数。0表示不限制",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "CreateTime": {
                      "description_en": "The time when the ECU was created. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since the epoch time January 1, 1970, 00:00:00 UTC",
                      "description_zh": "创建时间的时间戳",
                      "example": "1573281041101",
                      "format": "int64",
                      "type": "integer"
                    },
                    "DockerEnv": {
                      "description_en": "Indicates whether Docker is installed. Valid values:\n\ntrue: Docker is installed.\n\nfalse: Docker is not installed",
                      "description_zh": "是否安装了Docker：\ntrue：已安装Docker\nfalse：未安装Docker",
                      "example": "false",
                      "type": "boolean"
                    },
                    "EcuId": {
                      "description_en": "The unique ID of the ECU. To query the ID, you can run the `dmidecode` command on the ECS instance that corresponds to the ECU",
                      "description_zh": "这台ECU的唯一标识ID，可以通过在ECS上执行`dmidecode`获取",
                      "example": "70ed3f59-b476-49aa-****-************",
                      "type": "string"
                    },
                    "HeartbeatTime": {
                      "description_en": "The time when the last heartbeat detection was performed. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since the epoch time January 1, 1970, 00:00:00 UTC",
                      "description_zh": "心跳时间的时间戳",
                      "example": "1573281041101",
                      "format": "int64",
                      "type": "integer"
                    },
                    "InstanceId": {
                      "description_en": "The ID of the ECU",
                      "description_zh": "实例ID",
                      "example": "i-2zej4i2jd***********",
                      "type": "string"
                    },
                    "IpAddr": {
                      "description_en": "The private IP address of the ECU",
                      "description_zh": "ECU的私网IP",
                      "example": "192.168.0.150",
                      "type": "string"
                    },
                    "Mem": {
                      "description_en": "The total size of memory",
                      "description_zh": "总内存",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Name": {
                      "description_en": "The name of the ECU",
                      "description_zh": "实例名称",
                      "example": "product_test003",
                      "type": "string"
                    },
                    "Online": {
                      "description_en": "Indicates whether the ECU is online. Valid values:\n\ntrue: The ECU is online.\n\nfalse: The ECU is offline",
                      "description_zh": "是否在线。\ntrue：在线\nfalse：不在线",
                      "example": "true",
                      "type": "boolean"
                    },
                    "RegionId": {
                      "description_en": "The ID of the region where the ECU resides",
                      "description_zh": "所在地域ID",
                      "example": "cn-beijing",
                      "type": "string"
                    },
                    "UpdateTime": {
                      "description_en": "The time when the ECU was updated. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since the epoch time January 1, 1970, 00:00:00 UTC",
                      "description_zh": "更新时间的时间戳",
                      "example": "1573281041109",
                      "format": "int64",
                      "type": "integer"
                    },
                    "UserId": {
                      "description_en": "The ID of the Alibaba Cloud account to which the ECU belongs",
                      "description_zh": "主账号ID",
                      "example": "edas_com***_****@******-*****.***",
                      "type": "string"
                    },
                    "VpcId": {
                      "description_en": "VPC ID",
                      "description_zh": "VPC ID",
                      "example": "vpc-2zef6ob8m************",
                      "type": "string"
                    },
                    "ZoneId": {
                      "description_en": "The ID of the zone where the ECU resides",
                      "description_zh": "可用区ID",
                      "example": "cn-bei****-*",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "Message": {
            "description_en": "The additional information that is returned",
            "description_zh": "附加信息",
            "example": "success",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "b197-40ab-9155-7ca7",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
