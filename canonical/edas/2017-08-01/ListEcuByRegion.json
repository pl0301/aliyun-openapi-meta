      "name": "logical_region_id",
      "options": [
        "--logical-region-id"
      ],
      "raw_name": "LogicalRegionId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "pop-query",
      "help_en": "Set the value to `pop-query`",
      "help_zh": "固定值为`pop-query`",
      "location": "query",
      "name": "act",
      "options": [
        "--act"
      ],
      "raw_name": "Act",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/pop/v5/resource/ecu_list",
  "product_code": "Edas",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "The content that is returned",
        "description_zh": "接口响应",
        "properties": {
          "Code": {
            "description_en": "The HTTP status code that is returned",
            "description_zh": "接口状态或POP错误码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "EcuEntityList": {
            "description_en": "",
            "description_zh": "",
            "itemNode": true,
            "properties": {
              "EcuEntity": {
                "description_en": "The information about ECUs",
                "description_zh": "ECU列表",
                "items": {
                  "description_en": "The details about ECUs",
                  "description_zh": "ECU列表对象",
                  "properties": {
                    "AvailableCpu": {
                      "description_en": "The number of available CPU cores for the ECU",
                      "description_zh": "ECU的可用CPU核数",
                      "example": "4",
                      "format": "int32",
                      "type": "integer"
                    },
                    "AvailableMem": {
                      "description_en": "The size of available memory for the ECU. Unit: MB",
                      "description_zh": "ECU的可用内存数，单位MB",
                      "example": "8192",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Cpu": {
                      "description_en": "The total number of CPU cores",
                      "description_zh": "CPU总核数",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "CreateTime": {
                      "description_en": "The timestamp when the ECU was created. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since the epoch time January 1, 1970, 00:00:00 UTC",
                      "description_zh": "创建时间的时间戳",
                      "example": "1572539283168",
                      "format": "int64",
                      "type": "integer"
                    },
                    "DockerEnv": {
                      "description_en": "Indicates whether Docker is installed. Valid values:\n\ntrue: Docker is installed.\n\nfalse: Docker is not installed",
                      "description_zh": "是否安装了Docker：\ntrue：已安装Docker。\nfalse：未安装Docker",
                      "example": "true",
                      "type": "boolean"
                    },
                    "EcuId": {
                      "description_en": "The unique ID of the ECU. To query the ID, you can run the `dmidecode` command on the ECS instance that corresponds to the ECU",
                      "description_zh": "这台ECU的唯一标示ID，可以在ECS上执行`dmidecode`获取",
                      "example": "c96c494c-1b91-4456-bbb3-b5afcd16****",
                      "type": "string"
                    },
                    "HeartbeatTime": {
                      "description_en": "The timestamp when the last heartbeat detection was performed. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                      "description_zh": "上一次心跳检测的时间戳",
                      "example": "1572867865221",
                      "format": "int64",
                      "type": "integer"
                    },
                    "InstanceId": {
                      "description_en": "The ID of the ECU",
                      "description_zh": "ECU ID",
                      "example": "i-2ze82h8f4zcn449y****",
                      "type": "string"
                    },
                    "IpAddr": {
                      "description_en": "The private IP address of the ECU",
                      "description_zh": "ECU的私网IP",
                      "example": "192.168.xxx.xxx",
                      "type": "string"
                    },
                    "Mem": {
                      "description_en": "The total size of memory. Unit: MB",
                      "description_zh": "总内存，单位MB",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Name": {
                      "description_en": "The name of the ECU",
                      "description_zh": "ECU名称",
                      "example": "worker-k8s-for",
                      "type": "string"
                    },
                    "Online": {
                      "description_en": "Indicates whether the ECU is online. Valid values:\n\ntrue: The ECU is online.\n\nfalse: The ECU is offline",
                      "description_zh": "是否在线：\ntrue：在线。\nfalse：不在线",
                      "example": "false",
                      "type": "boolean"
                    },
                    "RegionId": {
                      "description_en": "The ID of the region in which the ECU resides",
                      "description_zh": "ECU所在地域ID",
                      "example": "cn-beijing",
                      "type": "string"
                    },
                    "UpdateTime": {
                      "description_en": "The timestamp when the ECU was last modified. This value is a UNIX timestamp representing the number of milliseconds that have elapsed since January 1, 1970, 00:00:00 UTC",
                      "description_zh": "最后变更时间的时间戳",
                      "example": "1572867895575",
                      "format": "int64",
                      "type": "integer"
                    },
                    "UserId": {
                      "description_en": "The ID of the Alibaba Cloud account",
                      "description_zh": "主账号ID",
                      "example": "edas@aliyun-****.com",
                      "type": "string"
                    },
                    "VpcId": {
                      "description_en": "The ID of the virtual private cloud (VPC) in which the ECU resides",
                      "description_zh": "ECU所在的VPC ID",
                      "example": "vpc-2zew8mi6gqbo5wf****",
                      "type": "string"
                    },
                    "ZoneId": {
                      "description_en": "The ID of the zone in which the ECU resides",
                      "description_zh": "ECU所在可用区ID",
                      "example": "cn-beijing-a",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "Message": {
            "description_en": "The additional information that is returned",
            "description_zh": "附加信息 ",
            "example": "success",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "00000000-0000-0000-****",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
