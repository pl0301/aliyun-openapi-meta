{
  "camel_example": "aliyun edas GET /pop/v5/resource/ecu_list --region cn-hangzhou --LogicalRegionId 'Cn-beijing_or_cn-beijing:tdy218' --Act 'pop-query' --header \"Content-Type=application/json\"",
  "cmd_full_name": "edas list-ecu-by-region",
