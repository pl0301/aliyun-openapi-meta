                      "description_en": "A single collection scope entry",
                      "description_zh": "单个采集范围条目",
                      "example": "example_database",
                      "type": "string"
                    },
                    "title_en": "",
                    "title_zh": "采集范围条目",
                    "type": "array"
                  },
                  "Unit": {
                    "description_en": "The collection scope granularity. Valid values: PROJECT, DATABASE, INSTANCE, CATALOG",
                    "description_zh": "采集范围粒度。取值：PROJECT、DATABASE、INSTANCE、CATALOG",
                    "example": "DATABASE",
                    "title_en": "",
                    "title_zh": "采集范围粒度。取值：PROJECT、DATABASE、INSTANCE、CATALOG",
                    "type": "string"
                  }
                },
                "title_en": "",
                "title_zh": "采集范围配置",
                "type": "object"
              },
              "Status": {
                "description_en": "The crawler status. The value is VALID if the crawler configuration is valid and the associated data source exists. Otherwise, the value is INVALID",
                "description_zh": "采集器状态。采集器配置有效且关联数据源存在时为 VALID，否则为 INVALID",
