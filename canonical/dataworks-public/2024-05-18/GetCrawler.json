          "RequestId": {
            "description_en": "The request ID. Used for locating logs and troubleshooting issues",
            "description_zh": "请求 ID。用于定位日志，排查问题",
            "example": "9252F32F-D855-549E-8898-61CF5A733050",
            "title_en": "",
            "title_zh": "Id of the request",
            "type": "string"
          },
          "Success": {
            "description_en": "Indicates whether the request was successful",
            "description_zh": "请求是否成功",
            "title_en": "",
            "title_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "title_en": "",
        "title_zh": "Schema of Response",
        "type": "object"
      }
