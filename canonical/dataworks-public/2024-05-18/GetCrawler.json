                  "ExcludeRegex": {
                    "description_en": "The exclusion regular expression for the collection scope",
                    "description_zh": "采集范围排除正则",
                    "example": "^tmp_.*",
                    "title_en": "",
                    "title_zh": "采集范围排除正则",
                    "type": "string"
                  },
                  "Items": {
                    "description_en": "The collection scope entries",
                    "description_zh": "采集范围条目",
