                "title_en": "",
                "title_zh": "采集器状态。采集器配置有效且关联数据源存在时为 VALID，否则为 INVALID",
                "type": "string"
              },
              "TaskId": {
                "description_en": "The DataWorks scheduling task ID associated with the crawler, which can be used to call GetTask to query the task definition",
