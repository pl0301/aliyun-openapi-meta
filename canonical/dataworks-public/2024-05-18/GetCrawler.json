                  "Type": {
                    "description_en": "The schedule type. Valid values: MANUAL, NORMAL",
                    "description_zh": "调度类型。取值：MANUAL、NORMAL",
                    "example": "NORMAL",
                    "title_en": "",
                    "title_zh": "调度类型。取值：MANUAL、NORMAL",
                    "type": "string"
                  }
                },
                "title_en": "",
                "title_zh": "调度配置",
                "type": "object"
              },
              "Scope": {
                "description_en": "The collection scope configuration",
                "description_zh": "采集范围配置",
