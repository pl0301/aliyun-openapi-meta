                "format": "int64",
                "title_en": "",
                "title_zh": "采集器关联的 DataWorks 调度任务 ID，可用于调用 GetTask 查询任务定义",
                "type": "integer"
              },
              "Type": {
                "description_en": "The crawler type",
                "description_zh": "采集器类型",
                "example": "starrocks",
                "title_en": "",
                "title_zh": "采集器类型",
                "type": "string"
