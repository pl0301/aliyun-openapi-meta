  "kebab_example": "aliyun agentteams update-identity-provider --instance-id agentteams-xxx --login-enabled false --sync-enabled false --client-token ct-1234abcd --identity-provider-type DingTalk --idp-metadata '{\"appKey\":\"dingxxxx\",\"appSecret\":\"xxxxx\",\"corpId\":\"dingxxxx\",\"encryptKey\":\"xxxxx\",\"verificationToken\":\"xxxxx\"}' --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "UpdateIdentityProvider",
  "operation": {
    "action": "UpdateIdentityProvider",
    "api_style": "RPC",
