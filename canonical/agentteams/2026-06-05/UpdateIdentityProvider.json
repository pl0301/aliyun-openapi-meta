      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "Specifies whether to enable logon. If this parameter is not specified, the existing configuration is retained",
      "help_zh": "是否开启登录，不传时保持原配置不变",
