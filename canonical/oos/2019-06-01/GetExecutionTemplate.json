                "description_zh": "模板ID",
                "example": "t-94753d4d828d38",
                "type": "string"
              },
              "TemplateName": {
                "description_en": "The name of the template",
                "description_zh": "模板名称",
                "example": "MyTemplate",
                "type": "string"
              },
              "TemplateVersion": {
