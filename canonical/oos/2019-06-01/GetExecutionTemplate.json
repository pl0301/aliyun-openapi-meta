                "description_zh": "模板版本。以“v”+数字的形式，数字从1开始",
                "example": "v1",
                "type": "string"
              },
              "UpdatedBy": {
                "description_en": "The user who last updated the template",
                "description_zh": "模板更新者",
                "example": "root(13090000)",
                "type": "string"
              },
              "UpdatedDate": {
                "description_en": "The time when the template was last updated",
                "description_zh": "模板更新时间",
                "example": "2019-05-16T10:26:14Z",
                "type": "string"
              }
