      "schema": {
        "properties": {
          "Caches": {
            "itemNode": true,
            "properties": {
              "Cache": {
                "description_en": "The information about the cache disks",
                "description_zh": "缓存盘信息",
                "items": {
                  "properties": {
                    "BuyURL": {
                      "description_en": "The link to purchase the cache disk",
                      "description_zh": "缓存盘购买链接",
                      "example": "https://common-buy.aliyun.com/?commodityCode=hcs_sgw_csg_pre&orderType=RENEW&instanceId=ca-0007va9bnideidnd***#/buy",
                      "type": "string"
                    },
                    "CacheId": {
                      "description_en": "The ID of the cache disk",
                      "description_zh": "缓存盘ID",
                      "example": "d-bp1dcnq8zldree6ok***",
                      "type": "string"
                    },
                    "CacheType": {
                      "description_en": "The type of the cache disk. Valid values:\n\ncloud_efficiency: ultra disk.\ncloud_ssd: standard SSD.\ncloud_essd: ESSD",
                      "description_zh": "缓存盘类型。可能值：\ncloud_efficiency：高效云盘。\ncloud_ssd：SSD云盘。\ncloud_essd：ESSD云盘",
                      "example": "cloud_efficiency",
                      "type": "string"
                    },
                    "ExpireStatus": {
                      "description_en": "The expiration status. Valid values:\n\n0: The cache disk is Normal.\n1: The cache disk is about to expire.\n2: The cache disk has expired",
                      "description_zh": "是否过期状态。可能值：\n0：正常。\n1：将要过期。\n2：已经过期",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "ExpiredTime": {
                      "description_en": "The UNIX timestamp when the cache disk expires. Unit: seconds",
                      "description_zh": "到期时间戳，单位为秒（s）",
                      "example": "1532510649",
                      "format": "int64",
                      "type": "integer"
                    },
                    "Iops": {
                      "description_en": "The input/output operations per second (IOPS) of the cache disk",
                      "description_zh": "缓存盘IOPS",
                      "example": "2605",
                      "format": "int64",
                      "type": "integer"
                    },
                    "IsDirectExpand": {
                      "description_en": "Indicates whether online scale-out is supported. A value of true indicates that online scale-out is supported",
                      "description_zh": "是否支持在线扩容。true表示支持",
                      "example": "true",
                      "type": "string"
                    },
                    "IsNoPartition": {
                      "description_en": "Indicates whether the cache disk has a partition. A value of true indicates that the cache disk does not have a partition",
                      "description_zh": "是否有分区。true表示没有",
                      "example": "true",
                      "type": "boolean"
                    },
                    "IsUsed": {
                      "description_en": "Indicates whether the cache disk is used",
                      "description_zh": "是否被使用",
                      "example": "false",
                      "type": "boolean"
                    },
                    "LocalFilePath": {
                      "description_en": "The internal name of the device",
                      "description_zh": "缓存盘内部设备名",
                      "example": "/dev/vdb",
                      "type": "string"
                    },
                    "PerformanceLevel": {
                      "description_en": "The performance level of the Enhanced SSD (ESSD). Valid values:\n\nPL1\nPL2\nPL3",
                      "description_zh": "ESSD云盘性能等级。可能值：\nPL1\nPL2\nPL3",
                      "example": "PL1",
                      "type": "string"
                    },
                    "RenewURL": {
                      "description_en": "The renewal link",
                      "description_zh": "续费链接",
                      "example": "https://common-buy.aliyun.com/?commodityCode=hcs_sgw_csg_pre&orderType=RENEW&instanceId=ca-0007va9bnideidnd***#/renew",
                      "type": "string"
                    },
                    "SizeInGB": {
                      "description_en": "The size of the cache disk. Unit: GB",
                      "description_zh": "缓存盘大小。单位：GB",
                      "example": "100",
                      "format": "int64",
                      "type": "integer"
                    },
                    "SubscriptionInstanceId": {
                      "description_en": "The ID of the subscription instance",
                      "description_zh": "付费实例ID",
                      "example": "ca-000bq2fkzol56575***",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "Code": {
            "description_en": "The status code. A status code of 200 indicates that the request is successful",
            "description_zh": "状态码。状态码为200表示请求成功",
            "example": "200",
            "type": "string"
          },
          "Message": {
            "description_en": "The message that is returned",
            "description_zh": "请求结果描述",
            "example": "successful",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "40797B4D-09D9-482E-B163-CCB568BADE35",
            "type": "string"
          },
          "Success": {
            "description_en": "Indicates whether the request is successful",
            "description_zh": "请求是否成功",
            "example": "true",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
