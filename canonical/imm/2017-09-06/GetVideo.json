{
  "backend_timeout_ms": 10000,
  "cmd_full_name": "imm get-video",
  "cmd_name": "get-video",
  "deprecated": false,
  "description_en": "Retrieves information about a video in a media set by calling GetVideo",
  "description_zh": "调用GetVideo获取媒体集中一个视频的信息",
  "kebab_example": "aliyun imm get-video --project immvideotest --set-id videoset --video-uri oss://imm-test/testcases/video.mp4 --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetVideo",
  "operation": {
    "action": "GetVideo",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immvideotest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "videoset",
      "help_en": "The unique identifier of the media set",
      "help_zh": "媒体集的唯一标识",
      "location": "query",
      "name": "set_id",
      "options": [
        "--set-id"
      ],
      "raw_name": "SetId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "oss://imm-test/testcases/video.mp4",
      "help_en": "The OSS URI of the video.\n\nThe OSS URI follows the format `oss://bucket/object`, where bucket is the name of an OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "视频的OSS URI。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "video_uri",
      "options": [
        "--video-uri"
      ],
      "raw_name": "VideoUri",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "CreateTime": {
            "description_en": "The time when the video was added to the media set",
            "description_zh": "视频加入媒体集的时间",
            "example": "2021-01-21T07:40:41.683Z",
            "type": "string"
          },
          "ExternalId": {
            "description_en": "The external ID, which is used to bind with the ID in your application layer, if applicable",
            "description_zh": "外部ID，用于和您的应用层的 ID （如果有）进行绑定",
            "example": "externalId001",
            "type": "string"
          },
          "FileSize": {
            "description_en": "The file size. Unit: bytes",
            "description_zh": "文件大小，单位为字节",
            "example": "25115517",
            "format": "int32",
            "type": "integer"
          },
          "ModifyTime": {
            "description_en": "The time when the video was last modified.\n\nIf the video has not been modified after being added to the media set, the modification time is the same as the time when the video was added to the media set",
            "description_zh": "视频的修改时间。\n\n添加视频到媒体集后，如果未修改过视频，则视频的修改时间和视频加入媒体集的时间相同",
            "example": "2021-01-21T07:40:41.683Z",
            "type": "string"
          },
          "ProcessFailReason": {
            "description_en": "The reason why video processing failed",
            "description_zh": "视频处理的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "ProcessModifyTime": {
            "description_en": "The time when video processing was last updated",
            "description_zh": "视频处理的更新时间",
            "example": "2021-01-21T07:40:53.955Z",
            "type": "string"
          },
          "ProcessStatus": {
            "description_en": "The processing status of the video",
            "description_zh": "视频处理的状态",
            "example": "Success",
            "type": "string"
          },
          "RemarksA": {
            "description_en": "The remarks",
            "description_zh": "标记信息",
            "example": "AdminGroup/AdminUserA/",
            "type": "string"
          },
          "RemarksB": {
            "description_en": "The remarks",
            "description_zh": "标记信息",
            "example": "nas://path/to/file",
            "type": "string"
          },
          "RemarksC": {
            "description_en": "The remarks",
            "description_zh": "标记信息",
            "example": "remarkc",
            "type": "string"
          },
          "RemarksD": {
            "description_en": "The remarks",
            "description_zh": "标记信息",
            "example": "remarkd",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "当次请求的Request ID",
            "example": "5FC2B195-B43E-45ED-9BEC-169358550193",
            "type": "string"
          },
          "SetId": {
            "description_en": "The unique identifier of the media set",
            "description_zh": "媒体集的唯一标识",
            "example": "videoset",
            "type": "string"
          },
          "SourcePosition": {
            "description_en": "The position of the image frame on the timeline of the source video. The format is 00000000.010, which represents %8.3f",
            "description_zh": "视频中该图片帧处于源视频的时间轴位置。格式为00000000.010，即%8.3f",
            "example": "00000000.010",
            "type": "string"
          },
          "SourceType": {
            "description_en": "The type of the source data",
            "description_zh": "源数据的类型",
            "example": "video",
            "type": "string"
          },
          "SourceUri": {
            "description_en": "The OSS URI of the video",
            "description_zh": "视频的OSS URI",
            "example": "oss://imm-test/testcases/video.mp4",
            "type": "string"
          },
          "VideoDuration": {
            "description_en": "The video duration. Unit: seconds",
            "description_zh": "视频时长，单位为秒",
            "example": "15.263",
            "format": "float",
            "type": "number"
          },
          "VideoFacesFailReason": {
            "description_en": "The reason why video face recognition failed",
            "description_zh": "视频人脸识别的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "VideoFacesModifyTime": {
            "description_en": "The time when video face recognition was last updated",
            "description_zh": "视频人脸识别的更新时间",
            "example": "1970-01-01T00:00:00Z",
            "type": "string"
          },
          "VideoFacesStatus": {
            "description_en": "The status of video face recognition",
            "description_zh": "视频人脸识别的状态",
            "example": "Success",
            "type": "string"
          },
          "VideoFormat": {
            "description_en": "The video format",
            "description_zh": "视频格式",
            "example": "mov,mp4,m4a,3gp,3g2,mj2",
            "type": "string"
          },
          "VideoFrameTagsFailReason": {
            "description_en": "The reason why video frame tag recognition failed",
            "description_zh": "视频帧标签识别的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "VideoFrameTagsModifyTime": {
            "description_en": "The time when the video frame tag recognition was last updated",
            "description_zh": "视频帧标签识别的更新时间",
            "example": "1970-01-01T00:00:00Z",
            "type": "string"
          },
          "VideoFrameTagsStatus": {
            "description_en": "The status of video frame tag recognition",
            "description_zh": "视频帧标签识别的状态",
            "example": "Success",
            "type": "string"
          },
          "VideoFrames": {
            "description_en": "The number of frames",
            "description_zh": "帧数",
            "example": "462",
            "format": "int32",
            "type": "integer"
          },
          "VideoHeight": {
            "description_en": "The height of the video frame",
            "description_zh": "视频画面的高度",
            "example": "1920",
            "format": "int32",
            "type": "integer"
          },
          "VideoInfo": {
            "description_en": "The video information",
            "description_zh": "视频信息",
            "example": "{\"MediaStreams\":{\"VideoStreams\":[{\"Index\":0,\"Language\":\"eng\",\"CodecName\":\"h264\",\"CodecLongName\":\"H.264 / AVC / MPEG-4 AVC / MPEG-4 part 10\",\"Profile\":\"Baseline\",\"CodecTimeBase\":\"1373627/83160000\",\"CodecTagString\":\"avc1\",\"CodecTag\":\"0x31637661\",\"Width\":1080,\"Height\":1920,\"SampleAspectRatio\":\"1:1\",\"DisplayAspectRatio\":\"9:16\",\"PixelFormat\":\"yuv420p\",\"Level\":40,\"FrameRrate\":\"90000/1\",\"AverageFrameRate\":\"41580000/1373627\",\"TimeBase\":\"1/90000\",\"StartTime\":\"0.000000\",\"Duration\":\"15.262522\",\"Bitrate\":\"13091201\",\"Frames\":\"462\"}],\"AudioStreams\":[],\"SubtitleStreams\":[]},\"MediaFormat\":{\"NumberStreams\":2,\"FormatName\":\"mov,mp4,m4a,3gp,3g2,mj2\",\"FormatLongName\":\"QuickTime / MOV\",\"Size\":\"25115517\",\"Duration\":\"15.263000\",\"StartTime\":\"0.000000\",\"Bitrate\":\"13164131\",\"CreationTime\":\"2020-10-25T09:16:09.000000Z\",\"Address\":{},\"Tag\":{}}}",
            "type": "string"
          },
          "VideoOCRFailReason": {
            "description_en": "The reason why OCR recognition failed",
            "description_zh": "OCR识别的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "VideoOCRModifyTime": {
            "description_en": "The time when OCR recognition was last updated",
            "description_zh": "OCR识别的更新时间",
            "example": "1970-01-01T00:00:00Z",
            "type": "string"
          },
          "VideoOCRStatus": {
            "description_en": "The status of OCR recognition",
            "description_zh": "OCR识别的状态",
            "example": "Success",
            "type": "string"
          },
          "VideoSTTFailReason": {
            "description_en": "The reason why speech-to-text conversion failed",
            "description_zh": "语音转文字的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "VideoSTTModifyTime": {
            "description_en": "The time when speech-to-text conversion was last updated",
            "description_zh": "语音转文字的更新时间",
            "example": "2021-01-21T07:40:53.95Z",
            "type": "string"
          },
          "VideoSTTStatus": {
            "description_en": "The status of speech-to-text conversion",
            "description_zh": "语音转文字的状态",
            "example": "Success",
            "type": "string"
          },
          "VideoTags": {
            "description_en": "The video tag processing results",
            "description_zh": "视频标签处理结果",
            "items": {
              "description_en": "",
              "description_zh": "",
              "properties": {
                "ParentTagName": {
                  "description_en": "The parent tag name",
                  "description_zh": "父级标签名称",
                  "example": "内部场景",
                  "type": "string"
                },
                "TagConfidence": {
                  "description_en": "The tag confidence level",
                  "description_zh": "标签置信度",
                  "example": "0.8933850526809692",
                  "format": "float",
                  "type": "number"
                },
                "TagLevel": {
                  "description_en": "The tag level. Valid values: 1 to 4",
                  "description_zh": "标签级别，取值范围为1~4",
                  "example": "2",
                  "format": "int32",
                  "type": "integer"
                },
                "TagName": {
                  "description_en": "The tag name",
                  "description_zh": "标签名称",
                  "example": "大型超市",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "VideoTagsFailReason": {
            "description_en": "The reason why video tag processing failed",
            "description_zh": "视频标签处理的失败原因",
            "example": "Timeout",
            "type": "string"
          },
          "VideoTagsModifyTime": {
            "description_en": "The time when video tag processing was last updated. This value is updated when VideoTagsStatus changes",
            "description_zh": "视频标签处理的更新时间。当VideoTagsStatus更改时更新",
            "example": "2021-01-21T07:40:53.95Z",
            "type": "string"
          },
          "VideoTagsStatus": {
            "description_en": "The status of video tag processing. Valid values:\n\nNotProcessed: not processed\nProcessing: being processed\nSuccess: succeeded\nFailed: failed\n\nYou can read the results, wait, or retry based on this status",
            "description_zh": "视频标签处理的状态，包括如下选项：\n\nNotProcessed：未处理\nProcessing：处理中\nSuccess：成功\nFailed ：失败\n\n您可以根据该状态决定读取结果、等待或重试",
            "example": "Success",
            "type": "string"
          },
          "VideoUri": {
            "description_en": "The OSS URI of the video",
            "description_zh": "视频的OSS URI",
            "example": "oss://imm-test/testcases/video.mp4",
            "type": "string"
          },
          "VideoWidth": {
            "description_en": "The width of the video frame",
            "description_zh": "视频画面的宽度",
            "example": "1080",
            "format": "int32",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
