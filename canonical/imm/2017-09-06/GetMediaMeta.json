{
  "backend_timeout_ms": 10000,
  "cmd_full_name": "imm get-media-meta",
  "cmd_name": "get-media-meta",
  "deprecated": false,
  "description_en": "Retrieves multimedia file information, such as encoding, bitrate, resolution, and stream details",
  "description_zh": "获取多媒体文件信息，如编码、码率、分辨率、流信息等",
  "kebab_example": "aliyun imm get-media-meta --project immvideotest --media-uri oss://imm-test/testcases/video.mp4 --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetMediaMeta",
  "operation": {
    "action": "GetMediaMeta",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immvideotest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "oss://imm-test/testcases/video.mp4",
      "help_en": "The OSS URI of the video.\n\nThe OSS URI follows the format `oss://bucket/object`, where bucket is the name of the OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "视频的OSS URI。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "media_uri",
      "options": [
        "--media-uri"
      ],
      "raw_name": "MediaUri",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "MediaMeta": {
            "description_en": "The multimedia information",
            "description_zh": "多媒体信息",
            "properties": {
              "MediaFormat": {
                "description_en": "The media format information",
