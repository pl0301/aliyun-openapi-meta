                        "type": "string"
                      },
                      "City": {
                        "description_en": "The city or equivalent-level area of the geographic location in the video",
                        "description_zh": "视频地理位置所在城市（或同级）",
                        "example": "杭州市",
                        "type": "string"
                      },
                      "Country": {
                        "description_en": "The country or region of the geographic location in the video",
                        "description_zh": "视频地理位置所在国家或地区",
