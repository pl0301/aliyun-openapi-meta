{
  "cmd_full_name": "imm get-image-cropping-suggestions",
  "cmd_name": "get-image-cropping-suggestions",
  "deprecated": false,
  "description_en": "Retrieves image cropping suggestions",
  "description_zh": "获取图片裁剪建议",
  "kebab_example": "aliyun imm get-image-cropping-suggestions --project immimagetest --image-uri oss://imm-test/testcases/imagecroppingtest.jpg --aspect-ratios 1:1_,_2:3 --api-version 2017-09-06 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "GetImageCroppingSuggestions",
  "operation": {
    "action": "GetImageCroppingSuggestions",
    "api_style": "RPC",
    "api_version": "2017-09-06",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "immimagetest",
      "help_en": "The project name",
      "help_zh": "项目名称",
      "location": "query",
      "name": "project",
      "options": [
        "--project"
      ],
      "raw_name": "Project",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "oss://imm-test/testcases/imagecroppingtest.jpg",
      "help_en": "The OSS URI of the image.\n\nThe OSS address follows the format `oss://bucket/object`, where bucket is the name of an OSS bucket in the same region as the current project, and object is the file path",
      "help_zh": "图片的OSS URI。\n\nOSS地址规则为`oss://bucket/object`，其中bucket为和当前项目处于同一区域的OSS Bucket名称，object为文件路径",
      "location": "query",
      "name": "image_uri",
      "options": [
        "--image-uri"
      ],
      "raw_name": "ImageUri",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "[\"1:1\",\"2:3\"]",
      "help_en": "The list of cropping aspect ratios. Only integer ratios are supported",
      "help_zh": "裁剪比例列表，仅支持整数比例",
      "location": "query",
      "name": "aspect_ratios",
      "options": [
        "--aspect-ratios"
      ],
      "raw_name": "AspectRatios",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "imm",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "CroppingSuggestions": {
            "description_en": "The cropping suggestions for the image",
            "description_zh": "图片的裁剪建议",
            "items": {
              "description_en": "",
              "description_zh": "",
              "properties": {
                "AspectRatio": {
                  "description_en": "The cropping aspect ratio of the image",
                  "description_zh": "图片裁剪比例",
                  "example": "1:1",
                  "type": "string"
                },
                "CroppingBoundary": {
                  "description_en": "The crop box information",
                  "description_zh": "裁剪框信息",
                  "properties": {
                    "Height": {
                      "description_en": "The height of the crop box. Unit: px",
                      "description_zh": "裁剪框高度。单位为px",
                      "example": "500",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Left": {
                      "description_en": "The X coordinate of the top-left vertex, which is the distance from the left edge. Unit: px",
                      "description_zh": "顶点X坐标，距离左端距离。单位为px",
                      "example": "0",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Top": {
                      "description_en": "The Y coordinate of the top-left vertex, which is the distance from the top edge. Unit: px",
                      "description_zh": "顶点Y坐标，距离顶端距离。单位为px",
                      "example": "77",
                      "format": "int32",
                      "type": "integer"
                    },
                    "Width": {
                      "description_en": "The width of the crop box. Unit: px",
                      "description_zh": "裁剪框宽度。单位为px",
                      "example": "500",
                      "format": "int32",
                      "type": "integer"
                    }
                  },
                  "type": "object"
                },
                "Score": {
                  "description_en": "The aesthetic score of the cropping suggestion. A higher score indicates a better result. Valid values: 0 to 1",
                  "description_zh": "该裁剪方案的美学分数，分数越高表示该方案效果越好，取值范围为0～1",
                  "example": "0.6979608535766602",
                  "format": "float",
                  "type": "number"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "ImageUri": {
            "description_en": "The OSS URI of the image",
            "description_zh": "图片的OSS URI",
            "example": "oss://imm-test/testcases/imagecroppingtest.jpg",
            "type": "string"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "当次请求的Request ID",
            "example": "EA153782-13A5-44EE-835A-90A14FC51352",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
