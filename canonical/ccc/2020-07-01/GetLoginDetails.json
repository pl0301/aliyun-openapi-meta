      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent@ccc-test",
      "help_en": "Agent ID. This parameter is optional. If not specified, the agent mapped to the current RAM account is used by default",
      "help_zh": "坐席ID，非必填，不填则默认使用当前RAM账户映射的坐席",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
