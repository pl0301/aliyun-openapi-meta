      "help_en": "Chat Device ID",
      "help_zh": "Chat设备ID",
      "location": "query",
      "name": "chat_device_id",
      "options": [
        "--chat-device-id"
      ],
      "raw_name": "ChatDeviceId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "Response code",
            "description_zh": "响应码",
            "example": "OK",
            "type": "string"
          },
          "Data": {
            "description_en": "Logon information data",
            "description_zh": "登录信息数据",
            "properties": {
              "AgentServerUrl": {
                "description_en": "Agent data push server URL. After a successful connection, the server pushes agent status data to the agent Workbench",
                "description_zh": "坐席数据推送服务器地址，连接成功后，服务器会推送坐席状态数据到坐席工作台",
                "example": "sh-wss-ccc.aliyuncs.com",
                "type": "string"
              },
              "AvatarUrl": {
                "description_en": "Agent profile picture URL",
                "description_zh": "坐席头像地址",
                "example": "http://abc.com/sam.jpb",
                "type": "string"
              },
              "ChatAppId": {
                "description_en": "Chat session application ID",
                "description_zh": "Chat会话应用ID",
                "example": "7pjxxx",
                "type": "string"
              },
              "ChatAppKey": {
                "description_en": "Chat session application key",
                "description_zh": "Chat会话应用密钥",
                "example": "955e4bd7xxxxxxxxxxxxxd7898ba9fa0d0",
                "type": "string"
              },
              "ChatDeviceId": {
                "description_en": "Chat Device ID",
                "description_zh": "Chat设备ID",
                "example": "4c51c9116c36537cb850dc1081d745df",
                "type": "string"
              },
              "ChatLoginToken": {
                "description_en": "Chat session logon token",
                "description_zh": "Chat会话登录令牌",
                "example": "{\"accessToken\":\"oauth_cloud_key:4xxx0=\",\"accessTokenExpiredTime\":864xxxx,\"refreshToken\":\"oauth_cloud_key:Paxxxx==\"}",
                "type": "string"
              },
              "ChatServerUrl": {
                "description_en": "Chat session server URL",
                "description_zh": "Chat会话服务器地址",
                "example": "wss://wss.im.dingtalk.cn",
                "type": "string"
              },
              "ChatUserId": {
                "description_en": "Chat session Device ID",
                "description_zh": "Chat会话设备ID",
                "example": "A-8000100x",
                "type": "string"
              },
              "DeviceExt": {
                "description_en": "SIP device extension number. This field is required when using a SIP phone",
                "description_zh": "SIP设备分机号，使用SIP话机时需要用到该字段",
                "example": "8033****",
                "type": "string"
              },
              "DeviceId": {
                "description_en": "If the agent has registered an SIP phone, this parameter is the Device ID of the SIP phone device; otherwise, it is empty",
                "description_zh": "如果座席注册了SIP话机，则此参数是SIP话机设备的设备ID，否则为空",
                "example": "Yealink SIP-T23G 44.84.XX.XX",
                "type": "string"
              },
              "DeviceState": {
                "description_en": "SIP device status",
                "description_zh": "SIP设备状态",
                "enumValueTitles": {
                  "OFFLINE": "离线",
                  "ONLINE": "在线",
                  "UNREGISTERED": "未注册"
                },
                "example": "OFFLINE",
                "type": "string"
              },
              "DisplayName": {
                "description_en": "Agent display name",
                "description_zh": "坐席展示名",
                "example": "坐席小王",
                "type": "string"
              },
              "Extension": {
                "description_en": "Agent extension number",
                "description_zh": "坐席分机号",
                "example": "8001****",
                "type": "string"
              },
              "Nickname": {
                "description_en": "Agent nickname",
                "description_zh": "坐席昵称",
                "example": "老王",
                "type": "string"
              },
              "Signature": {
                "description_en": "Signature information generated using an asymmetric key encryption algorithm. This information is required for authentication when registering with the SIP server",
                "description_zh": "签名信息，使用非对称加密算法生成，注册SIP服务器时需要使用该信息进行鉴权",
                "example": "zi31STIMtIfa/UN2l+6lww****",
                "type": "string"
              },
              "Signature2": {
                "description_en": "Signature information generated using an asymmetric key encryption algorithm. This information is required for authentication when registering with the SIP server",
                "description_zh": "签名信息，使用非对称加密算法生成，注册SIP服务器时需要使用该信息进行鉴权",
                "example": "zi31STIMtIfa/UN2l+6lww****",
                "type": "string"
              },
              "SipServerUrl": {
                "description_en": "SIP registration server URL. The agent must register with the server as an SIP user to perform transactional processing (TP) operations",
                "description_zh": "SIP注册服务器地址，坐席需要以SIP用户的身份注册到服务器上才能进行话务操作",
                "example": "sh-sip-ccc.aliyuncs.com:443",
                "type": "string"
              },
              "UserId": {
                "description_en": "Agent ID",
                "description_zh": "坐席ID",
                "example": "agent@ccc-test",
                "type": "string"
              },
              "UserKey": {
                "description_en": "Signature data used to generate signature information. Because this signature mechanism does not support Chinese characters, UserKey2 is currently used for signing instead",
                "description_zh": "签名数据，用于生成签名信息，由于该签名机制不支持中文，所以目前都使用UserKey2进行签名",
                "example": "坐席@aliyun:802001:1656406628862",
                "type": "string"
              },
              "UserKey2": {
                "description_en": "Signature data used to generate signature information. UserKey2 was added because UserKey does not support Chinese characters in signatures",
                "description_zh": "签名数据，用于生成签名信息，由于UserKey不支持中文签名，因此新增了UserKey2",
                "example": "802001:1656406628862\"",
                "type": "string"
              },
              "WorkMode": {
                "description_en": "Work mode",
                "description_zh": "工作模式",
                "enumValueTitles": {
                  "OFFICE_PHONE": "办公电话模式",
                  "OFF_SITE": "场外模式",
                  "ON_SITE": "场内模式"
                },
                "example": "ON_SITE",
                "type": "string"
              }
            },
            "type": "object"
          },
          "HttpStatusCode": {
            "description_en": "HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "Message": {
            "description_en": "Response message",
            "description_zh": "响应信息",
            "example": "无",
            "type": "string"
          },
          "Params": {
            "description_en": "Response parameters",
            "description_zh": "响应参数",
            "items": {
              "description_en": "Response parameters",
              "description_zh": "响应参数",
              "example": "无",
              "type": "string"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "F1A4774A-F28B-5C40-AEF6-D88D2DD6C7E4",
