{
  "backend_timeout_ms": 10000,
  "cmd_full_name": "ccc monitor-call",
  "cmd_name": "monitor-call",
  "deprecated": false,
  "description_en": "You can invoke MonitorCall to listen to a call associated with a specified call ID under a specified instance. The call must be in a state where both the agent and the customer are normally connected, and the agent initiating the listening must have permission to monitor the target agent",
  "description_zh": "调用MonitorCall监听指定实例下指定通话ID对应的通话。通话必须处于坐席和客户双方正常接通状态，且发起监听的坐席有权限对被监听坐席进行监听",
  "kebab_example": "aliyun ccc monitor-call --instance-id ccc-test --monitored-user-id agent2@ccc-test --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "MonitorCall",
  "operation": {
    "action": "MonitorCall",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
