                      "DIALING": "拨号中",
                      "OFFLINE": "离线",
                      "READY": "空闲",
                      "RINGING": "振铃中",
                      "TALKING": "通话中",
                      "WORKING": "话后处理中"
                    },
                    "example": "BREAK",
