{
  "cmd_full_name": "ccc take-break",
  "cmd_name": "take-break",
  "deprecated": false,
  "description_en": "You can invoke TakeBreak to set a specified agent in a specified instance to the break state",
  "description_zh": "调用TakeBreak将指定实例下的指定坐席设置为小休状态",
  "kebab_example": "aliyun ccc take-break --instance-id ccc-test --user-id agent@ccc-test --device-id device --code lunchtime --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "TakeBreak",
  "operation": {
    "action": "TakeBreak",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "Instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "agent@ccc-test",
      "help_en": "Agent ID. If not specified, the agent mapped to the current RAM account is used by default",
      "help_zh": "坐席ID，不填默认使用当前RAM账户映射的坐席",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "device",
      "help_en": "Device ID. This parameter is meaningless and can be filled with any value",
      "help_zh": "设备ID，无意义，可以随便填写",
      "location": "query",
      "name": "device_id",
      "options": [
        "--device-id"
      ],
      "raw_name": "DeviceId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "lunchtime",
      "help_en": "Break status code. Customers can define any custom break status",
      "help_zh": "小休状态码，客户可以自定义任何小休状态",
      "location": "query",
      "name": "code",
      "options": [
        "--code"
      ],
      "raw_name": "Code",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "Response code",
            "description_zh": "响应码",
            "example": "OK",
            "type": "string"
          },
          "Data": {
            "description_en": "Data",
            "description_zh": "数据",
            "properties": {
              "BreakCode": {
                "description_en": "Break status code, which can be either System-defined or Custom-defined. System-defined break codes include: Warm-up (temporary break state after the agent is published but before becoming idle), RingingTimeout (break caused by ringing timeout), and RejectCall (break caused by the agent rejecting a call). There are no restrictions on Custom-defined status codes; customers can define them according to their business needs",
                "description_zh": "小休状态码，分为系统定义的和客户定义的两种，系统定义的小休吗包括：Warm-up （坐席上线后置闲前的临时小休状态）、RingingTimeout（坐席振铃超时导致的小休）、RejectCall（坐席拒接导致的小休）。客户自定义状态码没有限制，客户可以根据业务需要自行定义",
                "enumValueTitles": {
                  "RejectCall": "坐席拒接导致的小休",
                  "RingingTimeout": "坐席振铃超时导致的小休",
                  "Warm-up": "席上线后置闲前的临时小休状态"
                },
                "example": "lunchtime",
                "type": "string"
              },
              "DeviceId": {
                "description_en": "Device ID, which is the identity ID of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time",
                "description_zh": "设备ID，浏览器WebRTC软电话或实体话机设备的标识ID，同一时间只允许一种设备注册",
                "example": "ACC-YUNBS-1.0.10-****",
                "type": "string"
              },
              "Extension": {
                "description_en": "The agent's extension number",
                "description_zh": "坐席分机号",
                "example": "8001****",
                "type": "string"
              },
              "Heartbeat": {
                "description_en": "The time when the last heartbeat from the agent was received, formatted as a UNIX timestamp in milliseconds",
                "description_zh": "上次收到坐席心跳的时间，格式为Unix时间戳，单位毫秒",
                "example": "1609249563836",
                "format": "int64",
                "type": "integer"
              },
              "InstanceId": {
                "description_en": "Instance ID",
                "description_zh": "实例ID",
                "example": "ccc-test",
                "type": "string"
              },
              "JobId": {
                "description_en": "Call ID",
                "description_zh": "通话ID",
                "example": "无",
                "type": "string"
              },
              "Mobile": {
                "description_en": "The agent's personal phone number",
                "description_zh": "坐席的个人电话号码",
                "example": "1390000****",
                "type": "string"
              },
              "OutboundScenario": {
                "description_en": "Indicates whether the agent is in outbound-only mode",
                "description_zh": "坐席是否处于仅外呼模式",
                "example": "false",
                "type": "boolean"
              },
              "Reserved": {
                "description_en": "The UNIX timestamp (in milliseconds) indicating when the agent was most recently reserved. Being reserved means an incoming call will be assigned to the agent shortly",
                "description_zh": "坐席最近一次被预定的时间，被预定意味着马上将有来电分配给该坐席，格式为Unix时间戳，单位毫秒",
                "example": "1609234221864",
                "format": "int64",
                "type": "integer"
              },
              "SignedSkillGroupIdList": {
                "description_en": "List of skill group IDs that the agent has signed into",
                "description_zh": "坐席签入的技能组ID列表",
                "items": {
                  "description_en": "Skill group ID",
                  "description_zh": "技能组ID",
                  "example": "skillgroup1@ccc-test",
                  "type": "string"
                },
                "type": "array"
              },
              "UserId": {
                "description_en": "Agent ID",
                "description_zh": "坐席ID",
                "example": "agent@ccc-test",
                "type": "string"
              },
              "UserState": {
                "description_en": "Agent status",
                "description_zh": "座席状态",
                "enumValueTitles": {
                  "BREAK": "小休",
                  "DIALING": "拨号中",
                  "OFFLINE": "离线",
                  "READY": "空闲",
                  "RINGING": "振铃中",
                  "TALKING": "通话中",
                  "WORKING": "话后处理中"
                },
                "example": "BREAK",
                "type": "string"
              },
              "WorkMode": {
                "description_en": "Work mode",
                "description_zh": "工作模式",
                "enumValueTitles": {
                  "OFFICE_PHONE": "办公电话模式",
                  "OFF_SITE": "场外模式",
                  "ON_SITE": "场内模式"
                },
                "example": "ON_SITE",
                "type": "string"
              }
            },
            "type": "object"
          },
          "HttpStatusCode": {
            "description_en": "HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "Message": {
            "description_en": "Response message",
            "description_zh": "响应信息",
            "example": "无",
            "type": "string"
          },
          "Params": {
            "description_en": "List of response parameters",
            "description_zh": "响应参数列表",
            "items": {
              "description_en": "Response parameter",
              "description_zh": "响应参数",
              "example": "无",
              "type": "string"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "B59382D2-5755-4C6D-861F-FA2AAD8F89F7",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
