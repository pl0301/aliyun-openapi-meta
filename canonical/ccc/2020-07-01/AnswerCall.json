                    "example": "false",
                    "type": "boolean"
                  },
                  "Reserved": {
                    "description_en": "The most recent time the agent was reserved. Being reserved means an incoming call will soon be assigned to the agent. The value is formatted as a UNIX timestamp in milliseconds",
