                        },
                        "UserId": {
                          "description_en": "The agent ID associated with the channel. This field is empty for customer channels.  ",
                          "description_zh": "话务通道关联的坐席ID，如果是客户的话务通道，该字段为空",
                          "example": "agent@ccc-test",
                          "type": "string"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "InstanceId": {
                    "description_en": "Instance ID",
                    "description_zh": "实例ID",
                    "example": "ccc-test",
                    "type": "string"
                  },
                  "JobId": {
                    "description_en": "Call ID.  ",
                    "description_zh": "通话ID",
                    "example": "job-6570007401392****",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "ContextId": {
                "description_en": "System auto-increment ID. Customers do not need to concern themselves with this",
                "description_zh": "系统自增ID，客户无需关心",
                "example": "123456",
                "format": "int64",
                "type": "integer"
              },
              "UserContext": {
                "description_en": "Agent context environment",
                "description_zh": "坐席上下文环境",
                "properties": {
                  "BreakCode": {
                    "description_en": "Break status code, which can be either System-defined or Custom-defined. System-defined break codes include: Warm-up (temporary break state after agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on Custom-defined status codes, and Customers can define them according to their business needs",
                    "description_zh": "小休状态码，分为系统定义的和客户定义的两种，系统定义的小休吗包括：Warm-up （坐席上线后置闲前的临时小休状态）、RingingTimeout（坐席振铃超时导致的小休）、RejectCall（坐席拒接导致的小休）。客户自定义状态码没有限制，客户可以根据业务需要自行定义",
                    "enumValueTitles": {
                      "RejectCall": "坐席拒接导致的小休",
                      "RingingTimeout": "坐席振铃超时导致的小休",
                      "Warm-up": "坐席上线后置闲前的临时小休状态"
                    },
                    "example": "Warm-up",
                    "type": "string"
                  },
                  "DeviceId": {
                    "description_en": "Device ID, which is the identity ID of a browser-based Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time",
                    "description_zh": "设备ID，浏览器WebRTC软电话或实体话机设备的标识ID，同一时间只允许一种设备注册",
                    "example": "ACC-YUNBS-1.0.10-****",
                    "type": "string"
                  },
                  "Extension": {
                    "description_en": "Agent extension number",
                    "description_zh": "坐席分机号",
                    "example": "8001****",
                    "type": "string"
                  },
                  "InstanceId": {
                    "description_en": "Instance ID",
                    "description_zh": "实例ID",
                    "example": "ccc-test",
                    "type": "string"
                  },
                  "JobId": {
                    "description_en": "Call ID",
                    "description_zh": "通话ID",
                    "example": "job-6570007401392****",
                    "type": "string"
                  },
                  "OutboundScenario": {
                    "description_en": "Indicates whether the agent is in outbound-only mode",
                    "description_zh": "坐席是否处于仅外呼模式",
                    "example": "false",
                    "type": "boolean"
                  },
                  "SignedSkillGroupIdList": {
                    "description_en": "List of skill group IDs that the agent has signed into",
                    "description_zh": "坐席签入的技能组ID列表",
                    "items": {
                      "description_en": "Skill group ID",
                      "description_zh": "技能组ID",
                      "example": "skillgroup1@ccc-test",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "UserId": {
                    "description_en": "Agent ID",
                    "description_zh": "坐席ID",
                    "example": "agent@ccc-test",
                    "type": "string"
                  },
                  "UserState": {
                    "description_en": "Agent status",
                    "description_zh": "座席状态",
                    "enumValueTitles": {
                      "BREAK": "小休",
                      "DIALING": "拨号中",
                      "OFFLINE": "离线",
                      "READY": "空闲",
                      "RINGING": "振铃中",
                      "TALKING": "通话中",
                      "WORKING": "话后处理中"
                    },
                    "example": "READY",
                    "type": "string"
                  },
                  "WorkMode": {
                    "description_en": "Work mode",
                    "description_zh": "工作模式",
                    "enumValueTitles": {
                      "OFFICE_PHONE": "办公电话模式",
                      "OFF_SITE": "场外模式",
                      "ON_SITE": "场内模式"
                    },
                    "example": "ON_SITE",
                    "type": "string"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
