                "description_en": "Call context environment",
                "description_zh": "话务上下文环境",
                "properties": {
                  "CallType": {
                    "description_en": "Call type.  ",
                    "description_zh": "通话类型",
                    "enumValueTitles": {
                      "BACK2BACK": "双呼",
                      "BARGE": "强插",
                      "COACH": "辅导",
                      "CONFERENCE": "会议",
                      "CONSULTANT": "咨询",
                      "INBOUND": "呼入",
                      "INTERCEPT": "强拆",
                      "INTERNAL": "内部通话",
                      "MONITOR": "监听",
                      "OUTBOUND": "呼出",
                      "PREDICTIVE": "预测式外呼"
                    },
                    "example": "OUTBOUND",
                    "type": "string"
                  },
                  "CallVariables": {
                    "description_en": "Ingest endpoint data. Custom data passed through SIP signaling",
                    "description_zh": "随路数据。通过SIP信令传递的自定义数据",
                    "example": "a=b;c=d",
                    "type": "string"
                  },
                  "ChannelContexts": {
                    "description_en": "List of call channels.  ",
                    "description_zh": "话务通道列表",
                    "items": {
                      "description_en": "Call channel.  ",
                      "description_zh": "话务通道",
                      "properties": {
                        "CallType": {
                          "description_en": "The call type of the channel.  ",
                          "description_zh": "话务通道的通话类型",
                          "enumValueTitles": {
                            "BACK2BACK": "双呼",
                            "BARGE": "强插",
                            "COACH": "辅导",
                            "CONFERENCE": "会议",
                            "CONSULTANT": "咨询",
                            "INBOUND": "呼入",
                            "INTERCEPT": "强拆",
                            "INTERNAL": "内部通话",
                            "MONITOR": "监听",
                            "OUTBOUND": "呼出",
                            "PREDICTIVE": "预测式外呼"
                          },
                          "example": "OUTBOUND",
                          "type": "string"
                        },
                        "ChannelFlags": {
                          "description_en": "Channel flags.  ",
                          "description_zh": "话务通道标志",
                          "enumValueTitles": {
                            "COACHED": "被辅导",
                            "COACHING": "辅导中",
                            "HOLD": "保持",
                            "MONITORED": "被监听",
                            "MONITORING": "监听中",
                            "MUTED": "静音"
                          },
                          "example": "MONITORING",
                          "type": "string"
                        },
                        "ChannelId": {
                          "description_en": "The channel ID.  ",
                          "description_zh": "话务通道ID",
                          "example": "ch:user:1390501****->8032****:1609138902226:job-653821410368****",
                          "type": "string"
                        },
                        "ChannelState": {
                          "description_en": "The status of the call channel",
                          "description_zh": "话务通道的状态",
                          "enumValueTitles": {
                            "ANSWERED": "已接通",
                            "CREATED": "已创建",
                            "EARLY_MEDIA": "早媒体阶段",
                            "NONE": "初始状态",
                            "RELEASED": "已挂断",
                            "RETIRED": "已失效",
                            "RINGING": "振铃中"
                          },
                          "example": "NONE",
                          "type": "string"
                        },
                        "Destination": {
                          "description_en": "Callee of the call channel.  ",
                          "description_zh": "话务通道的被叫方",
                          "example": "8001****",
                          "type": "string"
                        },
                        "JobId": {
                          "description_en": "Call ID.  ",
                          "description_zh": "通话ID",
                          "example": "job-6570007401392****",
                          "type": "string"
                        },
                        "MediaType": {
                          "description_en": "Media type. The default value is AUDIO. Other valid values include VIDEO.  ",
                          "description_zh": "媒体类型，默认是语音(AUDIO), 其他可选参数包括VIDEO",
                          "example": "Audio",
                          "type": "string"
                        },
                        "Originator": {
                          "description_en": "The originator of the channel.  ",
                          "description_zh": "话务通道的主叫方",
                          "example": "1318888****",
                          "type": "string"
                        },
                        "ReleaseInitiator": {
                          "description_en": "The party that initiated the release of the call channel, indicating who hung up first",
                          "description_zh": "话务通道的挂断方，表示该话务通道是谁首先发起的挂断",
                          "example": "无",
                          "type": "string"
                        },
                        "ReleaseReason": {
                          "description_en": "The reason for releasing the channel. This value indicates why the current channel was disconnected and corresponds to a response code defined in the SIP protocol. Customers should refer to the SIP protocol to analyze the disconnection reason",
                          "description_zh": "话务通道的挂断原因，表示当前话务通道为什么会被挂断，取值来自SIP协议中定义的响应码，请客户参考SIP协议分析挂断原因",
                          "example": "无",
                          "type": "string"
                        },
                        "Timestamp": {
                          "description_en": "The UNIX timestamp indicating the most recent status change of the channel, in milliseconds.  ",
                          "description_zh": "话务通道最近一次状态变化的时间戳，格式是Unix时间戳，单位毫秒",
                          "example": "1609225718295",
                          "format": "int64",
                          "type": "integer"
                        },
                        "UserExtension": {
                          "description_en": "The extension number of the agent associated with the channel",
                          "description_zh": "话务通道关联的坐席的分机号",
