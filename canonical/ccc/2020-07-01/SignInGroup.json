{
  "backend_timeout_ms": 10000,
  "cmd_full_name": "ccc sign-in-group",
  "cmd_name": "sign-in-group",
  "deprecated": false,
  "description_en": "You can invoke SignInGroup to sign an agent into a specified skill group under a specified instance, which is the operation for publishing the agent online",
  "description_zh": "调用SignInGroup使坐席签入指定实例下的指定技能组，即坐席上线操作",
  "kebab_example": "aliyun ccc sign-in-group --instance-id ccc-test --device-id CCC-xx.xx.xx.xx-chrome119-bse1b618bff3xxxxd --signed-skill-group-id-list skillgroup1@ccc-test_,_skillgroup2@ccc-test --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "SignInGroup",
  "operation": {
    "action": "SignInGroup",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "none",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "Instance ID",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent@ccc-test",
      "help_en": "Agent ID. If not specified, the agent mapped to the current Resource Access Management (RAM) user is used by default",
      "help_zh": "坐席ID，不填默认使用当前RAM账号映射的坐席",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "CCC-xx.xx.xx.xx-chrome119-bse1b618bff3xxxxd",
      "help_en": "Voice device ID. When multiple voice devices are active, use this parameter to specify one of them, such as a browser Web Real-Time Communication (WebRTC) endpoint or a SIP phone",
      "help_zh": "语音设备ID。当有多个语音设备可用时，通过此参数指定其中一个语音设备，比如浏览器WebRTC或者SIP话机等",
      "location": "query",
      "name": "device_id",
      "options": [
        "--device-id"
      ],
      "raw_name": "DeviceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "[\"skillgroup1@ccc-test\",\"skillgroup2@ccc-test\"]",
      "help_en": "List of skill group IDs to sign in to, formatted as a JSON array string, where each array element is a skill group ID",
      "help_zh": "想要签入的技能组ID列表，格式为JSON数组字符串，数组元素是技能组ID",
      "location": "query",
      "name": "signed_skill_group_id_list",
      "options": [
        "--signed-skill-group-id-list"
      ],
      "raw_name": "SignedSkillGroupIdList",
      "required": true,
      "type": "string"
    },
    {
      "example": "4c51c9116c36537cb850dc1081d745df",
      "help_en": "Chat device ID",
      "help_zh": "Chat设备ID",
      "location": "query",
      "name": "chat_device_id",
      "options": [
        "--chat-device-id"
      ],
      "raw_name": "ChatDeviceId",
      "required": false,
      "type": "string"
    },
    {
      "example": "false",
      "help_en": "If an agent has already signed in to some skill groups, setting this parameter to true allows the agent to sign in to additional skill groups",
      "help_zh": "座席已经签入一些技能组后，如果指定此参数为True, 则可以签入更多新技能组",
      "location": "query",
      "name": "additivity",
      "options": [
        "--additivity"
      ],
      "raw_name": "Additivity",
      "required": false,
      "type": "bool"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "Code": {
            "description_en": "Response code",
            "description_zh": "响应码",
            "example": "OK",
            "type": "string"
          },
          "Data": {
            "description_en": "Data",
            "description_zh": "数据",
            "properties": {
              "BreakCode": {
                "description_en": "Break status code, which can be either system-defined or customer-defined. System-defined break codes include: Warm-up (temporary break state after agent is published and before becoming idle), RingingTimeout (break caused by agent ringing timeout), and RejectCall (break caused by agent call rejection). There are no restrictions on customer-defined status codes; customers can define them as needed for their business",
                "description_zh": "小休状态码，分为系统定义的和客户定义的两种，系统定义的小休吗包括：Warm-up （坐席上线后置闲前的临时小休状态）、RingingTimeout（坐席振铃超时导致的小休）、RejectCall（坐席拒接导致的小休）。客户自定义状态码没有限制，客户可以根据业务需要自行定义",
                "enumValueTitles": {
                  "RejectCall": "坐席拒接导致的小休",
                  "RingingTimeout": "坐席振铃超时导致的小休",
                  "Warm-up": "坐席上线后置闲前的临时小休状态"
                },
                "example": "Warm-up",
                "type": "string"
              },
              "ChatDeviceId": {
                "description_en": "Chat device ID",
                "description_zh": "Chat设备ID",
                "example": "4c51c9116c36537cb850dc1081d745df",
                "type": "string"
              },
              "DeviceId": {
                "description_en": "Device ID, which is the identity of a browser Web Real-Time Communication (WebRTC) softphone or a physical phone device. Only one type of device can be registered at a time",
                "description_zh": "设备ID，浏览器WebRTC软电话或实体话机设备的标识ID，同一时间只允许一种设备注册",
                "example": "ACC-YUNBS-1.0.10-****\n",
                "type": "string"
              },
              "Extension": {
                "description_en": "Agent extension number",
                "description_zh": "坐席分机号",
                "example": "8032****",
                "type": "string"
              },
              "InstanceId": {
                "description_en": "Instance ID",
                "description_zh": "实例ID",
                "example": "ccc-test",
                "type": "string"
              },
              "JobId": {
                "description_en": "Call ID",
                "description_zh": "通话ID",
                "example": "无",
                "type": "string"
              },
              "OutboundScenario": {
                "description_en": "Indicates whether the agent is in outbound-only mode",
                "description_zh": "坐席是否处于仅外呼模式",
                "example": "false",
                "type": "boolean"
              },
              "SignedSkillGroupIdList": {
                "description_en": "List of skill group IDs that the agent has signed into",
                "description_zh": "坐席签入的技能组ID列表",
                "items": {
                  "description_en": "Skill group ID",
                  "description_zh": "技能组ID",
                  "example": "skillgroup1@ccc-test",
                  "type": "string"
                },
                "type": "array"
              },
              "UserId": {
                "description_en": "Agent ID",
                "description_zh": "坐席ID",
                "example": "agent@ccc-test",
                "type": "string"
              },
              "UserState": {
                "description_en": "Agent status",
                "description_zh": "座席状态",
                "enumValueTitles": {
                  "BREAK": "小休",
                  "DIALING": "拨号中",
                  "OFFLINE": "离线",
                  "READY": "空闲",
                  "RINGING": "振铃中",
                  "TALKING": "通话中",
                  "WORKING": "话后处理中"
                },
                "example": "READY",
                "type": "string"
              },
              "WorkMode": {
                "description_en": "Work mode",
                "description_zh": "工作模式",
                "enumValueTitles": {
                  "OFFICE_PHONE": "办公电话模式",
                  "OFF_SITE": "场外模式",
                  "ON_SITE": "场内模式"
                },
                "example": "ON_SITE",
                "type": "string"
              }
            },
            "type": "object"
          },
          "HttpStatusCode": {
            "description_en": "HTTP status code",
            "description_zh": "HTTP状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "Message": {
            "description_en": "Response message",
            "description_zh": "响应信息",
            "example": "无",
            "type": "string"
          },
          "Params": {
            "description_en": "List of response parameters",
            "description_zh": "响应参数列表",
            "items": {
              "description_en": "Response parameter",
              "description_zh": "响应参数",
              "example": "无",
              "type": "string"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "Request ID",
            "description_zh": "请求ID",
            "example": "EEEE671A-3E24-4A04-81E6-6C4F5B39DF75",
