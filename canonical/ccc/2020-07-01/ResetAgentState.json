      "help_zh": "坐席ID，非必填，不填默认使用当前RAM账户映射的坐席",
      "location": "query",
      "name": "user_id",
      "options": [
        "--user-id"
      ],
      "raw_name": "UserId",
      "required": false,
      "type": "string"
    },
    {
      "doc_required": true,
      "example": "device",
      "help_en": "A string that identifies the device. The value is not processed by the system and can be any string",
      "help_zh": "设备ID，可以随便填写，无特殊作用，无特殊要求",
      "location": "query",
      "name": "device_id",
      "options": [
        "--device-id"
      ],
      "raw_name": "DeviceId",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "CCC",
  "protocol": "HTTP|HTTPS",
  "responses": {
