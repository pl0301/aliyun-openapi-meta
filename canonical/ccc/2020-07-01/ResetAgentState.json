                "example": "Warm-up",
                "type": "string"
              },
              "DeviceId": {
                "description_en": "The ID of the registered device, such as a browser-based WebRTC softphone or a physical phone. An agent can register only one device at a time",
                "description_zh": "设备ID，浏览器WebRTC软电话或实体话机设备的标识ID，同一时间只允许一种设备注册",
                "example": "ACC-YUNBS-1.0.10-****",
                "type": "string"
              },
              "Extension": {
                "description_en": "The agent's extension",
