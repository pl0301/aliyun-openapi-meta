  "kebab_example": "aliyun ccc reset-agent-state --instance-id ccc-test --user-id agent@ccc-test --device-id device --api-version 2020-07-01 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": true,
  "name": "ResetAgentState",
  "operation": {
    "action": "ResetAgentState",
    "api_style": "RPC",
    "api_version": "2020-07-01",
    "method": "POST",
    "operation_type": "readAndWrite",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "doc_required": true,
      "example": "ccc-test",
      "help_en": "The ID of the Cloud Call Center (CCC) instance",
      "help_zh": "实例ID",
      "location": "query",
      "name": "instance_id",
      "options": [
        "--instance-id"
      ],
      "raw_name": "InstanceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "agent@ccc-test",
