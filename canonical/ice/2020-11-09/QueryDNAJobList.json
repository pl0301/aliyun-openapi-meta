      "help_zh": "需要查询的DNA作业ID列表。一次最多建议查询10个，用半角逗号（,）分隔",
      "location": "query",
      "name": "job_ids",
      "options": [
        "--job-ids"
      ],
      "raw_name": "JobIds",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "",
        "description_zh": "",
        "properties": {
          "JobList": {
            "description_en": "The DNA job information",
            "description_zh": "DNA作业信息",
            "items": {
              "description_en": "DNAJob",
              "description_zh": "DNAJob",
              "properties": {
                "Code": {
                  "description_en": "The error code returned for the job execution",
                  "description_zh": "作业执行错误码",
                  "example": "\"InvalidParameter.ResourceNotFound\"",
                  "type": "string"
                },
                "Config": {
                  "description_en": "The DNA configuration",
                  "description_zh": "DNA配置",
                  "example": "{\"SaveType\": \"save\",\"MediaType\"\":\"video\"}",
                  "type": "string"
                },
                "CreationTime": {
                  "description_en": "The time when the job was created. The time follows the ISO 8601 standard and is displayed in UTC (ending with Z)",
                  "description_zh": "作业创建时间。时间格式为 ISO 8601，使用 UTC 时间（以 Z 结尾）",
                  "example": "2022-12-28T03:21:37Z",
                  "type": "string"
                },
                "DBId": {
                  "description_en": "The ID of the DNA library",
                  "description_zh": "DNA库Id",
                  "example": "2288c6ca184c0e47098a5b665e2a12****",
                  "type": "string"
                },
                "DNAResult": {
                  "description_en": "The URL of the DNA result",
                  "description_zh": "DNA结果链接",
                  "example": "http://test_bucket.oss-cn-shanghai.aliyuncs.com/fingerprint/video/search_result/5/5.txt",
                  "type": "string"
                },
                "FinishTime": {
                  "description_en": "The time when the job was completed. The time follows the ISO 8601 standard and is displayed in UTC (ending with Z)",
                  "description_zh": "作业完成时间。时间格式为 ISO 8601，使用 UTC 时间（以 Z 结尾）",
                  "example": "2022-12-28T03:21:44Z",
                  "type": "string"
                },
                "Id": {
                  "description_en": "The job ID",
                  "description_zh": "作业ID",
                  "example": "88c6ca184c0e47098a5b665e2a12****",
                  "type": "string"
                },
                "Input": {
                  "description_en": "The input file",
                  "description_zh": "输入文件",
                  "properties": {
                    "Media": {
                      "description_en": "The information about the input file. Both OSS URLs and media asset IDs are supported.\nAn OSS URL must be in one of the following formats:\n\noss://bucket/object\nhttp(s)://bucket.oss-[regionId].aliyuncs.com/object\n\nIn the formats, bucket is the name of the OSS bucket that resides in the same region as the current project, and object is the file path",
                      "description_zh": "输入文件信息，支持OSS地址和媒资ID两种。\nOSS地址规则为\n\n1、oss://bucket/object\n\n2、http(s)://bucket.oss-[regionId].aliyuncs.com/object\n\n其中bucket为和当前项目处于同一区域的oss bucket名称，object为文件路径",
                      "example": "1b1b9cd148034739af413150fded****",
                      "type": "string"
                    },
                    "Type": {
                      "description_en": "The type of the input file. Valid values:\n\nOSS: the URL of an OSS object.\nMedia: the ID of a media asset",
                      "description_zh": "输入文件类型，取值：\nOSS：OSS文件地址\nMedia：媒资ID",
                      "example": "Media",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "Message": {
                  "description_en": "The error message returned for the job execution",
                  "description_zh": "作业执行错误信息",
                  "example": "\"The resource operated \\\"a887d0b***d805ef6f7f6786302\\\" cannot be found\"",
                  "type": "string"
                },
                "PrimaryKey": {
                  "description_en": "The unique primary key of the video. You must ensure the uniqueness of the primary key",
                  "description_zh": "唯一的视频主键，唯一性由用户保证",
                  "example": "3ca84a39a9024f19853b21be9cf9****",
                  "type": "string"
                },
                "Status": {
                  "description_en": "The status of the job. Valid values:\n\nQueuing: The job is queued.\nAnalysing: The job is being analyzed.\nSuccess: The job succeeded.\nFail: The job failed",
                  "description_zh": "作业状态，可取值：\n\nQueuing：排队中。\nAnalysing：分析中。\nSuccess：成功。\nFail：失败",
                  "example": "Queuing",
                  "type": "string"
                },
                "UserData": {
                  "description_en": "The custom user data",
                  "description_zh": "用户自定义数据",
                  "example": "testdna",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "25818875-5F78-4A13-BEF6-D7393642CA58",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
