{
  "camel_example": "",
  "cmd_full_name": "ice get-snapshot-job",
  "cmd_name": "get-snapshot-job",
  "deprecated": false,
  "description_en": "Queries the information about a snapshot job",
  "description_zh": "查询截图任务详细信息",
  "kebab_example": "aliyun ice get-snapshot-job --job-id 0000d80e4e4044975745c14b0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "GetSnapshotJob",
  "operation": {
    "action": "GetSnapshotJob",
    "api_style": "RPC",
    "api_version": "2020-11-09",
    "method": "POST",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "example": "****d80e4e4044975745c14b****",
      "help_en": "The ID of the snapshot job",
      "help_zh": "截图任务ID",
      "location": "query",
      "name": "job_id",
      "options": [
        "--job-id"
      ],
      "raw_name": "JobId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ICE",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "description_en": "PlainResponse",
        "description_zh": "PlainResponse<SnapshotJobDTO>",
        "properties": {
          "RequestId": {
            "description_en": "The request ID",
            "description_zh": "请求ID",
            "example": "******11-DB8D-4A9A-875B-275798******",
            "title_en": "",
            "title_zh": "请求ID",
            "type": "string"
          },
          "SnapshotJob": {
            "description_en": "The information about the snapshot job",
            "description_zh": "截图任务信息",
            "properties": {
              "Async": {
                "description_en": "Indicates whether the snapshots were captured in asynchronous mode. Default value: true",
                "description_zh": "是否异步截图。默认：true",
                "example": "true",
                "type": "boolean"
              },
              "Code": {
                "description_en": "Error codes",
                "description_zh": "错误码",
                "example": "ResourceNotFound",
                "type": "string"
              },
              "Count": {
                "description_en": "The number of snapshots",
                "description_zh": "截图数量",
                "example": "8",
                "format": "int32",
                "type": "integer"
              },
              "CreateTime": {
                "description_en": "The time when the job was created",
                "description_zh": "创建时间",
                "example": "2022-07-12T16:17:54Z",
                "type": "string"
              },
              "FinishTime": {
                "description_en": "The time when the job was complete",
                "description_zh": "任务完成时间",
                "example": "2022-07-12T16:30:54Z",
                "type": "string"
              },
              "Input": {
                "description_en": "The input of the job",
                "description_zh": "任务输入",
                "properties": {
                  "Media": {
                    "description_en": "The input file. If Type is set to OSS, the URL of an OSS object is returned. If Type is set to Media, the ID of a media asset is returned. The URL of an OSS object can be in one of the following formats:\n\noss\\://bucket/object\n\nhttp(s)://bucket.oss-[RegionId].aliyuncs.com/object In the URL, bucket specifies an OSS bucket that resides in the same region as the job, and object specifies the object URL in OSS",
                    "description_zh": "输入媒体。当Type为OSS时填入OSS地址，Type为Media时填入媒资ID。\nOSS地址规则为：\noss://bucket/object\nhttp(s)://bucket.oss-[RegionId].aliyuncs.com/object\n其中bucket为和当前项目处于同一区域的oss bucket名称，object为文件路径",
                    "example": "oss://test-bucket/object.mp4",
                    "type": "string"
                  },
                  "OssFile": {
                    "description_en": "The three key elements of OSS",
                    "description_zh": "OSS三元组",
                    "properties": {
                      "Bucket": {
                        "description_en": "The OSS bucket",
                        "description_zh": "OSS Bucket",
                        "example": "test-bucket",
                        "type": "string"
                      },
                      "Location": {
                        "description_en": "The OSS location",
                        "description_zh": "OSS Location",
                        "example": "oss-cn-shanghai",
                        "type": "string"
                      },
                      "Object": {
                        "description_en": "The OSS object",
                        "description_zh": "OSS Object",
                        "example": "object.mp4",
                        "type": "string"
                      }
                    },
                    "title_en": "",
                    "title_zh": "输入类型为媒资ID时的OSS地址",
                    "type": "object"
                  },
                  "Type": {
                    "description_en": "The type of the input file. Valid values:\n\nOSS: an Object Storage Service (OSS) object.\n\nMedia: a media asset",
                    "description_zh": "输入类型，取值：\nOSS：oss文件地址\nMedia：媒资ID",
                    "example": "OSS",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "JobId": {
                "description_en": "The job ID",
                "description_zh": "任务ID",
                "example": "****d80e4e4044975745c14b****",
                "type": "string"
              },
              "Message": {
                "description_en": "The error message that is returned",
                "description_zh": "错误消息",
                "example": "The specified resource for \"Pipeline\" could not be found.",
                "type": "string"
              },
              "ModifiedTime": {
                "description_en": "The time when the job was last modified",
                "description_zh": "最后修改时间",
                "example": "2022-07-12T16:30:54Z",
                "type": "string"
              },
              "Name": {
                "description_en": "The name of the job",
                "description_zh": "任务名称",
                "example": "Test task",
                "type": "string"
              },
              "Output": {
                "description_en": "The output of the job",
                "description_zh": "任务输出",
                "properties": {
                  "Media": {
                    "description_en": "The output file. If Type is set to OSS, the URL of an OSS object is returned. If Type is set to Media, the ID of a media asset is returned. The URL of an OSS object can be in one of the following formats:\n\noss\\://bucket/object\n\nhttp(s)://bucket.oss-[RegionId].aliyuncs.com/object\n\nIn the URL, bucket specifies an OSS bucket that resides in the same region as the job, and object specifies the object URL in OSS. If multiple static snapshots were captured, the object must contain the \"{Count}\" placeholder. In the case of a sprite, the object must contain the \"{TileCount}\" placeholder. The suffix of the WebVTT snapshot objects must be \".vtt\"",
                    "description_zh": "输出媒体。当Type为OSS时填入OSS地址，Type为Media时填入媒资ID。\nOSS地址规则为：\noss://bucket/object\nhttp(s)://bucket.oss-[RegionId].aliyuncs.com/object\n\n其中，bucket为和当前项目处于同一区域的oss bucket名称，object为文件路径。\n\n截取多张静态截图时，object必须要带有”{Count}“占位符；\n\n截取雪碧图时，object必须要带有“{TileCount}”占位符。\n\nWebVTT截图object的后缀必须是“.vtt”",
                    "example": "http://test-bucket.oss-cn-shanghai.aliyuncs.com/output-{Count}.jpg",
                    "type": "string"
                  },
                  "OssFile": {
                    "description_en": "The three key elements of OSS",
                    "description_zh": "OSS三元组",
                    "properties": {
                      "Bucket": {
                        "description_en": "The OSS bucket",
                        "description_zh": "OSS Bucket",
                        "example": "test-bucket",
                        "type": "string"
                      },
                      "Location": {
                        "description_en": "The OSS location",
                        "description_zh": "OSS Location",
                        "example": "oss-cn-shanghai",
                        "type": "string"
                      },
                      "Object": {
                        "description_en": "The OSS object",
                        "description_zh": "OSS Object",
                        "example": "output-{Count}.jpg",
                        "type": "string"
                      }
                    },
                    "title_en": "",
                    "title_zh": "输出类型为媒资ID时的OSS地址",
                    "type": "object"
                  },
                  "Type": {
                    "description_en": "The type of the output file. Valid values:\n\nOSS: an OSS object.\n\nMedia: a media asset",
                    "description_zh": "输出类型，取值：\nOSS：oss文件地址\nMedia：媒资ID",
                    "example": "OSS",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              "PipelineId": {
                "description_en": "The ID of the MPS queue to which the job was submitted",
                "description_zh": "管道ID",
                "example": "****d80e4e4044975745c14b****",
                "type": "string"
              },
              "Status": {
                "description_en": "The state of the job.\n\nValid values:\n\nInit: The job is submitted.\n\nSuccess: The job is successful.\n\nFail: The job failed",
                "description_zh": "任务状态",
                "enumValueTitles": {
                  "Fail": "失败",
                  "Init": "已提交",
                  "Success": "成功"
                },
                "example": "Success",
                "type": "string"
              },
              "SubmitTime": {
                "description_en": "The time when the job was submitted",
                "description_zh": "任务提交时间",
                "example": "2022-07-12T16:17:54Z",
                "type": "string"
              },
              "TemplateConfig": {
                "description_en": "The snapshot template configuration",
                "description_zh": "截图模板配置",
                "example": "{\"Type\":\"Normal\",\"FrameType\":\"normal\",\"Time\":0,\"Count\":10}",
                "type": "string"
              },
              "TemplateId": {
                "description_en": "The template ID",
                "description_zh": "模板ID",
                "example": "****d80e4e4044975745c14b****",
                "type": "string"
              },
              "TriggerSource": {
                "description_en": "The request trigger source.\n\nValid values:\n\nConsole\n\nWorkflow\n\nAPI",
                "description_zh": "请求触发来源",
                "enumValueTitles": {
                  "API": "API",
                  "Console": "控制台",
                  "Workflow": "工作流"
                },
                "example": "API",
                "type": "string"
              },
              "Type": {
                "description_en": "Snapshot types\n\nValid values:\n\nWebVtt\n\nSprite\n\nNormal",
                "description_zh": "截图类型",
                "enumValueTitles": {
                  "Normal": "普通静态截图",
                  "Sprite": "雪碧图截图",
                  "WebVtt": "WebVTT截图"
                },
                "example": "Sprite",
                "type": "string"
              },
              "UserData": {
                "description_en": "The user-defined parameters",
                "description_zh": "用户自定义参数",
                "example": "{\"test parameter\": \"test value\"}",
                "type": "string"
              }
            },
            "title_en": "",
            "title_zh": "截图任务信息",
            "type": "object"
          }
        },
        "title_en": "",
        "title_zh": "PlainResponse<SnapshotJobDTO>",
        "type": "object"
      }
    }
  }
}
