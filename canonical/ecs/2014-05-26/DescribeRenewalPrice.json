  "kebab_example": "aliyun ecs describe-renewal-price --biz-region-id cn-hangzhou --resource-id i-bp1f2o4ldh8l29zv0000 --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeRenewalPrice",
  "operation": {
    "action": "DescribeRenewalPrice",
    "api_style": "RPC",
    "api_version": "2014-05-26",
