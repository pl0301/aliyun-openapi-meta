  "camel_example": "aliyun ecs DescribeRenewalPrice --region cn-hangzhou --ResourceId 'i-bp1f2o4ldh8l29zv0000' --RegionId 'cn-hangzhou'",
  "cmd_full_name": "ecs describe-renewal-price",
  "cmd_name": "describe-renewal-price",
  "deprecated": false,
  "description_en": "Queries the renewal price of Elastic Compute Service (ECS) resources. Only subscription resources are supported",
