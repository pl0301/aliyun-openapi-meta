{
  "camel_example": "aliyun r-kvstore DescribeAvailableResource --region cn-hangzhou --InstanceScene professional --OrderType BUY --ZoneId 'cn-hangzhou-h' --ResourceGroupId 'rg-acfmyiu4e000000' --InstanceId 'r-bp1zxszhcgatnx0000' --InstanceChargeType PrePaid --ProductType Local --NodeId 'r-bp1zxszhcgatnx0000-db-0' --AcceptLanguage 'zh-CN' --RegionId 'cn-hangzhou' --Engine Redis",
  "cmd_full_name": "r-kvstore describe-available-resource",
  "cmd_name": "describe-available-resource",
  "deprecated": false,
  "description_en": "Queries the types of Tair (Redis OSS-compatible) instances that can be created in a specified zone",
  "description_zh": "查询指定可用区内可创建的实例规格",
  "kebab_example": "aliyun r-kvstore describe-available-resource --biz-region-id cn-hangzhou --zone-id cn-hangzhou-h --instance-charge-type PrePaid --order-type BUY --engine Redis --resource-group-id rg-acfmyiu4e000000 --instance-id r-bp1zxszhcgatnx0000 --accept-language zh-CN --product-type Local --node-id r-bp1zxszhcgatnx0000-db-0 --instance-scene professional --region cn-hangzhou",
  "method": "GET|POST",
  "multi_version": false,
  "name": "DescribeAvailableResource",
  "operation": {
    "action": "DescribeAvailableResource",
