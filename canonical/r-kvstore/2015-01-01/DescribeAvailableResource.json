        "--zone-id"
      ],
      "raw_name": "ZoneId",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "PrePaid",
        "PostPaid"
      ],
      "example": "PrePaid",
      "help_en": "The billing method. Valid values:\n\nPrePaid (default): subscription\nPostPaid: pay-as-you-go",
      "help_zh": "付费类型，取值：\nPrePaid（默认）：包年包月。\nPostPaid：按量付费",
      "location": "query",
      "name": "instance_charge_type",
      "options": [
        "--instance-charge-type"
      ],
      "raw_name": "InstanceChargeType",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "BUY",
        "UPGRADE",
        "DOWNGRADE"
      ],
      "example": "BUY",
      "help_en": "The order type. Valid values:\n\nBUY (default): orders that are used to create instances\nUPGRADE: orders that are used to upgrade instances\nDOWNGRADE: orders that are used to downgrade instances",
      "help_zh": "订单类型，取值：\nBUY（默认）：新购。\nUPGRADE：升级实例规格配置。\nDOWNGRADE：降级实例规格配置",
      "location": "query",
      "name": "order_type",
