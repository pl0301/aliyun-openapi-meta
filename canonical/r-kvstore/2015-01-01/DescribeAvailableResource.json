        "redis",
        "memcache",
        "REDIS",
        "MEMCACHE"
      ],
      "example": "Redis",
      "help_en": "The database engine of the instance. Valid values:\n\nRedis\nMemcache",
      "help_zh": "引擎类型，取值：\nRedis。\nMemcache",
