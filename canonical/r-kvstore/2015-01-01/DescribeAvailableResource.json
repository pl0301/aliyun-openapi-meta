    },
    {
      "example": "cn-hangzhou-h",
      "help_en": "The zone ID of the instance. You can call the https://help.aliyun.com/document_detail/473764.html operation to query the most recent zone list",
      "help_zh": "可用区ID，您可以调用https://help.aliyun.com/document_detail/473764.html查询",
