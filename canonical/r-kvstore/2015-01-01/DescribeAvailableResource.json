        "--zone-id"
      ],
      "raw_name": "ZoneId",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "PrePaid",
        "PostPaid"
      ],
      "example": "PrePaid",
      "help_en": "The billing method. Valid values:\nPrePaid (default): subscription\nPostPaid: pay-as-you-go",
      "help_zh": "付费类型，取值：\nPrePaid（默认）：包年包月。\nPostPaid：按量付费",
      "location": "query",
      "name": "instance_charge_type",
      "options": [
        "--instance-charge-type"
      ],
      "raw_name": "InstanceChargeType",
      "required": false,
      "type": "string"
    },
    {
      "enum": [
        "BUY",
        "UPGRADE",
        "DOWNGRADE"
      ],
      "example": "BUY",
      "help_en": "The order type. Valid values:\nBUY (default): new purchase\nUPGRADE: upgrade instance type\nDOWNGRADE: downgrade instance type",
      "help_zh": "订单类型，取值：\nBUY（默认）：新购。\nUPGRADE：升级实例规格配置。\nDOWNGRADE：降级实例规格配置",
      "location": "query",
      "name": "order_type",
      "options": [
        "--order-type"
      ],
      "raw_name": "OrderType",
      "required": false,
      "type": "string"
